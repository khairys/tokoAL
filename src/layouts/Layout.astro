---
interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "Toko AL", 
	description = "Pusat penjualan sepeda, spareparts terlengkap, dan layanan servis profesional di Serang. Kami memastikan sepeda Anda selalu dalam performa terbaik."
} = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/png" href="/favicon.png" />
		
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
		
		<!-- Font Awesome -->
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
		
		<title>{title}</title>
		
		<!-- Tailwind CSS with Config -->
		<script is:inline src="https://cdn.tailwindcss.com"></script>
		<script is:inline>
			tailwind.config = {
				theme: {
					extend: {
						colors: {
							// Official Requested Palette
							'brand-green': '#116530',
							'brand-bluegreen': '#21B6A8',
							'brand-neongreen': '#A3EBB1',
							'brand-kelly': '#18A558',
							'brand-black': '#000000',
							'brand-white': '#FFFFFF',

							// Semantic Mappings
							primary: '#18A558',      // Kelly Green (Primary Action)
							secondary: '#21B6A8',    // Blue Green (Accent & Gradients)
							dark: '#116530',         // Green / Deep Forest (Brand & Text)
							neon: '#A3EBB1',         // Neon Green (Micro-accents & Highlights)
							shopee: '#EE4D2D',
							tokopedia: '#42B549',
						},
						fontFamily: {
							sans: ['Poppins', 'sans-serif'],
						},
						animation: {
							'bounce-slow': 'bounce 3s infinite',
						}
					}
				}
			}
		</script>
	</head>
	<body class="bg-gray-50 text-gray-800 font-sans antialiased selection:bg-[#A3EBB1] selection:text-[#116530]">
		<slot />
	</body>
</html>

<style is:global>
	/* Custom Text Selection */
	::selection {
		background-color: #A3EBB1;
		color: #116530;
	}

	/* Hide scrollbar for carousel but allow functionality */
	.hide-scroll::-webkit-scrollbar {
		display: none;
	}
	.hide-scroll {
		-ms-overflow-style: none;
		scrollbar-width: none;
	}
	
	/* Custom Animation Classes */
	.fade-in-up {
		opacity: 0;
		transform: translateY(20px);
		transition: opacity 0.6s ease-out, transform 0.6s ease-out;
	}
	.fade-in-up.visible {
		opacity: 1;
		transform: translateY(0);
	}
</style>
