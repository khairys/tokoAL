---
// Fonts per brand guidelines, self-hosted (Latin subset only) so text never waits on a third-party server
import "@fontsource/barlow/latin-400.css";
import "@fontsource/barlow/latin-500.css";
import "@fontsource/barlow/latin-600.css";
import "@fontsource/barlow/latin-700.css";
import "@fontsource/barlow/latin-800.css";
import "@fontsource/barlow-semi-condensed/latin-600.css";
import "@fontsource/barlow-semi-condensed/latin-700.css";
import "../styles/site.css";
interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	image?: string;
}

const { 
	title = "Toko AL | Bersepeda Itu Mudah", 
	description = "Pusat penjualan sepeda (Fixie, Roadbike, MTB), suku cadang orisinil terlengkap, dan bengkel servis sepeda profesional terpercaya di Cikande Permai, Serang, Banten.",
	canonical = "https://tokoal.id/",
	image = "/og-image.jpg"
} = Astro.props;

const siteUrl = "https://tokoal.id";
const fullImageUrl = new URL(image, siteUrl).href;
const fullCanonicalUrl = new URL(canonical, siteUrl).href;

// Schema.org JSON-LD Structured Data
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BikeStore",
      "@id": `${siteUrl}/#store`,
      "name": "Toko AL",
      "alternateName": "Toko Sepeda AL Cikande",
      "description": description,
      "url": siteUrl,
      "logo": `${siteUrl}/favicon.png`,
      "image": fullImageUrl,
      "telephone": "+6281996535525",
      "priceRange": "$$",
      "currenciesAccepted": "IDR",
      "paymentAccepted": "Cash, QRIS, Bank Transfer",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Jl. Cikande Permai Blok J2 No.6",
        "addressLocality": "Cikande",
        "addressRegion": "Banten",
        "postalCode": "42186",
        "addressCountry": "ID"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -6.1956,
        "longitude": 106.3536
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
          "opens": "09:00",
          "closes": "20:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Sunday",
          "opens": "09:00",
          "closes": "17:00"
        }
      ],
      "sameAs": [
        "https://www.instagram.com/tokoal_id",
        "https://www.tiktok.com/@tokoal.id",
        "https://www.youtube.com/@tokoal_id",
        "https://www.facebook.com/admintokoalid"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Katalog Produk & Layanan Toko AL",
        "itemListElement": [
          {
            "@type": "OfferCatalog",
            "name": "Penjualan Sepeda",
            "itemListElement": [
              { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Sepeda Fixie" } },
              { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Sepeda Roadbike" } },
              { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Sepeda MTB (Mountain Bike)" } },
              { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Sepeda BMX & Sepeda Anak" } }
            ]
          },
          {
            "@type": "OfferCatalog",
            "name": "Layanan Bengkel Sepeda",
            "itemListElement": [
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Tune-Up Sepeda Lengkap" } },
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Perakitan Sepeda Kustom" } }
            ]
          }
        ]
      }
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "Toko AL",
      "description": description,
      "publisher": {
        "@id": `${siteUrl}/#store`
      },
      "inLanguage": "id-ID"
    }
  ]
};
---

<!doctype html>
<html lang="id" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={fullCanonicalUrl} />

		<!-- Search Engine Robots -->
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

		<!-- Geographic Meta Tags (Local SEO Serang, Banten) -->
		<meta name="geo.region" content="ID-BT" />
		<meta name="geo.placename" content="Cikande, Serang" />
		<meta name="geo.position" content="-6.1956;106.3536" />
		<meta name="ICBM" content="-6.1956, 106.3536" />

		<!-- Open Graph (Facebook, WhatsApp, LinkedIn, iMessage) -->
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="id_ID" />
		<meta property="og:site_name" content="Toko AL" />
		<meta property="og:url" content={fullCanonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={fullImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={fullImageUrl} />

		<!-- Favicons & Theme -->
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="theme-color" content="#116530" />
		
		<!-- Schema.org JSON-LD Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />


		<!-- Motion is opt-out: skipped entirely for visitors who prefer reduced motion -->
		<script is:inline>
			if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
				document.documentElement.classList.add("js");
			}
		</script>
	</head>
	<body>
		<slot />
		<script>
			import "../scripts/motion.ts";
		</script>
	</body>
</html>
