---
// Contact & Location Component - Fluid Precision Prototype
import logoNavbar from '../assets/branding/Logo navbar.png';
---

<section id="contact" class="py-24 bg-zinc-50 border-b border-zinc-200/80">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		
		<!-- Section Header -->
		<div class="max-w-3xl mb-14">
			<span class="text-xs font-bold uppercase tracking-widest text-emerald-600 block mb-2">
				Kunjungan Langsung
			</span>
			<h2 class="text-3xl sm:text-4xl font-extrabold text-zinc-950 tracking-tight">
				Lokasi Toko & Jam Buka
			</h2>
			<p class="text-zinc-600 text-sm sm:text-base mt-2">
				Kunjungi toko fisik kami di Cikande Permai. Anda bisa berkonsultasi langsung mengenai pilihan sepeda, sparepart, atau perawatan berkala bersama mekanik kami.
			</p>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
			
			<!-- Info Hub (lg:col-span-5) -->
			<div class="lg:col-span-5 bg-white rounded-3xl p-8 border border-zinc-200/80 shadow-sm space-y-7">
				<div class="flex items-center gap-3">
					<img src={logoNavbar.src} alt="Logo Toko AL" class="h-9 w-auto object-contain" />
					<div>
						<h3 class="font-extrabold text-xl text-zinc-950 leading-none">Toko AL</h3>
						<span class="text-xs text-zinc-500">Cikande Permai, Serang, Banten</span>
					</div>
				</div>

				<div class="space-y-5 text-sm">
					<!-- Alamat -->
					<div class="flex items-start gap-3.5">
						<div class="w-10 h-10 rounded-2xl bg-emerald-50 text-emerald-700 flex items-center justify-center flex-shrink-0 mt-0.5">
							<i class="fas fa-map-marker-alt text-base"></i>
						</div>
						<div>
							<span class="font-bold text-zinc-950 block text-xs uppercase tracking-wider mb-1">Alamat Toko</span>
							<p class="text-zinc-600 leading-relaxed text-xs sm:text-sm">
								Jl. Cikande Permai Blok J2 No.6, Cikande Permai, Kec. Cikande, Kabupaten Serang, Banten 42186
							</p>
						</div>
					</div>

					<!-- Jam Operasional -->
					<div class="flex items-start gap-3.5">
						<div class="w-10 h-10 rounded-2xl bg-emerald-50 text-emerald-700 flex items-center justify-center flex-shrink-0 mt-0.5">
							<i class="fas fa-clock text-base"></i>
						</div>
						<div>
							<div class="flex items-center gap-2 mb-1">
								<span class="font-bold text-zinc-950 text-xs uppercase tracking-wider">Jam Operasional</span>
								<span class="text-[10px] font-bold text-emerald-800 bg-emerald-100/70 px-2 py-0.5 rounded-full">Buka Setiap Hari</span>
							</div>
							<p class="text-zinc-600 leading-relaxed text-xs sm:text-sm">
								Senin – Sabtu: <strong class="text-zinc-900">09.00 – 20.00 WIB</strong><br>
								Minggu: <strong class="text-zinc-900">09.00 – 17.00 WIB</strong>
							</p>
						</div>
					</div>

					<!-- WhatsApp -->
					<div class="flex items-start gap-3.5">
						<div class="w-10 h-10 rounded-2xl bg-emerald-50 text-emerald-700 flex items-center justify-center flex-shrink-0 mt-0.5">
							<i class="fab fa-whatsapp text-lg"></i>
						</div>
						<div>
							<span class="font-bold text-zinc-950 block text-xs uppercase tracking-wider mb-1">WhatsApp & Telepon</span>
							<a
								href="https://api.whatsapp.com/send?phone=6281996535525&text=Halo%20Toko%20AL"
								target="_blank"
								rel="noopener noreferrer"
								class="text-base font-bold text-zinc-950 hover:text-emerald-700 transition-colors"
							>
								+62 819-9653-5525
							</a>
						</div>
					</div>
				</div>

				<div class="pt-5 border-t border-zinc-100">
					<a
						href="https://api.whatsapp.com/send?phone=6281996535525&text=Halo%20Toko%20AL,%20saya%20ingin%20tanya%20rute"
						target="_blank"
						rel="noopener noreferrer"
						class="w-full py-3.5 px-5 rounded-2xl bg-zinc-950 hover:bg-emerald-700 text-white font-bold text-xs uppercase tracking-wider active:scale-95 transition-all flex items-center justify-center gap-2"
					>
						<i class="fab fa-whatsapp text-sm text-emerald-400"></i>
						<span>Kirim Pesan Cepat WhatsApp</span>
					</a>
				</div>
			</div>

			<!-- Map Column (lg:col-span-7) with Scroll Trap Protection -->
			<div class="lg:col-span-7 rounded-3xl overflow-hidden border border-zinc-200/80 h-[380px] sm:h-[450px] relative shadow-sm">
				<iframe
					src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3966.121542874621!2d106.34663471463!3d-6.217914962436!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e42034cad66013f%3A0x172b9ecbe51c0c05!2sToko%20Sepeda%20AL!5e0!3m2!1sid!2sid!4v1735218000000!5m2!1sid!2sid"
					width="100%"
					height="100%"
					style="border:0;"
					allowfullscreen=""
					loading="lazy"
					title="Peta Toko Sepeda AL"
					class="w-full h-full pointer-events-none sm:pointer-events-auto"
				></iframe>

				<a
					href="https://maps.app.goo.gl/uXpQYw8dKrn5U22P8"
					target="_blank"
					rel="noopener noreferrer"
					class="absolute bottom-4 left-4 right-4 sm:left-auto sm:right-5 bg-white hover:bg-emerald-600 hover:text-white text-zinc-900 text-xs font-bold px-5 py-3 rounded-full shadow-xl border border-zinc-200/80 active:scale-95 transition-all flex items-center justify-center gap-2"
				>
					<i class="fas fa-directions text-emerald-600 group-hover:text-white"></i>
					<span>Petunjuk Arah Google Maps</span>
					<i class="fas fa-external-link-alt text-[9px] text-zinc-400"></i>
				</a>
			</div>

		</div>
	</div>
</section>
