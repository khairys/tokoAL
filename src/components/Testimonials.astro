---
// Store Gallery & Reviews Component - Fluid Precision Prototype
// Implements Ambient Blurred Backdrop to solve image dimension differences
import imgEtalase from '../assets/gallery/etalaseDepan.png';
import imgKasir from '../assets/gallery/kasirAL.png';
import imgViewBelakang from '../assets/gallery/viewbelakang.png';
import imgDepanRumah from '../assets/gallery/depan rumah.png';
import imgPelanggan from '../assets/gallery/Pelanggan.png';
import imgMobilAnak from '../assets/gallery/MobilANAK.png';

const storePhotos = [
	{
		src: imgDepanRumah.src,
		alt: "Tampak Depan Toko AL Cikande",
		tag: "Toko Fisik",
		title: "Kunjungi Toko AL di Cikande Permai",
		desc: "Jl. Cikande Permai Blok J2 No.6, Cikande Permai, Serang"
	},
	{
		src: imgEtalase.src,
		alt: "Display Sparepart Toko AL",
		tag: "Sparepart",
		title: "Etalase Sparepart & Komponen",
		desc: "Koleksi suku cadang, gear, rantai, ban, dan komponen terlengkap"
	},
	{
		src: imgViewBelakang.src,
		alt: "Display Sepeda Toko AL",
		tag: "Unit Sepeda",
		title: "Koleksi Unit Sepeda Lengkap",
		desc: "Pilihan sepeda MTB, lipat, roadbike, dan sepeda anak siap coba"
	},
	{
		src: imgKasir.src,
		alt: "Area Kasir Toko AL",
		tag: "Pelayanan",
		title: "Pelayanan Ramah & Transparan",
		desc: "Konsultasi part sepeda dan transaksi mudah"
	},
	{
		src: imgPelanggan.src,
		alt: "Pelanggan Toko AL",
		tag: "Goweser",
		title: "Kepuasan Pelanggan Prioritas Kami",
		desc: "Selalu siap membantu pesepeda mendapatkan unit impian"
	},
	{
		src: imgMobilAnak.src,
		alt: "Koleksi Sepeda dan Mainan Anak",
		tag: "Koleksi Anak",
		title: "Sepeda & Mainan Anak",
		desc: "Pilihan sepeda roda tiga, push bike, dan mainan aki seru"
	}
];
---

<section id="gallery" class="py-24 bg-zinc-50 border-b border-zinc-200/80 overflow-hidden">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
			
			<!-- Left: Ambient Blurred Gallery Carousel (lg:col-span-7) -->
			<div class="lg:col-span-7">
				<div class="flex items-center justify-between mb-4">
					<div>
						<span class="text-xs font-bold uppercase tracking-widest text-emerald-600 block mb-1">Galeri Otentik</span>
						<h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-950 tracking-tight">Suasana Nyata Toko</h2>
					</div>
					<span id="gallery-counter" class="text-xs font-bold text-zinc-500 bg-white px-3 py-1 rounded-full border border-zinc-200">
						1 / {storePhotos.length}
					</span>
				</div>

				<!-- Ambient Frame (Uncropped Image + Soft Blurred Atmosphere) -->
				<div class="relative aspect-[16/11] sm:aspect-[16/10] rounded-3xl overflow-hidden shadow-xl border border-zinc-200 bg-zinc-950 group select-none">
					
					{storePhotos.map((photo, idx) => (
						<div 
							class={`ambient-slide absolute inset-0 transition-opacity duration-500 ease-out ${idx === 0 ? 'opacity-100 pointer-events-auto' : 'opacity-0 pointer-events-none'}`}
							data-index={idx}
						>
							<!-- Background Ambient Blur Layer (Fills any aspect ratio difference gracefully) -->
							<img
								src={photo.src}
								alt=""
								aria-hidden="true"
								class="absolute inset-0 w-full h-full object-cover filter blur-2xl opacity-40 scale-125"
								loading="lazy"
							/>

							<!-- Main Crisp Foreground Image (100% Uncropped with object-contain) -->
							<div class="relative z-10 w-full h-full flex items-center justify-center p-2 sm:p-4">
								<img
									src={photo.src}
									alt={photo.alt}
									class="max-w-full max-h-full object-contain rounded-xl drop-shadow-2xl"
									loading={idx === 0 ? "eager" : "lazy"}
								/>
							</div>

							<!-- Dark Bottom Gradient for Text Legibility -->
							<div class="absolute inset-0 bg-gradient-to-t from-black/85 via-transparent to-transparent z-20 pointer-events-none"></div>

							<!-- Slide Captions -->
							<div class="absolute bottom-5 left-5 right-20 text-white z-30 pointer-events-none">
								<span class="text-[10px] font-bold uppercase tracking-wider text-emerald-400 bg-emerald-950/80 border border-emerald-500/30 px-2 py-0.5 rounded-full inline-block mb-1">
									{photo.tag}
								</span>
								<h3 class="text-base sm:text-xl font-bold leading-tight">{photo.title}</h3>
								<p class="text-xs text-zinc-300 mt-0.5 line-clamp-1">{photo.desc}</p>
							</div>
						</div>
					))}

					<!-- Navigation Controls -->
					<button
						id="slide-prev"
						aria-label="Foto Sebelumnya"
						class="absolute left-3 top-1/2 -translate-y-1/2 z-40 w-10 h-10 rounded-full bg-black/40 hover:bg-emerald-600 text-white backdrop-blur-md flex items-center justify-center transition-all active:scale-90"
					>
						<i class="fas fa-chevron-left text-xs"></i>
					</button>
					<button
						id="slide-next"
						aria-label="Foto Selanjutnya"
						class="absolute right-3 top-1/2 -translate-y-1/2 z-40 w-10 h-10 rounded-full bg-black/40 hover:bg-emerald-600 text-white backdrop-blur-md flex items-center justify-center transition-all active:scale-90"
					>
						<i class="fas fa-chevron-right text-xs"></i>
					</button>
				</div>
			</div>

			<!-- Right: Reviews (lg:col-span-5) -->
			<div class="lg:col-span-5 space-y-4">
				<div class="flex items-center justify-between gap-3 mb-2">
					<h3 class="text-xl font-bold text-zinc-950">Ulasan Goweser</h3>
					<a
						href="https://maps.app.goo.gl/uXpQYw8dKrn5U22P8"
						target="_blank"
						rel="noopener noreferrer"
						class="text-xs font-bold text-emerald-700 hover:text-emerald-800 flex items-center gap-1.5"
					>
						<span>Buka Google Maps</span>
						<i class="fas fa-arrow-up-right-from-square text-[10px]"></i>
					</a>
				</div>

				<div class="p-6 rounded-3xl bg-white border border-zinc-200/80 shadow-sm space-y-3">
					<div class="flex items-center gap-1 text-amber-500">
						<i class="fas fa-star text-xs"></i>
						<i class="fas fa-star text-xs"></i>
						<i class="fas fa-star text-xs"></i>
						<i class="fas fa-star text-xs"></i>
						<i class="fas fa-star text-xs"></i>
						<span class="text-xs font-bold text-zinc-700 ml-1.5">5.0</span>
					</div>
					<p class="text-xs sm:text-sm text-zinc-700 leading-relaxed italic">
						"Servisnya rapi banget, mekaniknya ramah dan enak diajak diskusi masalah settingan RD. Recommended banget di Cikande Serang!"
					</p>
					<div class="flex items-center justify-between text-xs text-zinc-500 pt-2 border-t border-zinc-100">
						<span class="font-bold text-zinc-900">Andi Saputra</span>
						<span>Komunitas Roadbike</span>
					</div>
				</div>

				<div class="p-6 rounded-3xl bg-white border border-zinc-200/80 shadow-sm space-y-3">
					<div class="flex items-center gap-1 text-amber-500">
						<i class="fas fa-star text-xs"></i>
						<i class="fas fa-star text-xs"></i>
						<i class="fas fa-star text-xs"></i>
						<i class="fas fa-star text-xs"></i>
						<i class="fas fa-star text-xs"></i>
						<span class="text-xs font-bold text-zinc-700 ml-1.5">5.0</span>
					</div>
					<p class="text-xs sm:text-sm text-zinc-700 leading-relaxed italic">
						"Beli sparepart lengkap disini, harganya bersaing sama online. Pemasangan dan setting cepat bisa ditunggu sambil ngobrol."
					</p>
					<div class="flex items-center justify-between text-xs text-zinc-500 pt-2 border-t border-zinc-100">
						<span class="font-bold text-zinc-900">Budi Santoso</span>
						<span>Pelanggan Setia Toko AL</span>
					</div>
				</div>
			</div>

		</div>
	</div>
</section>

<script>
	const slides = document.querySelectorAll('.ambient-slide');
	const counter = document.getElementById('gallery-counter');
	const btnPrev = document.getElementById('slide-prev');
	const btnNext = document.getElementById('slide-next');

	let current = 0;
	const total = slides.length;

	function show(index: number) {
		slides.forEach((s, i) => {
			if (i === index) {
				s.classList.remove('opacity-0', 'pointer-events-none');
				s.classList.add('opacity-100', 'pointer-events-auto');
			} else {
				s.classList.remove('opacity-100', 'pointer-events-auto');
				s.classList.add('opacity-0', 'pointer-events-none');
			}
		});
		if (counter) counter.textContent = `${index + 1} / ${total}`;
	}

	btnPrev?.addEventListener('click', () => {
		current = (current - 1 + total) % total;
		show(current);
	});

	btnNext?.addEventListener('click', () => {
		current = (current + 1) % total;
		show(current);
	});
</script>
