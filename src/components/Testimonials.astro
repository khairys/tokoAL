---
// Testimonials Component
import videoThumbnail from '../assets/video-thumbnail.jpg';
import userA from '../assets/user-a.jpg';
import userB from '../assets/user-b.jpg';
---

<section class="py-16 bg-green-50">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
			
			<!-- Video Section -->
			<div class="fade-in-up">
				<h2 class="text-2xl font-bold mb-6">Intip Keseruannya</h2>
				<div class="rounded-2xl overflow-hidden shadow-2xl border-2 border-white hover:border-primary transition-all duration-200 hover:shadow-primary/20 hover:scale-105 group">
					<!-- Placeholder for Youtube Embed -->
					<div class="relative pb-[56.25%] h-0 bg-gray-300">
						<img src={videoThumbnail.src} class="absolute top-0 left-0 w-full h-full object-cover" alt="Video Thumbnail">
						<div class="absolute inset-0 flex items-center justify-center">
							<button class="w-16 h-16 bg-red-600 text-white rounded-full flex items-center justify-center shadow-lg hover:scale-125 transition-all duration-200 group-hover:animate-pulse hover:shadow-2xl">
								<i class="fas fa-play ml-1"></i>
							</button>
						</div>
					</div>
				</div>
			</div>

			<!-- Testimonials -->
			<div class="fade-in-up" style="transition-delay: 200ms;">
				<h2 class="text-2xl font-bold mb-6">Apa Kata Goweser?</h2>
				
				<div class="space-y-4">
					<!-- Review Card 1 -->
					<div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 relative transition-all duration-200 hover:shadow-xl hover:scale-105 hover:-translate-y-1 hover:border-primary group">
						<i class="fas fa-quote-right absolute top-4 right-4 text-gray-100 text-4xl group-hover:text-primary/20 transition-colors duration-200"></i>
						<div class="flex items-center gap-1 text-yellow-400 mb-2">
							<i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
						</div>
						<p class="text-gray-600 italic text-sm mb-3">"Servisnya rapi banget, mekaniknya ramah dan enak diajak diskusi masalah settingan RD. Recommended di Serang!"</p>
						<div class="flex items-center gap-3">
							<img src={userA.src} class="w-10 h-10 rounded-full" alt="User">
							<div>
								<p class="font-bold text-sm">Andi Saputra</p>
								<p class="text-xs text-gray-400">Komunitas Roadbike</p>
							</div>
						</div>
					</div>

					<!-- Review Card 2 -->
					<div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 relative transition-all duration-200 hover:shadow-xl hover:scale-105 hover:-translate-y-1 hover:border-primary group">
						 <i class="fas fa-quote-right absolute top-4 right-4 text-gray-100 text-4xl group-hover:text-primary/20 transition-colors duration-200"></i>
						<div class="flex items-center gap-1 text-yellow-400 mb-2">
							<i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star-half-alt"></i>
						</div>
						<p class="text-gray-600 italic text-sm mb-3">"Beli sparepart lengkap disini, harganya bersaing sama online. Pemasangan juga cepat."</p>
						<div class="flex items-center gap-3">
							<img src={userB.src} class="w-10 h-10 rounded-full" alt="User">
							<div>
								<p class="font-bold text-sm">Budi Santoso</p>
								<p class="text-xs text-gray-400">Pelanggan Setia</p>
							</div>
						</div>
					</div>
				</div>
			</div>

		</div>
	</div>
</section>
