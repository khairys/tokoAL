---
// Testimonials & Store Gallery Component
import imgEtalase from '../assets/gallery/etalaseDepan.png';
import imgKasir from '../assets/gallery/kasirAL.png';
import imgViewBelakang from '../assets/gallery/viewbelakang.png';
import imgDepanRumah from '../assets/gallery/depan rumah.png';
import imgPelanggan from '../assets/gallery/Pelanggan.png';
import imgMobilAnak from '../assets/gallery/MobilANAK.png';

const storePhotos = [
	{
		src: imgEtalase.src,
		alt: "Etalase Sepeda Toko AL",
		tag: "Etalase Toko",
		title: "Display Unit Sepeda Lengkap",
		desc: "Pilihan MTB, sepeda lipat, dan sepeda anak ready stock"
	},
	{
		src: imgKasir.src,
		alt: "Area Kasir Toko AL",
		tag: "Area Kasir & Aksesoris",
		title: "Pelayanan Ramah & Transparan",
		desc: "Konsultasi part sepeda dan transaksi mudah"
	},
	{
		src: imgPelanggan.src,
		alt: "Pelanggan Toko AL",
		tag: "Goweser Cikande",
		title: "Kepuasan Pelanggan Prioritas Kami",
		desc: "Selalu senang membantu goweser mendapatkan sepeda impian"
	},
	{
		src: imgViewBelakang.src,
		alt: "Suasana Dalam Toko AL",
		tag: "Suasana Toko",
		title: "Koleksi Lengkap & Nyaman",
		desc: "Tersedia sparepart dan perlengkapan sepeda terlengkap"
	},
	{
		src: imgDepanRumah.src,
		alt: "Tampak Depan Toko AL",
		tag: "Lokasi Toko",
		title: "Kunjungi Toko AL di Cikande Permai",
		desc: "Jl. Cikande Permai Blok J2 No.6, Cikande Permai, Serang"
	},
	{
		src: imgMobilAnak.src,
		alt: "Koleksi Sepeda dan Mainan Anak",
		tag: "Koleksi Anak",
		title: "Sepeda & Mainan Anak",
		desc: "Pilihan sepeda roda tiga, push bike, dan mainan seru"
	}
];
---

<section id="gallery" class="py-20 bg-white border-t border-gray-100">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
			
			<!-- Store Gallery Auto-Carousel Section -->
			<div class="lg:col-span-7 fade-in-up">
				<div class="flex items-center justify-between mb-4">
					<div>
						<span class="text-xs font-bold uppercase tracking-wider text-[#116530] bg-emerald-100/60 border border-emerald-200/50 px-3 py-0.5 rounded-full inline-block mb-1.5">
							Dokumentasi
						</span>
						<h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900">Suasana Nyata Toko AL</h2>
					</div>
					<span id="carousel-counter" class="text-xs font-semibold px-3 py-1 bg-gray-100 text-gray-700 rounded-full border border-gray-200">
						1 / {storePhotos.length}
					</span>
				</div>

				<!-- Carousel Box -->
				<div id="gallery-carousel" class="relative aspect-[16/11] sm:aspect-[16/10] rounded-2xl overflow-hidden shadow-md border border-gray-200/80 group select-none bg-gray-950">
					
					<!-- Slide Items -->
					{storePhotos.map((photo, index) => (
						<div 
							class={`gallery-slide absolute inset-0 transition-opacity duration-700 ease-in-out ${index === 0 ? 'opacity-100 pointer-events-auto' : 'opacity-0 pointer-events-none'}`}
							data-index={index}
						>
							<img 
								src={photo.src} 
								alt={photo.alt} 
								class="w-full h-full object-cover" 
								loading={index === 0 ? "eager" : "lazy"}
							/>
							<!-- Gradient Overlay -->
							<div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent pointer-events-none"></div>

							<!-- Slide Captions -->
							<div class="absolute bottom-4 left-4 right-16 sm:bottom-6 sm:left-6 sm:right-20 text-white z-10 pointer-events-none">
								<span class="inline-block px-2.5 py-0.5 bg-white/20 backdrop-blur-md text-white text-[11px] font-semibold rounded-full uppercase tracking-wider mb-1.5">
									{photo.tag}
								</span>
								<h3 class="text-base sm:text-xl font-bold leading-tight drop-shadow-sm">{photo.title}</h3>
								<p class="text-xs text-gray-200 mt-1 line-clamp-1 drop-shadow-sm">{photo.desc}</p>
							</div>
						</div>
					))}

					<!-- Navigation Arrows -->
					<button 
						id="gallery-prev" 
						aria-label="Foto Sebelumnya"
						class="absolute left-3 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-white/80 hover:bg-white text-gray-800 backdrop-blur-md flex items-center justify-center transition-all duration-200 opacity-0 group-hover:opacity-100 hover:scale-105 shadow-md cursor-pointer"
					>
						<i class="fas fa-chevron-left text-xs"></i>
					</button>

					<button 
						id="gallery-next" 
						aria-label="Foto Selanjutnya"
						class="absolute right-3 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-white/80 hover:bg-white text-gray-800 backdrop-blur-md flex items-center justify-center transition-all duration-200 opacity-0 group-hover:opacity-100 hover:scale-105 shadow-md cursor-pointer"
					>
						<i class="fas fa-chevron-right text-xs"></i>
					</button>

					<!-- Dot Indicators -->
					<div class="absolute bottom-4 right-4 sm:bottom-6 sm:right-6 z-20 flex items-center gap-1.5">
						{storePhotos.map((_, index) => (
							<button 
								class={`gallery-dot h-1.5 rounded-full transition-all duration-300 cursor-pointer ${index === 0 ? 'w-5 bg-white' : 'w-1.5 bg-white/50 hover:bg-white'}`}
								aria-label={`Lihat foto ${index + 1}`}
								data-index={index}
							></button>
						))}
					</div>
				</div>
			</div>

			<!-- Testimonials Section -->
			<div class="lg:col-span-5 fade-in-up" style="transition-delay: 150ms;">
				<div class="flex items-center justify-between flex-wrap gap-2 mb-4">
					<div>
						<span class="text-xs font-bold uppercase tracking-wider text-[#116530] bg-emerald-100/60 border border-emerald-200/50 px-3 py-0.5 rounded-full inline-block mb-1.5">
							Testimoni
						</span>
						<h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900">Ulasan Pelanggan</h2>
					</div>
					<a
						href="https://maps.app.goo.gl/uXpQYw8dKrn5U22P8"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-1.5 px-3 py-1 bg-amber-50 border border-amber-200 text-amber-900 text-xs font-bold rounded-full hover:bg-amber-100 transition-all shadow-sm"
						title="Buka ulasan di Google Maps"
					>
						<i class="fas fa-star text-amber-500"></i>
						<span>4.9 / 5.0 di Google Maps</span>
						<i class="fas fa-external-link-alt text-[9px] text-amber-600"></i>
					</a>
				</div>
				
				<div class="space-y-4">
					<!-- Review Card 1 -->
					<div class="bg-slate-50/70 p-5 sm:p-6 rounded-2xl border border-gray-200/70 transition-all duration-200 hover:border-emerald-200 hover:shadow-sm">
						<div class="flex items-center gap-1 text-amber-400 mb-2">
							<i class="fas fa-star text-xs"></i><i class="fas fa-star text-xs"></i><i class="fas fa-star text-xs"></i><i class="fas fa-star text-xs"></i><i class="fas fa-star text-xs"></i>
							<span class="text-xs text-gray-500 font-semibold ml-1.5">5.0</span>
						</div>
						<p class="text-gray-700 text-sm mb-4 leading-relaxed">
							"Servisnya rapi banget, mekaniknya ramah dan enak diajak diskusi masalah settingan RD. Pilihan sparepart juga lengkap di Cikande!"
						</p>
						<div class="flex items-center gap-3">
							<div class="w-9 h-9 rounded-full bg-emerald-100 text-[#116530] font-bold flex items-center justify-center text-xs">
								AS
							</div>
							<div>
								<p class="font-bold text-sm text-gray-900">Andi Saputra</p>
								<p class="text-xs text-gray-500">Komunitas Roadbike</p>
							</div>
						</div>
					</div>

					<!-- Review Card 2 -->
					<div class="bg-slate-50/70 p-5 sm:p-6 rounded-2xl border border-gray-200/70 transition-all duration-200 hover:border-emerald-200 hover:shadow-sm">
						<div class="flex items-center gap-1 text-amber-400 mb-2">
							<i class="fas fa-star text-xs"></i><i class="fas fa-star text-xs"></i><i class="fas fa-star text-xs"></i><i class="fas fa-star text-xs"></i><i class="fas fa-star text-xs"></i>
							<span class="text-xs text-gray-500 font-semibold ml-1.5">5.0</span>
						</div>
						<p class="text-gray-700 text-sm mb-4 leading-relaxed">
							"Beli sparepart lengkap di sini, harganya bersaing sama online. Pemasangan dan setting cepat bisa ditunggu sambil santai."
						</p>
						<div class="flex items-center gap-3">
							<div class="w-9 h-9 rounded-full bg-emerald-100 text-[#116530] font-bold flex items-center justify-center text-xs">
								BS
							</div>
							<div>
								<p class="font-bold text-sm text-gray-900">Budi Santoso</p>
								<p class="text-xs text-gray-500">Pelanggan Setia Toko AL</p>
							</div>
						</div>
					</div>
				</div>
			</div>

		</div>
	</div>
</section>

<script>
	// Store Gallery Auto-Carousel Logic
	const slides = document.querySelectorAll('.gallery-slide');
	const dots = document.querySelectorAll('.gallery-dot');
	const counter = document.getElementById('carousel-counter');
	const prevBtn = document.getElementById('gallery-prev');
	const nextBtn = document.getElementById('gallery-next');
	const carousel = document.getElementById('gallery-carousel');

	let currentIndex = 0;
	let autoPlayTimer: any = null;
	const total = slides.length;

	function showSlide(index: number) {
		if (total === 0) return;
		
		// Hide current
		slides[currentIndex]?.classList.remove('opacity-100', 'pointer-events-auto');
		slides[currentIndex]?.classList.add('opacity-0', 'pointer-events-none');
		
		dots[currentIndex]?.classList.remove('w-6', 'bg-primary');
		dots[currentIndex]?.classList.add('w-2', 'bg-white/60');

		// New index
		currentIndex = (index + total) % total;

		// Show next
		slides[currentIndex]?.classList.remove('opacity-0', 'pointer-events-none');
		slides[currentIndex]?.classList.add('opacity-100', 'pointer-events-auto');

		dots[currentIndex]?.classList.remove('w-2', 'bg-white/60');
		dots[currentIndex]?.classList.add('w-6', 'bg-primary');

		if (counter) {
			counter.textContent = `${currentIndex + 1} / ${total}`;
		}
	}

	function nextSlide() {
		showSlide(currentIndex + 1);
	}

	function prevSlide() {
		showSlide(currentIndex - 1);
	}

	function startTimer() {
		stopTimer();
		autoPlayTimer = setInterval(nextSlide, 3500);
	}

	function stopTimer() {
		if (autoPlayTimer) {
			clearInterval(autoPlayTimer);
			autoPlayTimer = null;
		}
	}

	// Navigation listeners
	nextBtn?.addEventListener('click', (e) => {
		e.stopPropagation();
		nextSlide();
		startTimer();
	});

	prevBtn?.addEventListener('click', (e) => {
		e.stopPropagation();
		prevSlide();
		startTimer();
	});

	dots.forEach((dot, idx) => {
		dot.addEventListener('click', (e) => {
			e.stopPropagation();
			showSlide(idx);
			startTimer();
		});
	});

	// Pause on hover
	carousel?.addEventListener('mouseenter', stopTimer);
	carousel?.addEventListener('mouseleave', startTimer);

	// Start auto-play
	startTimer();
</script>
