---
// Partners & Brands Component
import logoPacific from '../assets/partners/Pacific Bike Logo vector (_cdr).jpg';
import logoElement from '../assets/partners/elementlogo.jpeg';
import logoUnited from '../assets/partners/united logo.png';
import logoFamily from '../assets/partners/family logo.png';
import logoPmb from '../assets/partners/pmb logo.png';
import logoKenda from '../assets/partners/kenda logo.jpg';
import logoSwallow from '../assets/partners/swallow logo.png';
import logoRevo from '../assets/partners/revo logo.jpg';

const brands = [
    { name: 'Pacific Bike', logo: logoPacific, category: 'Sepeda & MTB' },
    { name: 'United Bike', logo: logoUnited, category: 'Sepeda & Aksesoris' },
    { name: 'Element Bike', logo: logoElement, category: 'Sepeda Lipat & Balap' },
    { name: 'Family Bike', logo: logoFamily, category: 'Sepeda Anak' },
    { name: 'PMB Toys', logo: logoPmb, category: 'Mainan Edukatif' },
    { name: 'Kenda Tire', logo: logoKenda, category: 'Ban Berkualitas' },
    { name: 'Swallow Deli', logo: logoSwallow, category: 'Ban Luar & Dalam' },
    { name: 'Revo', logo: logoRevo, category: 'Suku Cadang' },
];
---

<!-- === PARTNERS & BRANDS SECTION === -->
<section id="partners" class="py-20 bg-slate-50/50 border-t border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Section Header -->
        <div class="text-center mb-12 fade-in-up">
            <span class="text-xs font-bold uppercase tracking-wider text-[#116530] bg-emerald-100/60 border border-emerald-200/50 px-3.5 py-1 rounded-full inline-block mb-3">
                Jaminan Mutu
            </span>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight">
                Brand Resmi & Merek Terpercaya
            </h2>
            <p class="mt-3.5 text-gray-600 max-w-2xl mx-auto text-base sm:text-lg leading-relaxed">
                Toko AL hanya menghadirkan unit sepeda original dan suku cadang bergaransi resmi dari produsen terkemuka.
            </p>
        </div>

        <!-- 8 Brand Logos Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-5xl mx-auto fade-in-up">
            {brands.map((brand) => (
                <div class="group bg-white p-4 sm:p-5 rounded-2xl border border-gray-200/80 hover:border-emerald-300 hover:shadow-md transition-all duration-200 flex flex-col items-center justify-center text-center h-28">
                    <div class="w-full h-12 flex items-center justify-center mb-1.5 overflow-hidden">
                        <img
                            src={brand.logo.src}
                            alt={brand.name}
                            class="max-h-10 max-w-[80%] object-contain filter grayscale opacity-75 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-300"
                            loading="lazy"
                        />
                    </div>
                    <span class="text-xs font-semibold text-gray-800 group-hover:text-[#116530] transition-colors line-clamp-1">
                        {brand.name}
                    </span>
                    <span class="text-[10px] text-gray-400 line-clamp-1">
                        {brand.category}
                    </span>
                </div>
            ))}
        </div>

        <!-- Community Callout Banner -->
        <div class="mt-12 text-center fade-in-up" style="transition-delay: 100ms;">
            <p class="text-xs sm:text-sm text-gray-500">
                Punya rencana event gowes bareng, bakti sosial, atau kolaborasi komunitas? 
                <a 
                    href="https://api.whatsapp.com/send?phone=6281996535525&text=Halo%20Toko%20AL,%20saya%20ingin%20mengajukan%20kolaborasi%20event" 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="font-semibold text-primary hover:text-[#116530] inline-flex items-center gap-1 ml-1"
                >
                    <span>Hubungi admin kami di WhatsApp</span>
                    <i class="fas fa-arrow-right text-[10px]"></i>
                </a>
            </p>
        </div>

    </div>
</section>
