---
import Icon from "./Icon.astro";
import { Image } from "astro:assets";
import logoPacific from "../assets/partners/Pacific Bike Logo vector (_cdr).jpg";
import logoElement from "../assets/partners/elementlogo.jpeg";
import logoUnited from "../assets/partners/united logo.png";
import logoFamily from "../assets/partners/family logo.png";
import logoPmb from "../assets/partners/pmb logo.png";
import logoKenda from "../assets/partners/kenda logo.jpg";
import logoSwallow from "../assets/partners/swallow logo.png";
import logoRevo from "../assets/partners/revo logo.jpg";
import Eyebrow from "./Eyebrow.astro";
import { wa } from "../lib/site";

const brands = [
	{ name: "Pacific Bike", logo: logoPacific },
	{ name: "United Bike", logo: logoUnited },
	{ name: "Element Bike", logo: logoElement },
	{ name: "Family Bike", logo: logoFamily },
	{ name: "PMB Toys", logo: logoPmb },
	{ name: "Kenda Tire", logo: logoKenda },
	{ name: "Swallow Deli", logo: logoSwallow },
	{ name: "Revo Parts", logo: logoRevo },
];

const communities = [
	{ name: "Gorikat", initials: "GK" },
	{ name: "East Cycle", initials: "EC" },
	{ name: "Desavora", initials: "DV" },
	{ name: "Ciruas Bike Sport", initials: "CBS" },
];

const sponsorWaUrl = wa(
	"Halo Toko AL! 👋 Saya ingin mengajukan kerjasama / sponsorship event untuk komunitas kami. Mohon informasi terkait prosedur dan persyaratannya. Terima kasih!",
);
---

<section id="partners" class="section" aria-labelledby="brands-title">
	<div class="container">
		<div class="section-head" data-reveal="up">
			<Eyebrow label="Merek & Komunitas" />
			<h2 id="brands-title">Brand yang Tersedia di Toko AL</h2>
			<p>Pilihan produk dari berbagai brand yang tersedia di Toko AL.</p>
		</div>
	</div>

	<!-- Running logo row. The second copy only exists to make the loop seamless. -->
	<div class="logos" data-reveal="up">
		<div class="logos__track">
			{[0, 1].map((copy) => (
				<ul class="logos__group" aria-hidden={copy === 1 ? "true" : undefined}>
					{brands.map((b) => (
						<li class="brand">
							<Image
								src={b.logo}
								width={200}
								widths={[160, 320]}
								sizes="160px"
								alt={copy === 0 ? `Logo ${b.name}` : ""}
								loading="lazy"
							/>
						</li>
					))}
				</ul>
			))}
		</div>
	</div>

	<div class="container">
		<div class="community" data-reveal="up">
			<div class="section-head">
				<h2>Tumbuh Bersama Komunitas</h2>
				<p>Kami mendukung dan berkolaborasi dengan komunitas serta kegiatan bersepeda di sekitar kami.</p>
			</div>

			<ul class="communities" data-reveal="stagger">
				{communities.map((c, i) => (
					<li class="club" style={`--i: ${i}`}>
						<span class="club__mark" aria-hidden="true">{c.initials}</span>
						<span class="club__name">{c.name}</span>
					</li>
				))}
			</ul>

			<div class="sponsor">
				<p>Punya kegiatan atau komunitas yang ingin berkolaborasi dengan kami?</p>
				<a href={sponsorWaUrl} target="_blank" rel="noopener noreferrer" class="btn btn--light">
					<Icon name="brands:whatsapp" />
					<span>Ajukan Sponsorship</span>
				</a>
			</div>
		</div>
	</div>
</section>
