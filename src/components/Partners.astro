---
// Brands & Community Section Component
import logoPacific from '../assets/partners/Pacific Bike Logo vector (_cdr).jpg';
import logoElement from '../assets/partners/elementlogo.jpeg';
import logoUnited from '../assets/partners/united logo.png';
import logoFamily from '../assets/partners/family logo.png';
import logoPmb from '../assets/partners/pmb logo.png';
import logoKenda from '../assets/partners/kenda logo.jpg';
import logoSwallow from '../assets/partners/swallow logo.png';
import logoRevo from '../assets/partners/revo logo.jpg';

const brands = [
    { name: 'Pacific Bike', logo: logoPacific },
    { name: 'United Bike', logo: logoUnited },
    { name: 'Element Bike', logo: logoElement },
    { name: 'Family Bike', logo: logoFamily },
    { name: 'PMB Toys', logo: logoPmb },
    { name: 'Kenda Tire', logo: logoKenda },
    { name: 'Swallow Deli', logo: logoSwallow },
    { name: 'Revo Parts', logo: logoRevo },
];

const communities = [
    {
        name: 'Gorikat',
        category: 'Gowes Kompak & Rutin',
        initials: 'GK',
        gradient: 'from-[#116530] to-emerald-500',
        icon: 'fa-bicycle',
    },
    {
        name: 'East Cycle',
        category: 'Roadbike & Urban',
        initials: 'EC',
        gradient: 'from-teal-600 to-cyan-500',
        icon: 'fa-road',
    },
    {
        name: 'Desavora',
        category: 'MTB & Adventure',
        initials: 'DV',
        gradient: 'from-emerald-700 to-green-600',
        icon: 'fa-mountain',
    },
    {
        name: 'Ciruas Bike Sport',
        category: 'All-Terrain Cycling',
        initials: 'CBS',
        gradient: 'from-amber-600 to-orange-500',
        icon: 'fa-compass',
    },
];
---

<!-- === BRANDS & COMMUNITY SECTION === -->
<section id="partners" class="py-20 sm:py-24 bg-white relative overflow-hidden border-t border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        <!-- ============================================== -->
        <!-- 1. BRANDS SECTION (DI ATAS)                    -->
        <!-- ============================================== -->
        <div class="text-center max-w-3xl mx-auto mb-12 fade-in-up">
            <span class="text-xs sm:text-sm font-bold uppercase tracking-widest text-primary block mb-2">
                BRANDS
            </span>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight mb-4">
                Brand yang Tersedia di Toko AL
            </h2>
            <p class="text-base sm:text-lg text-gray-600 leading-relaxed max-w-xl mx-auto">
                Pilihan produk dari berbagai brand yang secara rutin tersedia di Toko AL.
            </p>
        </div>

        <!-- Brands Grid: 4 Kolom x 2 Baris (8 Brands) -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 sm:gap-8 md:gap-10 items-center justify-items-center max-w-5xl mx-auto px-4 fade-in-up">
            {brands.map((brand) => (
                <div 
                    class="h-16 sm:h-20 w-36 sm:w-44 flex items-center justify-center p-3 rounded-2xl hover:bg-gray-50/80 transition-all duration-200 group"
                    title={brand.name}
                >
                    <img
                        src={brand.logo.src}
                        alt={`Logo ${brand.name}`}
                        class="max-h-12 sm:max-h-14 max-w-full object-contain filter grayscale hover:grayscale-0 opacity-80 hover:opacity-100 group-hover:scale-105 transition-all duration-300 drop-shadow-sm"
                        loading="lazy"
                    />
                </div>
            ))}
        </div>

        <!-- ============================================== -->
        <!-- DIVIDER PEMISAH                                 -->
        <!-- ============================================== -->
        <div class="my-16 sm:my-20 max-w-4xl mx-auto">
            <div class="relative flex items-center justify-center">
                <div class="border-t border-gray-200 w-full"></div>
                <div class="absolute bg-white px-4 text-gray-300">
                    <i class="fas fa-bicycle text-sm text-gray-400"></i>
                </div>
            </div>
        </div>

        <!-- ============================================== -->
        <!-- 2. COMMUNITY SECTION (DI BAWAH)                -->
        <!-- ============================================== -->
        <div class="text-center max-w-3xl mx-auto mb-10 fade-in-up">
            <span class="text-xs sm:text-sm font-bold uppercase tracking-widest text-primary block mb-2">
                COMMUNITY
            </span>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight mb-4">
                Tumbuh Bersama Komunitas
            </h2>
            <p class="text-base sm:text-lg text-gray-600 leading-relaxed max-w-xl mx-auto">
                Kami mendukung dan berkolaborasi dengan komunitas serta kegiatan bersepeda di sekitar kami.
            </p>
        </div>

        <!-- Logo / Badge Komunitas Sementara (Mudah Diganti Gambar Logo) -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6 max-w-4xl mx-auto fade-in-up">
            {communities.map((comm) => (
                <div class="bg-gray-50 hover:bg-white rounded-2xl p-5 border border-gray-100 hover:border-primary/30 hover:shadow-md transition-all duration-200 flex flex-col items-center text-center group">
                    <!-- Placeholder Logo Badge (Nanti dapat diganti dengan tag <img> logo komunitas) -->
                    <div class={`w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-br ${comm.gradient} text-white flex flex-col items-center justify-center shadow-sm group-hover:scale-105 transition-transform duration-200 mb-3 relative overflow-hidden`}>
                        <i class={`fas ${comm.icon} text-lg sm:text-xl mb-0.5 opacity-90`}></i>
                        <span class="text-xs sm:text-sm font-extrabold tracking-wider">{comm.initials}</span>
                    </div>
                    
                    <h3 class="font-bold text-sm sm:text-base text-gray-900 group-hover:text-primary transition-colors">
                        {comm.name}
                    </h3>
                    <span class="text-[11px] text-gray-500 mt-0.5">
                        {comm.category}
                    </span>
                </div>
            ))}
        </div>

        <!-- Call to Action: Pengajuan Sponsorship -->
        <div class="mt-12 text-center max-w-md mx-auto fade-in-up">
            <p class="text-sm sm:text-base font-semibold text-gray-800 mb-4">
                Punya kegiatan atau komunitas yang ingin berkolaborasi dengan kami?
            </p>
            <button
                id="open-sponsor-modal"
                type="button"
                class="inline-flex items-center justify-center gap-2.5 px-8 py-3.5 bg-primary hover:bg-[#116530] text-white font-bold text-sm sm:text-base rounded-full shadow-lg shadow-primary/25 hover:shadow-xl hover:shadow-[#116530]/25 transform hover:-translate-y-0.5 active:scale-95 transition-all duration-150 cursor-pointer"
            >
                <i class="fas fa-handshake text-base"></i>
                <span>Ajukan Sponsorship</span>
            </button>
        </div>

    </div>
</section>

<!-- === MODAL FORM PENGAJUAN SPONSORSHIP === -->
<div
    id="sponsor-modal"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-title"
>
    <div
        id="sponsor-modal-card"
        class="bg-white rounded-3xl w-full max-w-lg p-6 sm:p-8 shadow-2xl border border-gray-100 transform scale-95 transition-all duration-300 relative max-h-[90vh] overflow-y-auto"
    >
        <!-- Close Button -->
        <button
            id="close-sponsor-modal"
            type="button"
            aria-label="Tutup formulir"
            class="absolute top-5 right-5 w-9 h-9 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-500 hover:text-gray-800 flex items-center justify-center transition-colors cursor-pointer"
        >
            <i class="fas fa-times"></i>
        </button>

        <!-- Modal Header -->
        <div class="mb-6 pr-6">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#A3EBB1]/30 text-dark text-xs font-bold mb-2">
                <i class="fas fa-handshake text-primary"></i>
                <span>Kolaborasi Komunitas</span>
            </div>
            <h3 id="modal-title" class="text-xl sm:text-2xl font-extrabold text-gray-900">
                Ajukan Sponsorship & Kerjasama
            </h3>
            <p class="text-xs text-gray-500 mt-1">
                Kirimkan detail event gowes atau kegiatan komunitas Anda langsung ke WhatsApp resmi Toko AL.
            </p>
        </div>

        <!-- Form Fields -->
        <form id="sponsor-form" class="space-y-4">
            <div>
                <label for="comm-name" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">
                    Nama Komunitas / Penyelenggara *
                </label>
                <input
                    type="text"
                    id="comm-name"
                    required
                    placeholder="Contoh: Gowes Bareng Cikande"
                    class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-gray-900"
                />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                <div>
                    <label for="pic-name" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">
                        Nama PIC / Kontak *
                    </label>
                    <input
                        type="text"
                        id="pic-name"
                        required
                        placeholder="Nama lengkap Anda"
                        class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-gray-900"
                    />
                </div>
                <div>
                    <label for="pic-wa" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">
                        Nomor WhatsApp PIC *
                    </label>
                    <input
                        type="tel"
                        id="pic-wa"
                        required
                        placeholder="0812xxxxxxx"
                        class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-gray-900"
                    />
                </div>
            </div>

            <div>
                <label for="event-date" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">
                    Estimasi Waktu Event
                </label>
                <input
                    type="text"
                    id="event-date"
                    placeholder="Contoh: Akhir Bulan Ini / Oktober 2026"
                    class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-gray-900"
                />
            </div>

            <div>
                <label for="collab-type" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">
                    Rencana Kerjasama yang Diharapkan *
                </label>
                <textarea
                    id="collab-type"
                    required
                    rows="3"
                    placeholder="Contoh: Doorprize sepeda/aksesoris, stand servis sepeda gratis, jersey, atau publikasi..."
                    class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-gray-900 resize-none"
                ></textarea>
            </div>

            <!-- Submit Button -->
            <div class="pt-2">
                <button
                    type="submit"
                    class="w-full py-3.5 px-6 bg-primary hover:bg-[#116530] text-white font-bold text-sm rounded-xl shadow-lg shadow-primary/25 transition-all duration-200 active:scale-95 flex items-center justify-center gap-2 cursor-pointer"
                >
                    <i class="fab fa-whatsapp text-lg"></i>
                    <span>Kirim Pengajuan ke WhatsApp</span>
                </button>
                <p class="text-[11px] text-gray-400 text-center mt-2">
                    Formulir akan otomatis membuka chat WhatsApp resmi Toko AL (+62 819-9653-5525).
                </p>
            </div>
        </form>
    </div>
</div>

<script>
    // Modal Open / Close Logic
    const openBtn = document.getElementById('open-sponsor-modal');
    const closeBtn = document.getElementById('close-sponsor-modal');
    const modal = document.getElementById('sponsor-modal');
    const modalCard = document.getElementById('sponsor-modal-card');
    const form = document.getElementById('sponsor-form') as HTMLFormElement | null;

    function openModal() {
        if (!modal || !modalCard) return;
        modal.classList.remove('opacity-0', 'pointer-events-none');
        modalCard.classList.remove('scale-95');
        modalCard.classList.add('scale-100');
        document.body.style.overflow = 'hidden';
    }

    function closeModal() {
        if (!modal || !modalCard) return;
        modal.classList.add('opacity-0', 'pointer-events-none');
        modalCard.classList.remove('scale-100');
        modalCard.classList.add('scale-95');
        document.body.style.overflow = '';
    }

    openBtn?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);

    modal?.addEventListener('click', (e) => {
        if (e.target === modal) {
            closeModal();
        }
    });

    window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal && !modal.classList.contains('pointer-events-none')) {
            closeModal();
        }
    });

    // Submit form to WhatsApp
    form?.addEventListener('submit', (e) => {
        e.preventDefault();
        
        const commName = (document.getElementById('comm-name') as HTMLInputElement)?.value.trim();
        const picName = (document.getElementById('pic-name') as HTMLInputElement)?.value.trim();
        const picWa = (document.getElementById('pic-wa') as HTMLInputElement)?.value.trim();
        const eventDate = (document.getElementById('event-date') as HTMLInputElement)?.value.trim() || '-';
        const collabType = (document.getElementById('collab-type') as HTMLTextAreaElement)?.value.trim();

        const message = `Halo Toko AL! 👋%0A%0ASaya ingin mengajukan *Proposal Kerjasama / Sponsorship Event*:%0A%0A` +
            `🏢 *Nama Komunitas/Penyelenggara:* ${encodeURIComponent(commName)}%0A` +
            `👤 *Nama PIC:* ${encodeURIComponent(picName)}%0A` +
            `📱 *No. WhatsApp PIC:* ${encodeURIComponent(picWa)}%0A` +
            `📅 *Estimasi Waktu:* ${encodeURIComponent(eventDate)}%0A` +
            `🤝 *Bentuk Kerjasama:*%0A${encodeURIComponent(collabType)}%0A%0A` +
            `Mohon informasi lebih lanjut terkait prosedur kerjasama dengan Toko AL. Terima kasih!`;

        const waUrl = `https://api.whatsapp.com/send?phone=6281996535525&text=${message}`;
        window.open(waUrl, '_blank');
        closeModal();
    });
</script>
