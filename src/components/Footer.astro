---
import { Image } from "astro:assets";
import logoNavbar from "../assets/branding/Logo navbar.png";

const socials = [
	{ href: "https://www.instagram.com/tokoal_id", icon: "fa-instagram", label: "Instagram Toko AL" },
	{ href: "https://www.tiktok.com/@tokoal.id", icon: "fa-tiktok", label: "TikTok Toko AL" },
	{ href: "https://www.youtube.com/@tokoal_id", icon: "fa-youtube", label: "YouTube Toko AL" },
	{ href: "https://www.facebook.com/admintokoalid", icon: "fa-facebook-f", label: "Facebook Toko AL" },
	{ href: "https://api.whatsapp.com/send?phone=6281996535525&text=Halo%20Toko%20AL", icon: "fa-whatsapp", label: "WhatsApp Toko AL" },
];

const links = [
	{ href: "#home", label: "Beranda" },
	{ href: "#products", label: "Katalog" },
	{ href: "#services", label: "Layanan" },
	{ href: "#gallery", label: "Suasana Toko" },
	{ href: "#partners", label: "Merek & Komunitas" },
	{ href: "#contact", label: "Kontak" },
];
---

<footer class="footer">
	<div class="container">
		<div class="footer__top">
			<div class="footer__brand">
				<a href="#home">
					<Image src={logoNavbar} width={160} alt="Logo Toko AL" />
					<strong>Toko AL</strong>
				</a>
				<p>Toko Sepeda & Servis di Cikande Permai, Serang</p>
			</div>
			<div class="socials">
				{socials.map((s) => (
					<a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
						<i class={`fab ${s.icon}`} aria-hidden="true"></i>
					</a>
				))}
			</div>
		</div>

		<div class="footer__bottom">
			<nav class="footer__nav" aria-label="Navigasi footer">
				{links.map((l) => <a href={l.href}>{l.label}</a>)}
			</nav>
			<p>&copy; {new Date().getFullYear()} Toko AL. Hak Cipta Dilindungi.</p>
		</div>
	</div>

	<div class="footer__strip">
		<div class="stripes stripes--on-green" aria-hidden="true"><span></span><span></span><span></span></div>
		<span># Bersepeda Itu Mudah</span>
	</div>
</footer>
