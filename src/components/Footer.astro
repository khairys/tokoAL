---
import Icon from "./Icon.astro";
import { Image } from "astro:assets";
import logoWhite from "../assets/branding/logo-white-tagline.png";
import { WA, SOCIALS } from "../lib/site";

const socials = [
	...SOCIALS.map((s) => ({ href: s.href, icon: s.icon, label: `${s.name} Toko AL` })),
	{ href: WA.general, icon: "brands:whatsapp", label: "WhatsApp Toko AL" },
];

const links = [
	{ href: "#home", label: "Beranda" },
	{ href: "#products", label: "Katalog" },
	{ href: "#services", label: "Layanan" },
	{ href: "#gallery", label: "Suasana Toko" },
	{ href: "#partners", label: "Merek & Komunitas" },
	{ href: "#contact", label: "Kontak" },
];
---

<footer class="footer">
	<div class="container">
		<div class="footer__top">
			<div class="footer__brand">
				<a href="#home">
					<Image src={logoWhite} width={420} alt="Logo Toko AL, Bersepeda Itu Mudah" />
				</a>
				<p>Toko Sepeda & Servis di Cikande Permai, Serang</p>
			</div>
			<div class="socials">
				{socials.map((s) => (
					<a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
						<Icon name={s.icon} />
					</a>
				))}
			</div>
		</div>

		<div class="footer__bottom">
			<nav class="footer__nav" aria-label="Navigasi footer">
				{links.map((l) => <a href={l.href}>{l.label}</a>)}
			</nav>
			<p>&copy; {new Date().getFullYear()} Toko AL. Hak Cipta Dilindungi.</p>
		</div>
	</div>
</footer>
