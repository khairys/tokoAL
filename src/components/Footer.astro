<section id="contact" class="bg-white pt-16 border-t border-gray-100">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
			
			<!-- Info Toko -->
			<div class="fade-in-up">
				<div class="flex items-center gap-2 mb-6">
					<div class="w-10 h-10 bg-gradient-to-br from-[#116530] to-primary rounded-full flex items-center justify-center text-white font-bold text-xl shadow-md">AL</div>
					<span class="font-bold text-2xl text-dark">Toko AL</span>
				</div>
				<p class="text-gray-500 mb-6">Partner terbaik untuk hobi bersepeda Anda. Melayani dengan hati dan profesionalitas tinggi.</p>
				
				<div class="space-y-3 text-gray-600">
					<div class="flex items-start gap-3">
						<i class="fas fa-map-marker-alt mt-1 text-primary"></i>
						<span>Jl. Cikande Permai No.6 Blok J2, Cikande Permai,<br>Kec. Cikande, Kabupaten Serang, Banten 42186</span>
					</div>
					<div class="flex items-start gap-3">
						<i class="fas fa-clock text-primary mt-1"></i>
						<div>
							<div>Senin - Sabtu: 09.00 - 20.00</div>
							<div>Minggu: 09.00 - 17.00</div>
						</div>
					</div>
					<div class="flex items-center gap-3">
						<i class="fas fa-phone text-primary"></i>
						<span>+62 819-9653-5525</span>
					</div>
				</div>

				<!-- Social Icons -->
				<div class="flex gap-4 mt-8">
                    <a href="https://www.instagram.com/tokoal_id" target="_blank" class="w-10 h-10 rounded-full bg-gray-100 text-gray-600 flex items-center justify-center hover:bg-gradient-to-br hover:from-purple-500 hover:via-pink-500 hover:to-orange-500 hover:text-white transition-all duration-200 hover:scale-110 hover:-translate-y-1 hover:shadow-lg hover:rotate-12"><i class="fab fa-instagram"></i></a>
					<a href="https://www.tiktok.com/@tokoal.id" target="_blank" class="w-10 h-10 rounded-full bg-gray-100 text-gray-600 flex items-center justify-center hover:bg-black hover:text-white transition-all duration-200 hover:scale-110 hover:-translate-y-1 hover:shadow-lg hover:-rotate-12 hover:animate-pulse"><i class="fab fa-tiktok"></i></a>
					<a href="https://www.facebook.com/admintokoalid" target="_blank" class="w-10 h-10 rounded-full bg-gray-100 text-gray-600 flex items-center justify-center hover:bg-blue-600 hover:text-white transition-all duration-200 hover:scale-110 hover:-translate-y-1 hover:shadow-lg hover:rotate-12"><i class="fab fa-facebook-f"></i></a>
					<a href="https://x.com/tokoal_id" target="_blank" class="w-10 h-10 rounded-full bg-gray-100 text-gray-600 flex items-center justify-center hover:bg-black hover:text-white transition-all duration-200 hover:scale-110 hover:-translate-y-1 hover:shadow-lg hover:rotate-12">
                        <svg xmlns="http://www.w3.org/2000/svg" height="16" width="16" viewBox="0 0 512 512" fill="currentColor">
                            <path d="M389.2 48h70.6L305.6 224.2 487 464H345L233.7 318.6 106.5 464H35.8L200.7 275.5 26.8 48H172.4L272.9 180.9 389.2 48zM364.4 421.8h39.1L151.1 88h-42L364.4 421.8z"/>
                        </svg>
                    </a>
				</div>
			</div>

			<!-- Map Embed -->
			<div class="lg:col-span-2 rounded-2xl overflow-hidden shadow-lg h-80 fade-in-up hover:shadow-2xl hover:shadow-primary/20 transition-all duration-200 hover:scale-105" style="transition-delay: 100ms;">
				<iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3966.121542874621!2d106.34663471463!3d-6.217914962436!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e42034cad66013f%3A0x172b9ecbe51c0c05!2sToko%20Sepeda%20AL!5e0!3m2!1sid!2sid!4v1735218000000!5m2!1sid!2sid" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" class="grayscale hover:grayscale-0 transition-all duration-300"></iframe>
			</div>
		</div>
