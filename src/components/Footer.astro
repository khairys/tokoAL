---
// Footer Component (Fluid Precision / Modern Apple Architecture)
import logoNavbar from '../assets/branding/Logo navbar.png';
---

<footer class="bg-zinc-950 text-zinc-400 border-t border-zinc-800/80 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
        
        <!-- Top Row: Brand & Navigation & Social -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-zinc-900">
            
            <!-- Brand Column (5 cols) -->
            <div class="md:col-span-5 space-y-4">
                <a href="#home" class="inline-flex items-center gap-3 group transition-transform active:scale-95 duration-150">
                    <img src={logoNavbar.src} alt="Logo Toko AL" class="h-9 w-auto object-contain drop-shadow-sm group-hover:scale-105 transition-transform" />
                    <span class="font-bold text-2xl tracking-tight text-white group-hover:text-emerald-400 transition-colors">Toko AL</span>
                </a>
                <p class="text-sm text-zinc-400 leading-relaxed max-w-sm">
                    Pusat penjualan sepeda, komponen sparepart orisinil terlengkap, dan bengkel servis teknis presisi di Cikande Permai, Serang, Banten.
                </p>
                <div class="inline-flex items-center gap-2 text-xs font-medium text-zinc-500 bg-zinc-900/80 px-3 py-1.5 rounded-full border border-zinc-800">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    <span>Jl. Cikande Permai Blok J2 No.6, Serang</span>
                </div>
            </div>

            <!-- Navigation Column (4 cols) -->
            <div class="md:col-span-4 space-y-3">
                <span class="text-xs font-semibold uppercase tracking-widest text-zinc-300">Navigasi Langsung</span>
                <ul class="grid grid-cols-2 gap-y-2.5 gap-x-4 text-sm font-medium">
                    <li><a href="#home" class="hover:text-emerald-400 transition-colors">Beranda</a></li>
                    <li><a href="#services" class="hover:text-emerald-400 transition-colors">Layanan</a></li>
                    <li><a href="#products" class="hover:text-emerald-400 transition-colors">Katalog Sepeda</a></li>
                    <li><a href="#gallery" class="hover:text-emerald-400 transition-colors">Suasana Toko</a></li>
                    <li><a href="#partners" class="hover:text-emerald-400 transition-colors">Merek & Komunitas</a></li>
                    <li><a href="#contact" class="hover:text-emerald-400 transition-colors">Kontak & Lokasi</a></li>
                </ul>
            </div>

            <!-- Social Media Column (3 cols) -->
            <div class="md:col-span-3 space-y-3 md:text-right">
                <span class="text-xs font-semibold uppercase tracking-widest text-zinc-300 block">Kanal Digital</span>
                <p class="text-xs text-zinc-500">Temukan dokumentasi servis dan update stok terbaru kami.</p>
                <div class="flex items-center md:justify-end gap-2.5 pt-1">
                    <a
                        href="https://www.instagram.com/tokoal_id"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Instagram Toko AL"
                        class="w-10 h-10 rounded-full bg-zinc-900 border border-zinc-800 text-zinc-400 flex items-center justify-center hover:text-white hover:border-pink-500/50 hover:bg-pink-500/10 transition-all duration-200 active:scale-90"
                        title="Instagram"
                    >
                        <i class="fab fa-instagram text-sm"></i>
                    </a>
                    <a
                        href="https://www.tiktok.com/@tokoal.id"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="TikTok Toko AL"
                        class="w-10 h-10 rounded-full bg-zinc-900 border border-zinc-800 text-zinc-400 flex items-center justify-center hover:text-white hover:border-zinc-500 hover:bg-zinc-800 transition-all duration-200 active:scale-90"
                        title="TikTok"
                    >
                        <i class="fab fa-tiktok text-sm"></i>
                    </a>
                    <a
                        href="https://www.youtube.com/@tokoal_id"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="YouTube Toko AL"
                        class="w-10 h-10 rounded-full bg-zinc-900 border border-zinc-800 text-zinc-400 flex items-center justify-center hover:text-white hover:border-red-500/50 hover:bg-red-500/10 transition-all duration-200 active:scale-90"
                        title="YouTube"
                    >
                        <i class="fab fa-youtube text-sm"></i>
                    </a>
                    <a
                        href="https://www.facebook.com/admintokoalid"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Facebook Toko AL"
                        class="w-10 h-10 rounded-full bg-zinc-900 border border-zinc-800 text-zinc-400 flex items-center justify-center hover:text-white hover:border-blue-500/50 hover:bg-blue-500/10 transition-all duration-200 active:scale-90"
                        title="Facebook"
                    >
                        <i class="fab fa-facebook-f text-sm"></i>
                    </a>
                </div>
            </div>

        </div>

        <!-- Bottom Row: Copyright & Precision Back to Top -->
        <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-500">
            <p>
                &copy; {new Date().getFullYear()} <span class="text-zinc-300 font-medium">Toko AL</span>. Hak Cipta Dilindungi. Dibuat dengan presisi.
            </p>
            <button
                id="back-to-top"
                type="button"
                aria-label="Kembali ke atas"
                class="inline-flex items-center gap-2 text-zinc-400 hover:text-white px-4 py-2 rounded-full bg-zinc-900 border border-zinc-800 hover:border-zinc-700 transition-all duration-150 active:scale-95 cursor-pointer shadow-sm group"
            >
                <span class="font-medium">Kembali ke Atas</span>
                <i class="fas fa-arrow-up text-xs text-emerald-400 group-hover:-translate-y-0.5 transition-transform"></i>
            </button>
        </div>

    </div>
</footer>

<script>
    const backToTopBtn = document.getElementById('back-to-top');
    backToTopBtn?.addEventListener('click', () => {
        window.scrollTo({
            top: 0,
            behavior: 'smooth'
        });
    });
</script>
