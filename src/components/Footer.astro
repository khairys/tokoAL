---
// Footer Component (Streamlined & Clean)
import logoNavbar from '../assets/branding/Logo navbar.png';
---

<!-- === CLEAN MINIMALIST FOOTER === -->
<footer class="bg-gray-950 text-gray-400 border-t border-gray-800/80 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        
        <!-- Main Footer Content -->
        <div class="flex flex-col md:flex-row items-center md:items-start justify-between gap-8 pb-10 border-b border-gray-800/60">
            
            <!-- Brand & Info -->
            <div class="text-center md:text-left max-w-md">
                <a href="#home" class="inline-flex items-center gap-3 group mb-3">
                    <img src={logoNavbar.src} alt="Logo Toko AL" class="h-9 w-auto object-contain drop-shadow-sm group-hover:scale-105 transition-transform" />
                    <span class="font-extrabold text-2xl tracking-wide text-white group-hover:text-primary transition-colors">Toko AL</span>
                </a>
                <p class="text-xs sm:text-sm text-gray-400 leading-relaxed">
                    Pusat penjualan sepeda, sparepart terlengkap, dan layanan bengkel servis profesional terpercaya di Cikande Permai, Serang, Banten.
                </p>
                <p class="text-xs text-gray-500 mt-2">
                    Jl. Cikande Permai Blok J2 No.6, Cikande, Serang.
                </p>
            </div>

            <!-- Quick Navigation -->
            <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-xs sm:text-sm font-medium">
                <a href="#home" class="hover:text-white transition-colors">Beranda</a>
                <a href="#services" class="hover:text-white transition-colors">Layanan</a>
                <a href="#products" class="hover:text-white transition-colors">Katalog</a>
                <a href="#gallery" class="hover:text-white transition-colors">Suasana Toko</a>
                <a href="#partners" class="hover:text-white transition-colors">Mitra & Komunitas</a>
                <a href="#contact" class="hover:text-white transition-colors">Kontak</a>
            </div>

            <!-- Social Media & Marketplace -->
            <div class="flex flex-col items-center md:items-end gap-3">
                <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Ikuti Kami</span>
                <div class="flex items-center gap-2">
                    <a
                        href="https://www.instagram.com/tokoal_id"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Instagram Toko AL"
                        class="w-9 h-9 rounded-full bg-gray-900 border border-gray-800 text-gray-400 flex items-center justify-center hover:text-white hover:border-pink-500 hover:bg-pink-500/20 transition-all duration-200 hover:scale-110 active:scale-95 shadow-sm"
                        title="Instagram"
                    >
                        <i class="fab fa-instagram text-sm"></i>
                    </a>
                    <a
                        href="https://www.tiktok.com/@tokoal.id"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="TikTok Toko AL"
                        class="w-9 h-9 rounded-full bg-gray-900 border border-gray-800 text-gray-400 flex items-center justify-center hover:text-white hover:border-gray-500 hover:bg-white/10 transition-all duration-200 hover:scale-110 active:scale-95 shadow-sm"
                        title="TikTok"
                    >
                        <i class="fab fa-tiktok text-sm"></i>
                    </a>
                    <a
                        href="https://www.youtube.com/@tokoal_id"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="YouTube Toko AL"
                        class="w-9 h-9 rounded-full bg-gray-900 border border-gray-800 text-gray-400 flex items-center justify-center hover:text-white hover:border-red-600 hover:bg-red-600/20 transition-all duration-200 hover:scale-110 active:scale-95 shadow-sm"
                        title="YouTube"
                    >
                        <i class="fab fa-youtube text-sm"></i>
                    </a>
                    <a
                        href="https://www.facebook.com/admintokoalid"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Facebook Toko AL"
                        class="w-9 h-9 rounded-full bg-gray-900 border border-gray-800 text-gray-400 flex items-center justify-center hover:text-white hover:border-blue-600 hover:bg-blue-600/20 transition-all duration-200 hover:scale-110 active:scale-95 shadow-sm"
                        title="Facebook"
                    >
                        <i class="fab fa-facebook-f text-sm"></i>
                    </a>
                </div>
            </div>

        </div>

        <!-- Bottom Copyright & Back to Top -->
        <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-500">
            <p>
                &copy; {new Date().getFullYear()} <span class="text-gray-300 font-medium">Toko AL</span>. Hak Cipta Dilindungi.
            </p>
            <button
                id="back-to-top"
                type="button"
                aria-label="Kembali ke atas"
                class="inline-flex items-center gap-2 text-gray-400 hover:text-white px-3.5 py-1.5 rounded-full bg-gray-900 border border-gray-800 hover:border-gray-700 transition-all duration-200 active:scale-95 cursor-pointer shadow-sm group"
            >
                <span>Kembali ke Atas</span>
                <i class="fas fa-arrow-up text-xs text-primary group-hover:-translate-y-0.5 transition-transform"></i>
            </button>
        </div>

    </div>
</footer>

<script>
    // Back to Top Button Logic
    const backToTopBtn = document.getElementById('back-to-top');
    backToTopBtn?.addEventListener('click', () => {
        window.scrollTo({
            top: 0,
            behavior: 'smooth'
        });
    });
</script>
