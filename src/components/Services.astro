---
const waUrl = "https://api.whatsapp.com/send?phone=6281996535525&text=Halo%20Toko%20AL";

const services = [
	{ icon: "fa-gauge-high", text: "Tune-Up Berkala, Setting RD/FD, & Rem" },
	{ icon: "fa-screwdriver-wrench", text: "Bongkar Pasang, Ganti Bearing, & Detailing" },
	{ icon: "fa-bicycle", text: "Rakit Sepeda Custom Sesuai Budget" },
	{ icon: "fa-comments", text: "Bisa konsultasi keluhan sepeda langsung di toko" },
];

const reasons = [
	"Servis bisa ditinggal",
	"Mekanik ramah dan enak diajak diskusi",
	"Pemasangan dan setting cepat, bisa ditunggu",
];
---

<section id="services" class="section service" aria-labelledby="services-title">
	<div class="stripes service__stripes" aria-hidden="true"><span></span><span></span><span></span></div>
	<div class="container">
		<div class="service__grid">
			<div class="service__intro">
				<h2 id="services-title">Servis & Upgrade</h2>
				<p>Tempat servis sepeda untuk perawatan rutin, perbaikan, hingga rakit custom.</p>
				<a href={waUrl} target="_blank" rel="noopener noreferrer" class="btn btn--light">
					<i class="fab fa-whatsapp" aria-hidden="true"></i>
					<span>Konsultasi Servis via WhatsApp</span>
				</a>
			</div>

			<ul class="service__list">
				{services.map((s) => (
					<li>
						<i class={`fas ${s.icon}`} aria-hidden="true"></i>
						<span>{s.text}</span>
					</li>
				))}
			</ul>
		</div>

		<div class="service__why">
			<h3>Kenapa Toko AL</h3>
			<ul>
				{reasons.map((r) => <li>{r}</li>)}
			</ul>
		</div>
	</div>
</section>
