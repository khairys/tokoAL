---
// Services Component
---

<section id="services" class="py-20 bg-white relative overflow-hidden">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
		<!-- Section Header -->
		<div class="text-center mb-14 fade-in-up">
			<h2
				class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight"
			>
				Semua Kebutuhan Gowes di Satu Tempat
			</h2>
			<div
				class="w-24 h-1.5 bg-gradient-to-r from-[#116530] via-primary to-secondary mx-auto mt-4 rounded-full"
			>
			</div>
			<p
				class="mt-4 text-gray-600 max-w-2xl mx-auto text-base sm:text-lg leading-relaxed"
			>
				Mulai dari sepeda keluarga dan keceriaan si kecil, suku cadang
				original, hingga perawatan bengkel oleh mekanik berpengalaman.
			</p>
		</div>

		<!-- 3 Core Pillars -->
		<div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch">
			<!-- Pillar 1: Sepeda & Mainan Anak -->
			<div
				class="bg-gray-50 rounded-3xl p-6 sm:p-8 hover:shadow-2xl hover:shadow-primary/15 transition-all duration-300 ease-out border border-gray-100 hover:border-secondary/40 group fade-in-up hover:scale-[1.02] hover:bg-white hover:-translate-y-2 flex flex-col justify-between"
			>
				<div>
					<div class="mb-6">
						<div
							class="w-14 h-14 bg-[#A3EBB1]/30 text-dark rounded-2xl flex items-center justify-center text-2xl group-hover:bg-gradient-to-br group-hover:from-primary group-hover:to-secondary group-hover:text-white transition-all duration-300 ease-out group-hover:scale-[1.05] group-hover:shadow-md group-hover:shadow-primary/30"
						>
							<i class="fas fa-bicycle"></i>
						</div>
					</div>
					<h3
						class="text-xl font-bold mb-3 text-gray-900 group-hover:text-dark transition-colors"
					>
						Sepeda & Mainan Anak
					</h3>
					<p class="text-gray-600 mb-6 text-sm leading-relaxed">
						Pilihan unit sepeda berkualitas untuk dewasa, remaja,
						hingga si kecil, plus aneka mainan seru yang aman dan
						edukatif.
					</p>
				</div>
				<ul
					class="text-sm text-gray-600 space-y-2.5 pt-4 border-t border-gray-100"
				>
					<li class="flex items-center gap-2.5">
						<i class="fas fa-check-circle text-primary"></i>
						<span>Sepeda Gunung (MTB), Lipat, & Mini</span>
					</li>
					<li class="flex items-center gap-2.5">
						<i class="fas fa-check-circle text-primary"></i>
						<span>Sepeda Anak, Push Bike, & Roda Tiga</span>
					</li>
					<li class="flex items-center gap-2.5">
						<i class="fas fa-check-circle text-primary"></i>
						<span>Mobil/Motor Mainan Aki & Edukatif</span>
					</li>
					<li class="flex items-center gap-2.5">
						<i class="fas fa-check-circle text-primary"></i>
						<span>Bisa Coba Unit & Setting di Lokasi</span>
					</li>
				</ul>
			</div>

			<!-- Pillar 2: Sparepart & Aksesoris -->
			<div
				class="bg-gray-50 rounded-3xl p-6 sm:p-8 hover:shadow-2xl hover:shadow-secondary/15 transition-all duration-300 ease-out border border-gray-100 hover:border-secondary/40 group fade-in-up hover:scale-[1.02] hover:bg-white hover:-translate-y-2 flex flex-col justify-between"
				style="transition-delay: 100ms;"
			>
				<div>
					<div class="mb-6">
						<div
							class="w-14 h-14 bg-secondary/20 text-secondary rounded-2xl flex items-center justify-center text-2xl group-hover:bg-gradient-to-br group-hover:from-secondary group-hover:to-primary group-hover:text-white transition-all duration-300 ease-out group-hover:scale-[1.05] group-hover:shadow-md group-hover:shadow-secondary/30"
						>
							<i class="fas fa-cogs"></i>
						</div>
					</div>
					<h3
						class="text-xl font-bold mb-3 text-gray-900 group-hover:text-dark transition-colors"
					>
						Sparepart & Aksesoris
					</h3>
					<p class="text-gray-600 mb-6 text-sm leading-relaxed">
						Suku cadang asli dan perlengkapan gowes lengkap untuk
						menjaga kenyamanan, keamanan, serta mendongkrak performa
						sepeda Anda.
					</p>
				</div>
				<ul
					class="text-sm text-gray-600 space-y-2.5 pt-4 border-t border-gray-100"
				>
					<li class="flex items-center gap-2.5">
						<i class="fas fa-check-circle text-secondary"></i>
						<span>Groupset, Rantai, Sprocket, & Rem</span>
					</li>
					<li class="flex items-center gap-2.5">
						<i class="fas fa-check-circle text-secondary"></i>
						<span>Ban Luar & Dalam Segala Ukuran</span>
					</li>
					<li class="flex items-center gap-2.5">
						<i class="fas fa-check-circle text-secondary"></i>
						<span>Helm SNI, Lampu LED, & Kunci Pengaman</span>
					</li>
					<li class="flex items-center gap-2.5">
						<i class="fas fa-check-circle text-secondary"></i>
						<span>Jersey, Sarung Tangan, & Aksesoris</span>
					</li>
				</ul>
			</div>

			<!-- Pillar 3: Servis & Upgrade -->
			<div
				class="bg-gray-50 rounded-3xl p-6 sm:p-8 hover:shadow-2xl hover:shadow-primary/15 transition-all duration-300 ease-out border border-gray-100 hover:border-secondary/40 group fade-in-up hover:scale-[1.02] hover:bg-white hover:-translate-y-2 flex flex-col justify-between"
				style="transition-delay: 200ms;"
			>
				<div>
					<div class="mb-6">
						<div
							class="w-14 h-14 bg-primary/20 text-primary rounded-2xl flex items-center justify-center text-2xl group-hover:bg-gradient-to-br group-hover:from-primary group-hover:to-secondary group-hover:text-white transition-all duration-300 ease-out group-hover:scale-[1.05] group-hover:shadow-md group-hover:shadow-primary/30"
						>
							<i class="fas fa-wrench"></i>
						</div>
					</div>
					<h3
						class="text-xl font-bold mb-3 text-gray-900 group-hover:text-dark transition-colors"
					>
						Servis & Upgrade
					</h3>
					<p class="text-gray-600 mb-6 text-sm leading-relaxed">
						Bengkel resmi dengan mekanik andal yang siap menangani
						perawatan rutin, perbaikan presisi, hingga rakit custom
						dari nol.
					</p>
				</div>
				<ul
					class="text-sm text-gray-600 space-y-2.5 pt-4 border-t border-gray-100"
				>
					<li class="flex items-center gap-2.5">
						<i class="fas fa-check-circle text-primary"></i>
						<span>Tune-Up Berkala, Setting RD/FD, & Rem</span>
					</li>
					<li class="flex items-center gap-2.5">
						<i class="fas fa-check-circle text-primary"></i>
						<span>Bongkar Pasang, Ganti Bearing, & Detailing</span>
					</li>
					<li class="flex items-center gap-2.5">
						<i class="fas fa-check-circle text-primary"></i>
						<span>Rakit Sepeda Custom Sesuai Budget</span>
					</li>
					<li class="flex items-center gap-2.5">
						<i class="fas fa-check-circle text-primary"></i>
						<span>Konsultasi Keluhan Sepeda Gratis</span>
					</li>
				</ul>
			</div>
		</div>
	</div>
</section>
