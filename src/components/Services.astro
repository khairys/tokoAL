---
// Services Component
---

<section id="services" class="py-16 bg-white">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="text-center mb-12 fade-in-up">
			<h2 class="text-3xl font-bold text-gray-900">Layanan Bengkel</h2>
			<div class="w-20 h-1 bg-gradient-to-r from-primary to-secondary mx-auto mt-4 rounded-full"></div>
			<p class="mt-4 text-gray-600">Percayakan perawatan sepeda Anda pada mekanik berpengalaman kami.</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
			<!-- Service 1 -->
			<div class="bg-gray-50 rounded-2xl p-8 hover:shadow-2xl transition-all duration-200 border border-gray-100 hover:border-secondary/30 group fade-in-up hover:scale-105 hover:bg-white hover:z-10 hover:-translate-y-2">
				<div class="w-14 h-14 bg-[#A3EBB1]/30 text-dark rounded-xl flex items-center justify-center text-2xl mb-6 group-hover:bg-gradient-to-br group-hover:from-primary group-hover:to-secondary group-hover:text-white transition-all duration-300 group-hover:scale-110 group-hover:rotate-6 group-hover:shadow-md group-hover:shadow-primary/30">
					<i class="fas fa-wrench group-hover:animate-pulse"></i>
				</div>
				<h3 class="text-xl font-bold mb-3 text-gray-900 group-hover:text-dark transition-colors">Servis Ringan & Berat</h3>
				<p class="text-gray-600 mb-4 text-sm leading-relaxed">Penyetelan rem, operan gigi, pelumasan rantai, hingga bongkar pasang total untuk performa maksimal.</p>
				<ul class="text-sm text-gray-500 space-y-2">
					<li class="flex items-center gap-2"><i class="fas fa-check text-primary"></i> Tune-up Berkala</li>
					<li class="flex items-center gap-2"><i class="fas fa-check text-primary"></i> Ganti Kampas Rem</li>
				</ul>
			</div>

			<!-- Service 2 -->
			<div class="bg-gray-50 rounded-2xl p-8 hover:shadow-2xl transition-all duration-200 border border-gray-100 hover:border-secondary/30 group fade-in-up hover:scale-105 hover:bg-white hover:z-10 hover:-translate-y-2" style="transition-delay: 100ms;">
				<div class="w-14 h-14 bg-[#A3EBB1]/30 text-dark rounded-xl flex items-center justify-center text-2xl mb-6 group-hover:bg-gradient-to-br group-hover:from-primary group-hover:to-secondary group-hover:text-white transition-all duration-300 group-hover:scale-110 group-hover:rotate-12 group-hover:shadow-md group-hover:shadow-primary/30">
					<i class="fas fa-cogs group-hover:animate-spin"></i>
				</div>
				<h3 class="text-xl font-bold mb-3 text-gray-900 group-hover:text-dark transition-colors">Rakit & Upgrade</h3>
				<p class="text-gray-600 mb-4 text-sm leading-relaxed">Ingin sepeda custom? Kami melayani perakitan dari nol atau upgrade sparepart untuk spesifikasi lebih tinggi.</p>
				<ul class="text-sm text-gray-500 space-y-2">
					<li class="flex items-center gap-2"><i class="fas fa-check text-primary"></i> Rakit Full Bike</li>
					<li class="flex items-center gap-2"><i class="fas fa-check text-primary"></i> Upgrade Groupset</li>
				</ul>
			</div>

			<!-- Service 3 -->
			<div class="bg-gray-50 rounded-2xl p-8 hover:shadow-2xl transition-all duration-200 border border-gray-100 hover:border-secondary/30 group fade-in-up hover:scale-105 hover:bg-white hover:z-10 hover:-translate-y-2" style="transition-delay: 200ms;">
				<div class="w-14 h-14 bg-[#A3EBB1]/30 text-dark rounded-xl flex items-center justify-center text-2xl mb-6 group-hover:bg-gradient-to-br group-hover:from-primary group-hover:to-secondary group-hover:text-white transition-all duration-300 group-hover:scale-110 group-hover:-rotate-6 group-hover:shadow-md group-hover:shadow-primary/30">
					<i class="fas fa-pump-soap group-hover:animate-bounce"></i>
				</div>
				<h3 class="text-xl font-bold mb-3 text-gray-900 group-hover:text-dark transition-colors">Cuci & Detailing</h3>
				<p class="text-gray-600 mb-4 text-sm leading-relaxed">Kembalikan kilau sepeda Anda seperti baru. Membersihkan kerak oli membandel di area yang sulit dijangkau.</p>
				<ul class="text-sm text-gray-500 space-y-2">
					<li class="flex items-center gap-2"><i class="fas fa-check text-primary"></i> Bike Wash</li>
					<li class="flex items-center gap-2"><i class="fas fa-check text-primary"></i> Poles Body</li>
				</ul>
			</div>
		</div>
	</div>
</section>
