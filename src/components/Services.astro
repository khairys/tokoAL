---
import Icon from "./Icon.astro";
import { Image } from "astro:assets";
import serviceImg from "../assets/gallery/Custom.png";
import Eyebrow from "./Eyebrow.astro";

import { WA } from "../lib/site";

const waUrl = WA.service;

const services = [
	{ icon: "gauge-high", text: "Tune-Up Berkala, Setting RD/FD, & Rem" },
	{ icon: "screwdriver-wrench", text: "Bongkar Pasang, Ganti Bearing, & Detailing" },
	{ icon: "bicycle", text: "Rakit Sepeda Custom Sesuai Budget" },
	{ icon: "comments", text: "Bisa konsultasi keluhan sepeda langsung di toko" },
];

---

<section id="services" class="section section--cut service" aria-labelledby="services-title">
	<div class="stripes service__stripes" aria-hidden="true"><span></span><span></span><span></span></div>
	<div class="container">
		<div class="service__grid">
			<div class="service__intro">
				<div data-reveal="up">
					<Eyebrow label="Layanan" light />
					<h2 id="services-title">Servis & Upgrade</h2>
					<p>Tempat servis sepeda untuk perawatan rutin, perbaikan, hingga rakit custom.</p>
					<a href={waUrl} target="_blank" rel="noopener noreferrer" class="btn btn--light">
						<Icon name="brands:whatsapp" />
						<span>Konsultasi Servis via WhatsApp</span>
					</a>
				</div>
				<div class="service__photo" data-reveal="wipe">
					<div class="service__photo-cut" data-parallax="0.05">
						<Image
							src={serviceImg}
							widths={[480, 800, 1000]}
							sizes="(min-width: 900px) 460px, 92vw"
							alt="Mekanik Toko AL merakit sepeda"
						/>
					</div>
				</div>
			</div>

			<ul class="service__list" data-reveal="stagger">
				{services.map((s, i) => (
					<li style={`--i: ${i}`}>
						<span>{s.text}</span>
						<span class="service__ico" aria-hidden="true"><Icon name={`solid:${s.icon}`} /></span>
					</li>
				))}
			</ul>
		</div>

	</div>
</section>
