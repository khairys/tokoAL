---
// Running brand strip, styled after the green strip in the social media templates.
// Decorative only: the tagline is already the page headline, so screen readers skip it.
// Runs only when motion is allowed (html.js is not set for reduced motion).
interface Props {
	text?: string;
}
const { text = "# Bersepeda Itu Mudah" } = Astro.props;
const items = Array.from({ length: 6 }, () => text);
---

<div class="marquee" aria-hidden="true">
	<div class="marquee__viewport">
		<div class="marquee__track">
			{[0, 1].map(() => (
				<div class="marquee__group">
					{items.map((t) => (
						<span class="marquee__item">
							<span class="marquee__mark"><i></i><i></i><i></i></span>
							{t}
						</span>
					))}
				</div>
			))}
		</div>
	</div>
</div>
