---
// Products Component
import productFixie from '../assets/products/sepeda fixie.png';
import productMtb from '../assets/products/MTB.jpg';
import productBmx from '../assets/products/sepeda bmx.jpg';
import productFolding from '../assets/products/sepedaLipat.jpg';
import productAnak from '../assets/products/sepeda anak.jpg';
import productSparepart from '../assets/products/sparepart.jpg';
import productAksesoris from '../assets/products/aksesoris.png';

const catalogUrl = "https://wa.me/c/21908728856695";

const products = [
    {
        id: 'fixie',
        title: 'Sepeda Fixie, Balap, Gravel & Hybrid',
        category: 'Road & Urban',
        image: productFixie,
        link: 'https://wa.me/p/8388943097813259/21908728856695',
        badge: 'Banyak Pilihan',
        desc: 'Pilihan kecepatan fleksibel dengan geometri balap responsif dan desain modern.',
    },
    {
        id: 'mtb',
        title: 'Sepeda Gunung (MTB) Serbaguna',
        category: 'Mountain Bike',
        image: productMtb,
        link: 'https://wa.me/p/8388943097813259/21908728856695',
        badge: 'Ready Stock',
        desc: 'Suspensi empuk dan groupset presisi untuk medan tanah, bebatuan, maupun aspal.',
    },
    {
        id: 'bmx',
        title: 'Sepeda BMX Freestyle & Street',
        category: 'Freestyle',
        image: productBmx,
        link: 'https://wa.me/p/6901147263339387/21908728856695',
        badge: 'Best Seller',
        desc: 'Rangka alloy & steel ekstra kokoh untuk aksi street tricks serta gowes harian.',
    },
    {
        id: 'folding',
        title: 'Sepeda Lipat (Folding Bike)',
        category: 'Commuter',
        image: productFolding,
        link: 'https://wa.me/p/7373130436045125/21908728856695',
        badge: 'Ringkas & Praktis',
        desc: 'Praktis dilipat, mudah dibawa masuk mobil atau transportasi umum, hemat ruang.',
    },
    {
        id: 'anak',
        title: 'Sepeda & Mainan Edukatif Anak',
        category: 'Keluarga & Balita',
        image: productAnak,
        link: catalogUrl,
        badge: 'Koleksi Anak',
        desc: 'Pilihan roda tiga, roda bantu, dan push bike yang aman serta ergonomis untuk si kecil.',
    },
    {
        id: 'sparepart',
        title: 'Sparepart & Komponen Original',
        category: 'Suku Cadang',
        image: productSparepart,
        link: catalogUrl,
        badge: '100% Original',
        desc: 'Drivetrain, rantai, ban luar-dalam, hingga pengereman dari berbagai merek teruji.',
    },
    {
        id: 'aksesoris',
        title: 'Aksesoris & Perlengkapan Safety',
        category: 'Safety & Style',
        image: productAksesoris,
        link: catalogUrl,
        badge: 'Safety Gear',
        desc: 'Helm standar SNI, lampu LED terang, pompa portabel, tas frame, dan botol minum.',
    },
];
---

<!-- === PRODUCT & MARKETPLACE SECTION === -->
<section id="products" class="py-20 bg-white border-t border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Header -->
        <div class="text-center mb-12 fade-in-up">
            <span class="text-xs font-bold uppercase tracking-wider text-[#116530] bg-emerald-100/60 border border-emerald-200/50 px-3.5 py-1 rounded-full inline-block mb-3">
                Katalog Pilihan
            </span>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight">Koleksi Produk & Sepeda Unggulan</h2>
            <p class="mt-3.5 text-gray-600 max-w-2xl mx-auto text-base sm:text-lg leading-relaxed">
                Pilih kategori favorit Anda dan klik kartu untuk menanyakan ketersediaan unit terbaru langsung ke admin WhatsApp.
            </p>
        </div>

        <!-- Carousel Container with Navigation Buttons -->
        <div class="relative group/carousel fade-in-up">
            <!-- Navigation Buttons -->
            <button
                id="scroll-left"
                aria-label="Geser ke kiri"
                class="absolute left-0 top-1/2 -translate-y-1/2 z-20 w-11 h-11 bg-white hover:bg-emerald-50 text-gray-700 hover:text-primary rounded-full shadow-lg border border-gray-200 flex items-center justify-center transition-all opacity-80 sm:opacity-0 group-hover/carousel:opacity-100 cursor-pointer active:scale-95"
            >
                <i class="fas fa-chevron-left text-sm"></i>
            </button>
            <button
                id="scroll-right"
                aria-label="Geser ke kanan"
                class="absolute right-0 top-1/2 -translate-y-1/2 z-20 w-11 h-11 bg-white hover:bg-emerald-50 text-gray-700 hover:text-primary rounded-full shadow-lg border border-gray-200 flex items-center justify-center transition-all opacity-80 sm:opacity-0 group-hover/carousel:opacity-100 cursor-pointer active:scale-95"
            >
                <i class="fas fa-chevron-right text-sm"></i>
            </button>

            <!-- Product Cards Container -->
            <div
                id="product-container"
                class="flex gap-6 overflow-x-auto hide-scroll snap-x snap-mandatory py-4 px-1"
            >
                {products.map((product) => (
                    <a
                        href={product.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group/card min-w-[280px] sm:min-w-[310px] md:min-w-[320px] max-w-[340px] bg-white rounded-2xl p-5 snap-center border border-gray-200/80 hover:border-emerald-300 hover:shadow-lg transition-all duration-200 flex flex-col justify-between cursor-pointer"
                    >
                        <div>
                            <!-- Product Image & Badge -->
                            <div class="relative aspect-[4/3] rounded-xl overflow-hidden mb-4 bg-gray-50 border border-gray-100 flex items-center justify-center">
                                <img
                                    src={product.image.src}
                                    alt={product.title}
                                    class="w-full h-full object-cover group-hover/card:scale-105 transition-transform duration-500"
                                    loading="lazy"
                                />
                                <div class="absolute top-2.5 right-2.5 text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-white/90 text-gray-800 shadow-sm border border-gray-200/60 backdrop-blur-sm">
                                    {product.badge}
                                </div>
                                <div class="absolute bottom-2 left-2 bg-gray-900/70 backdrop-blur-sm text-[10px] font-medium text-white px-2 py-0.5 rounded">
                                    {product.category}
                                </div>
                            </div>

                            <!-- Title -->
                            <h3 class="text-base sm:text-lg font-bold mb-2 text-gray-900 group-hover/card:text-[#116530] transition-colors leading-snug">
                                {product.title}
                            </h3>

                            <!-- Short Description -->
                            <p class="text-xs text-gray-500 leading-relaxed mb-4">
                                {product.desc}
                            </p>
                        </div>

                        <!-- Card Action Footer -->
                        <div class="pt-3.5 border-t border-gray-100 flex items-center justify-between text-xs font-semibold text-primary group-hover/card:text-[#116530] transition-colors">
                            <span class="inline-flex items-center gap-1.5">
                                <i class="fab fa-whatsapp text-sm"></i>
                                <span>Tanya Detail Unit</span>
                            </span>
                            <i class="fas fa-arrow-right text-[11px] group-hover/card:translate-x-1 transition-transform"></i>
                        </div>
                    </a>
                ))}
            </div>
        </div>

        <!-- WhatsApp Full Catalog Button -->
        <div class="mt-8 text-center fade-in-up">
            <a
                href={catalogUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-emerald-50 hover:bg-emerald-100 text-[#116530] border border-emerald-200/60 font-semibold text-sm rounded-full transition-all duration-200 cursor-pointer"
            >
                <i class="fab fa-whatsapp text-lg"></i>
                <span>Buka Katalog Lengkap di WhatsApp</span>
                <i class="fas fa-arrow-right text-xs"></i>
            </a>
        </div>

        <!-- Clean Official Marketplace Card -->
        <div class="mt-14 fade-in-up" style="transition-delay: 100ms;">
            <div class="bg-gradient-to-br from-gray-50 to-emerald-50/30 rounded-2xl p-8 border border-gray-200/80 text-center max-w-4xl mx-auto">
                <span class="text-xs font-bold uppercase tracking-wider text-[#116530] bg-white border border-emerald-200/50 px-3 py-1 rounded-full inline-block mb-3">
                    Belanja Online
                </span>
                <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mb-2">Official Store Marketplace</h3>
                <p class="text-gray-600 text-sm max-w-lg mx-auto mb-6">Nikmati kemudahan transaksi aman, promo bebas ongkir, dan jaminan 100% produk asli di toko resmi kami.</p>
                
                <div class="flex flex-col sm:flex-row justify-center gap-3.5">
                    <a
                        href="https://shopee.co.id/tokoal_id"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="px-6 py-3 bg-[#EE4D2D] hover:bg-[#d83f20] text-white font-semibold text-sm rounded-xl flex items-center justify-center gap-2 shadow-sm transition-all"
                    >
                        <i class="fas fa-shopping-bag"></i>
                        <span>Kunjungi Shopee</span>
                        <i class="fas fa-arrow-right text-xs"></i>
                    </a>
                    <a
                        href="https://www.tokopedia.com/tokoal-id"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="px-6 py-3 bg-[#42B549] hover:bg-[#389e3e] text-white font-semibold text-sm rounded-xl flex items-center justify-center gap-2 shadow-sm transition-all"
                    >
                        <i class="fas fa-store"></i>
                        <span>Kunjungi Tokopedia</span>
                        <i class="fas fa-arrow-right text-xs"></i>
                    </a>
                </div>
            </div>
        </div>

    </div>
</section>

<script>
    // Product Carousel Logic
    const scrollLeftBtn = document.getElementById('scroll-left');
    const scrollRightBtn = document.getElementById('scroll-right');
    const productContainer = document.getElementById('product-container');
    
    if (scrollLeftBtn && productContainer) {
        scrollLeftBtn.addEventListener('click', () => {
            productContainer.scrollBy({ left: -340, behavior: 'smooth' });
        });
    }
    
    if (scrollRightBtn && productContainer) {
        scrollRightBtn.addEventListener('click', () => {
            productContainer.scrollBy({ left: 340, behavior: 'smooth' });
        });
    }
</script>
