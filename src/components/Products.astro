---
// Products Component - Fluid Precision Prototype
import productFixie from '../assets/products/sepeda fixie.png';
import productMtb from '../assets/products/MTB.jpg';
import productBmx from '../assets/products/sepeda bmx.jpg';
import productFolding from '../assets/products/sepedaLipat.jpg';
import productAnak from '../assets/products/sepeda anak.jpg';
import productSparepart from '../assets/products/sparepart.jpg';
import productAksesoris from '../assets/products/aksesoris.png';

const catalogUrl = "https://wa.me/c/21908728856695";

const products = [
    {
        id: 'fixie',
        title: 'Sepeda Fixie dan Roadbike',
        category: 'Balap & Urban',
        image: productFixie,
        link: 'https://wa.me/p/8388943097813259/21908728856695',
        specs: [
            '2x7, 2x8, hingga 2x9 Speed Balap',
            'Rem U-Brake, Cakram, atau Torpedo',
            'Pilihan Stang Dropbar & Flatbar',
            'Bearing Presisi & Frame Ringan',
        ]
    },
    {
        id: 'mtb',
        title: 'Sepeda MTB',
        category: 'Mountain Bike',
        image: productMtb,
        link: 'https://wa.me/p/8388943097813259/21908728856695',
        specs: [
            'Ukuran Roda 24", 26", & 27.5" Inci',
            'Groupset Shimano & Komponen Teruji',
            'Rem Cakram Mekanik & Hidrolik',
            'Frame Alloy Kokoh Siap Jalur Tanah',
        ]
    },
    {
        id: 'bmx',
        title: 'Sepeda BMX',
        category: 'Freestyle & Street',
        image: productBmx,
        link: 'https://wa.me/p/6901147263339387/21908728856695',
        specs: [
            'Frame Steel Kokoh Ekstra Tebal',
            'Pilihan Ban Jumbo 3.0 & Standar 2.4',
            'Stang Rotor 360° & Jalu Pijakan',
            'Ideal untuk Hobi Tricks & Freestyle',
        ]
    },
    {
        id: 'folding',
        title: 'Sepeda Lipat',
        category: 'Commuter & Praktis',
        image: productFolding,
        link: 'https://wa.me/p/7373130436045125/21908728856695',
        specs: [
            'Lipatan Ringkas Praktis Masuk Mobil/KRL',
            'Pilihan 1 Speed hingga 7 Speed Nyaman',
            'Frame Ringan dengan Kunci Lipatan Kokoh',
            'Cocok untuk Gowes Santai & Komuter',
        ]
    },
    {
        id: 'anak',
        title: 'Sepeda Anak',
        category: 'Keluarga & Balita',
        image: productAnak,
        link: catalogUrl,
        specs: [
            'Usia 2 Tahun hingga 8 Tahun',
            'Roda Tiga, Roda Bantu, & Push Bike',
            'Pilihan Warna & Karakter Kartun Ceria',
            'Disetel Aman & Siap Pakai Langsung',
        ]
    },
    {
        id: 'sparepart',
        title: 'Sparepart Sepeda',
        category: 'Suku Cadang & Komponen',
        image: productSparepart,
        link: catalogUrl,
        specs: [
            'RD, FD, Rantai, Sprocket, & Shifter',
            'Ban Luar & Dalam Segala Ukuran',
            'Rotor Cakram, Kampas Rem, & Bearing',
            'Tersedia Jasa Pasang di Bengkel',
        ]
    },
    {
        id: 'aksesoris',
        title: 'Aksesoris Sepeda',
        category: 'Perlengkapan & Safety',
        image: productAksesoris,
        link: catalogUrl,
        specs: [
            'Helm SNI & Lampu LED Terang',
            'Kunci Pengaman & Bel Nyaring',
            'Tas Sepeda, Pompa, & Botol Minum',
            'Perlengkapan Gowes Aman Lengkap',
        ]
    }
];

const loopProducts = [...products, ...products, ...products];
---

<section id="products" class="py-24 bg-white border-b border-zinc-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
            <div>
                <span class="text-xs font-bold uppercase tracking-widest text-emerald-600 block mb-2">
                    Katalog Resmi Unit & Part
                </span>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-zinc-950 tracking-tight">
                    Etalase Sepeda Pilihan Toko AL
                </h2>
                <p class="text-zinc-600 text-sm sm:text-base mt-2">
                    Semua unit sepeda ready stock dan disetel presisi oleh mekanik sebelum diserahkan kepada Anda.
                </p>
            </div>

            <!-- Precision Chevron Controls -->
            <div class="flex items-center gap-2">
                <button
                    id="prec-prev"
                    aria-label="Geser ke kiri"
                    class="w-10 h-10 rounded-full bg-zinc-100 hover:bg-zinc-200 text-zinc-800 transition-all flex items-center justify-center active:scale-90"
                >
                    <i class="fas fa-chevron-left text-xs"></i>
                </button>
                <button
                    id="prec-next"
                    aria-label="Geser ke kanan"
                    class="w-10 h-10 rounded-full bg-zinc-100 hover:bg-zinc-200 text-zinc-800 transition-all flex items-center justify-center active:scale-90"
                >
                    <i class="fas fa-chevron-right text-xs"></i>
                </button>
            </div>
        </div>

        <!-- Carousel Reel -->
        <div
            id="prec-carousel"
            class="flex gap-5 overflow-x-auto hide-scroll py-2 px-1 cursor-grab active:cursor-grabbing scroll-smooth"
        >
            {loopProducts.map((p) => (
                <div class="w-[290px] sm:w-[320px] flex-shrink-0 bg-zinc-50 rounded-3xl p-5 border border-zinc-200/80 hover:border-emerald-500/60 transition-all duration-200 hover:-translate-y-1 hover:shadow-md flex flex-col justify-between group">
                    <div>
                        <!-- Product Image -->
                        <div class="aspect-[4/3] rounded-2xl overflow-hidden mb-4 bg-white border border-zinc-200/60 flex items-center justify-center">
                            <img
                                src={p.image.src}
                                alt={p.title}
                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                loading="lazy"
                            />
                        </div>

                        <span class="text-[10px] font-bold text-emerald-700 uppercase tracking-wider block mb-1">
                            {p.category}
                        </span>
                        <h3 class="text-base sm:text-lg font-bold text-zinc-950 group-hover:text-emerald-700 transition-colors mb-3 leading-snug">
                            {p.title}
                        </h3>

                        <ul class="space-y-1.5 text-xs text-zinc-600 mb-5">
                            {p.specs.map(s => (
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-emerald-600 text-[10px] mt-0.5 flex-shrink-0"></i>
                                    <span>{s}</span>
                                </li>
                            ))}
                        </ul>
                    </div>

                    <a
                        href={p.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="pt-3 border-t border-zinc-200/80 flex items-center justify-between text-xs font-bold text-zinc-800 hover:text-emerald-700 active:scale-95 transition-all group/btn"
                    >
                        <span>Tertarik? Cek Ketersediaan Unit</span>
                        <i class="fas fa-arrow-right text-[10px] text-emerald-600 group-hover/btn:translate-x-1 transition-transform"></i>
                    </a>
                </div>
            ))}
        </div>

        <!-- Big Catalog Button -->
        <div class="mt-12 text-center">
            <a
                href={catalogUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-3 px-8 py-4 bg-zinc-950 hover:bg-emerald-700 text-white font-bold text-sm sm:text-base rounded-full shadow-lg active:scale-95 transition-all"
            >
                <span>Selengkapnya</span>
                <i class="fas fa-arrow-right text-xs"></i>
            </a>
        </div>

        <!-- Marketplace Official Channels -->
        <div class="mt-16 pt-10 border-t border-zinc-200/80 flex flex-col md:flex-row items-center justify-between gap-6">
            <div>
                <h4 class="text-base font-bold text-zinc-950">Siap Untuk Berbelanja Online?</h4>
                <p class="text-xs text-zinc-500 mt-0.5">Kunjungi Official Store Toko AL di platform marketplace terpercaya</p>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <a
                    href="https://shopee.co.id/tokoal_id"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-5 py-2.5 rounded-full text-xs font-bold bg-[#EE4D2D]/10 hover:bg-[#EE4D2D] text-[#EE4D2D] hover:text-white border border-[#EE4D2D]/30 transition-all flex items-center gap-2 active:scale-95"
                >
                    <i class="fas fa-shopping-bag"></i>
                    <span>Shopee Official</span>
                </a>
                <a
                    href="https://www.tokopedia.com/tokoal-id"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-5 py-2.5 rounded-full text-xs font-bold bg-[#42B549]/10 hover:bg-[#42B549] text-[#42B549] hover:text-white border border-[#42B549]/30 transition-all flex items-center gap-2 active:scale-95"
                >
                    <i class="fas fa-store"></i>
                    <span>Tokopedia Official</span>
                </a>
                <a
                    href={catalogUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-5 py-2.5 rounded-full text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white transition-all flex items-center gap-2 active:scale-95"
                >
                    <i class="fab fa-whatsapp"></i>
                    <span>Katalog WhatsApp</span>
                </a>
            </div>
        </div>

    </div>
</section>

<script>
    const reel = document.getElementById('prec-carousel');
    const pPrev = document.getElementById('prec-prev');
    const pNext = document.getElementById('prec-next');

    if (reel) {
        setTimeout(() => {
            reel.scrollLeft = 340 * 7;
        }, 100);

        pPrev?.addEventListener('click', () => {
            reel.scrollBy({ left: -340, behavior: 'smooth' });
        });

        pNext?.addEventListener('click', () => {
            reel.scrollBy({ left: 340, behavior: 'smooth' });
        });
    }
</script>
