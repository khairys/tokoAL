---

<!-- === PRODUCT & MARKETPLACE SECTION === -->
<section id="products" class="py-20 bg-gray-900 text-white relative overflow-hidden">
    
    <!-- Background Decoration -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-secondary/15 rounded-full filter blur-[120px]"></div>
    <div class="absolute bottom-0 left-0 w-80 h-80 bg-primary/20 rounded-full filter blur-[100px]"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        <!-- Header -->
        <div class="text-center mb-12 fade-in-up">
            <span class="text-neon font-bold tracking-wider uppercase text-sm inline-flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-neon animate-pulse"></span>
                Etalase Digital
            </span>
            <h2 class="text-3xl md:text-4xl font-bold mb-4 mt-2">Koleksi Produk & Sepeda</h2>
            <div class="w-24 h-1.5 bg-gradient-to-r from-primary via-secondary to-neon mx-auto rounded-full"></div>
            <p class="mt-4 text-gray-400 max-w-2xl mx-auto text-base sm:text-lg leading-relaxed">
                Pilih kategori favorit Anda di bawah ini dan klik pada kartu untuk langsung melihat detail unit serta konsultasi ketersediaan di WhatsApp.
            </p>
        </div>

        <!-- Carousel Container with Navigation Buttons -->
        <div class="relative group/carousel fade-in-up">
            <!-- Navigation Buttons -->
            <button
                id="scroll-left"
                aria-label="Geser ke kiri"
                class="absolute left-1 top-1/2 -translate-y-1/2 z-20 w-12 h-12 bg-gray-800/90 hover:bg-primary text-white rounded-full shadow-2xl border border-gray-700 flex items-center justify-center transition-all duration-200 opacity-90 sm:opacity-0 group-hover/carousel:opacity-100 cursor-pointer active:scale-90"
            >
                <i class="fas fa-chevron-left text-lg"></i>
            </button>
            <button
                id="scroll-right"
                aria-label="Geser ke kanan"
                class="absolute right-1 top-1/2 -translate-y-1/2 z-20 w-12 h-12 bg-gray-800/90 hover:bg-primary text-white rounded-full shadow-2xl border border-gray-700 flex items-center justify-center transition-all duration-200 opacity-90 sm:opacity-0 group-hover/carousel:opacity-100 cursor-pointer active:scale-90"
            >
                <i class="fas fa-chevron-right text-lg"></i>
            </button>

            <!-- Product Cards Container -->
            <div
                id="product-container"
                class="flex gap-6 overflow-x-auto hide-scroll snap-x snap-mandatory py-6 px-2 sm:px-6"
            >
                {products.map((product) => (
                    <a
                        href={product.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group/card min-w-[290px] sm:min-w-[320px] md:min-w-[340px] max-w-[360px] bg-gray-800/60 backdrop-blur-md rounded-2xl p-5 snap-center border border-gray-700/80 hover:border-secondary/70 transition-all duration-300 hover:shadow-2xl hover:shadow-primary/20 hover:-translate-y-2 flex flex-col justify-between active:scale-[0.98] cursor-pointer"
                    >
                        <div>
                            <!-- Product Image & Badge -->
                            <div class="relative aspect-[4/3] rounded-xl overflow-hidden mb-4 bg-gray-950 border border-gray-700/50 flex items-center justify-center">
                                <img
                                    src={product.image.src}
                                    alt={product.title}
                                    class="w-full h-full object-cover group-hover/card:scale-108 group-hover/card:rotate-1 transition-all duration-500"
                                    loading="lazy"
                                />
                                <div class={`absolute top-3 right-3 text-[11px] font-bold px-3 py-1 rounded-full shadow-md backdrop-blur-sm ${product.badgeColor}`}>
                                    {product.badge}
                                </div>
                                <div class="absolute bottom-2 left-2 bg-black/70 backdrop-blur-md text-[10px] font-semibold text-gray-300 px-2.5 py-0.5 rounded-md border border-white/10">
                                    {product.category}
                                </div>
                            </div>

                            <!-- Title -->
                            <h3 class="text-lg sm:text-xl font-bold mb-3 text-white group-hover/card:text-neon transition-colors duration-200 line-clamp-2 leading-snug">
                                {product.title}
                            </h3>

                            <!-- Specs List -->
                            <ul class="space-y-1.5 text-xs text-gray-300 mb-4">
                                {product.specs.map((spec) => (
                                    <li class="flex items-start gap-2">
                                        <i class="fas fa-check-circle text-primary mt-0.5 flex-shrink-0"></i>
                                        <span class="leading-tight">{spec}</span>
                                    </li>
                                ))}
                            </ul>
                        </div>

                        <!-- Card Action Footer (No Price, Direct WA CTA) -->
                        <div class="pt-3.5 border-t border-gray-700/60 flex items-center justify-between text-xs font-bold text-primary group-hover/card:text-neon transition-colors duration-200">
                            <span class="inline-flex items-center gap-1.5">
                                <i class="fab fa-whatsapp text-sm"></i>
                                <span>Lihat di WhatsApp</span>
                            </span>
                            <span class="w-7 h-7 rounded-full bg-gray-700/60 group-hover/card:bg-primary group-hover/card:text-white flex items-center justify-center transition-all duration-200 group-hover/card:translate-x-1">
                                <i class="fas fa-arrow-right text-xs"></i>
                            </span>
                        </div>
                    </a>
                ))}
            </div>
        </div>

        <!-- Big Catalog Button (Selengkapnya / Lebih Banyak) -->
        <div class="mt-10 text-center fade-in-up">
            <a
                href={catalogUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-3 px-8 py-4 bg-gradient-to-r from-primary via-secondary to-primary bg-[length:200%_auto] text-white font-bold text-base md:text-lg rounded-full shadow-xl shadow-primary/25 hover:shadow-2xl hover:shadow-secondary/30 hover:scale-105 active:scale-95 transition-all duration-300 group cursor-pointer border border-white/15 hover:border-white/30"
            >
                <i class="fab fa-whatsapp text-2xl group-hover:animate-bounce"></i>
                <span>Lihat Selengkapnya di Katalog WhatsApp</span>
                <i class="fas fa-arrow-right text-sm group-hover:translate-x-1.5 transition-transform duration-200"></i>
            </a>
            <p class="text-xs text-gray-400 mt-3">
                *Klik untuk membuka etalase lengkap Toko AL di WhatsApp Catalog dengan foto unit terbaru.
            </p>
        </div>

        <!-- THE BIG MARKETPLACE CTA -->
        <div class="mt-16 fade-in-up" style="transition-delay: 200ms;">
            <div class="bg-gradient-to-br from-black via-gray-900 to-[#116530]/40 rounded-3xl p-8 md:p-12 border border-gray-800 relative overflow-hidden text-center shadow-2xl">
                
                <!-- Glow Effect Behind -->
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full bg-gradient-to-r from-secondary/15 to-primary/15 blur-3xl"></div>

                <div class="relative z-10">
                    <div class="text-container mb-3" id="text-animation-container"></div>
                    <p class="text-gray-400 mb-8 max-w-xl mx-auto">Kunjungi Official Store kami untuk melihat katalog lengkap, harga terupdate, dan nikmati promo gratis ongkir hari ini.</p>
                    
                    <div class="flex flex-col md:flex-row justify-center gap-4 md:gap-6">
                        <!-- Shopee Button -->
                        <a href="https://shopee.co.id/tokoal_id" target="_blank" rel="noopener noreferrer" class="group relative overflow-hidden bg-[#EE4D2D] text-white px-8 py-4 rounded-xl font-bold text-lg flex items-center justify-center gap-3 shadow-lg shadow-orange-900/50 hover:scale-105 active:scale-95 transition-all duration-300">
                            <div class="absolute inset-0 w-full h-full bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300"></div>
                            <span class="bg-white text-[#EE4D2D] w-8 h-8 rounded flex items-center justify-center text-sm shadow-sm relative z-10"><i class="fas fa-shopping-bag"></i></span>
                            <span class="relative z-10">Buka Shopee</span>
                            <i class="fas fa-arrow-right opacity-0 group-hover:opacity-100 -translate-x-2 group-hover:translate-x-0 transition-all duration-300 relative z-10"></i>
                        </a>

                        <!-- Tokopedia Button -->
                        <a href="https://www.tokopedia.com/tokoal-id" target="_blank" rel="noopener noreferrer" class="group relative overflow-hidden bg-[#42B549] text-white px-8 py-4 rounded-xl font-bold text-lg flex items-center justify-center gap-3 shadow-lg shadow-green-900/50 hover:scale-105 active:scale-95 transition-all duration-300">
                            <div class="absolute inset-0 w-full h-full bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300"></div>
                            <span class="bg-white text-[#42B549] w-8 h-8 rounded flex items-center justify-center text-sm shadow-sm relative z-10"><i class="fas fa-store"></i></span>
                            <span class="relative z-10">Buka Tokopedia</span>
                            <i class="fas fa-arrow-right opacity-0 group-hover:opacity-100 -translate-x-2 group-hover:translate-x-0 transition-all duration-300 relative z-10"></i>
                        </a>
                    </div>

                    <div class="mt-8 flex justify-center gap-6 text-sm text-gray-400">
                        <span class="flex items-center"><i class="fas fa-check-circle text-primary mr-2"></i> Official Store</span>
                        <span class="flex items-center"><i class="fas fa-check-circle text-primary mr-2"></i> 100% Original</span>
                    </div>
                </div>
            </div>
        </div>

<style>
    /* Text Animation Styles - Gunakan :global() untuk class yang dibuat via JS */
    .text-container {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 60px;
    }

    :global(.word-line) {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        white-space: nowrap;
    }

    :global(.letter) {
        display: inline-block;
        font-family: 'Poppins', sans-serif;
        font-weight: 800;
        font-size: clamp(1.5rem, 4vw, 2.5rem);
        color: #ffffff;
        line-height: 1;
        opacity: 0;
        transform-origin: bottom center;
        margin-right: -0.03em;
    }

    :global(.pop-in) {
        animation: bounceIn2D 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }

    @keyframes bounceIn2D {
        0% {
            opacity: 0;
            transform: translateY(50px) scale(0.5);
        }
        60% {
            transform: translateY(-15px) scale(1.1);
        }
        80% {
            transform: translateY(5px) scale(0.95);
        }
        100% {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    :global(.question-emphasis) {
        animation: wiggleBig 1s ease-in-out infinite;
        color: #A3EBB1;
        display: inline-block;
        position: relative;
        z-index: 10;
    }

    @keyframes wiggleBig {
        0%, 100% {
            transform: rotate(0deg) scale(1.5);
        }
        25% {
            transform: rotate(-15deg) scale(1.8);
        }
        75% {
            transform: rotate(15deg) scale(1.8);
        }
    }
</style>

<script>
    // Text Animation Logic (Client-Side)
    const lines = ["Siap Untuk Berbelanja?"];
    const container = document.getElementById('text-animation-container');

    function createMarkup() {
        if (!container) return;
        container.innerHTML = ''; 
        
        lines.forEach((lineText) => {
            const lineDiv = document.createElement('div');
            lineDiv.className = 'word-line';
            
            const characters = lineText.split('');

            characters.forEach((char) => {
                const span = document.createElement('span');
                span.textContent = char;
                span.className = 'letter';
                
                // Menandai tanda tanya
                if (char === '?') {
                    span.dataset.type = 'question-mark';
                }

                // Menangani spasi
                if (char === ' ') {
                    span.style.width = '0.4em'; 
                    span.style.marginRight = '0';
                }

                lineDiv.appendChild(span);
            });

            container.appendChild(lineDiv);
        });
    }

    function runSequence() {
        createMarkup();

        const letters = document.querySelectorAll('#text-animation-container .letter');
        let totalDelay = 0;

        letters.forEach((letter, index) => {
            const delay = index * 60; // Kecepatan muncul huruf
            totalDelay = delay;

            setTimeout(() => {
                letter.classList.add('pop-in');

                const el = letter as HTMLElement;
                if (el.dataset.type === 'question-mark') {
                    setTimeout(() => {
                        el.classList.remove('pop-in');
                        el.style.opacity = '1';
                        el.classList.add('question-emphasis');
                    }, 600); // Tunggu animasi masuk selesai baru goyang
                }

            }, delay);
        });

        // Loop Logic
        const animationDuration = 600;
        const readTime = 2000; 
        const totalCycleTime = totalDelay + animationDuration + readTime;

        setTimeout(runSequence, totalCycleTime);
    }

    // Jalankan saat script dimuat di client
    runSequence();

    // Product Carousel Logic
    const scrollLeftBtn = document.getElementById('scroll-left');
    const scrollRightBtn = document.getElementById('scroll-right');
    const productContainer = document.getElementById('product-container');
    
    if (scrollLeftBtn && productContainer) {
        scrollLeftBtn.addEventListener('click', () => {
            productContainer.scrollBy({ left: -360, behavior: 'smooth' });
        });
    }
    
    if (scrollRightBtn && productContainer) {
        scrollRightBtn.addEventListener('click', () => {
            productContainer.scrollBy({ left: 360, behavior: 'smooth' });
        });
    }
</script>
