---
import { Image } from "astro:assets";
import productFixie from "../assets/products/sepeda fixie.png";
import productMtb from "../assets/products/MTB.jpg";
import productBmx from "../assets/products/sepeda bmx.jpg";
import productFolding from "../assets/products/sepedaLipat.jpg";
import productAnak from "../assets/products/sepeda anak.jpg";
import productSparepart from "../assets/products/sparepart.jpg";
import productAksesoris from "../assets/products/aksesoris.png";
import productMainan from "../assets/products/mainan-anak.jpg";

const catalogUrl = "https://wa.me/c/6281996535525";
const waUrl = "https://api.whatsapp.com/send?phone=6281996535525&text=Halo%20Toko%20AL";

const products = [
	{
		title: "Sepeda Fixie & Roadbike",
		category: "Balap & Urban",
		fit: "Untuk gowes cepat dan harian di kota.",
		image: productFixie,
		link: "https://wa.me/p/8388943097813259/6281996535525",
		specs: [
			"Balap: 2x7, 2x8, 2x9, 3x7, 3x8, 3x9 Speed",
			"Fixie Full Warna & Desain Dinamis",
			"Rem: Torpedo, Cakram, U-Brake",
			"Stang: Dropbar, Flatbar, Hornbar",
			"Bottom Bracket (BB) & Bearing Presisi",
		],
	},
	{
		title: "Sepeda MTB",
		category: "Mountain Bike",
		fit: "Untuk jalur tanah dan tanjakan, usia 12 tahun ke atas.",
		image: productMtb,
		link: "https://wa.me/p/7078517838837650/6281996535525",
		specs: [
			"Usia: 12 Tahun - Dewasa",
			'Ukuran Roda: 24", 26", 27.5"',
			"Groupset: Shimano, RRC, dll.",
			"Rem: Cakram Mekanik & Hidrolik",
			"Frame: Alloy, Carbon, Steel Ringan",
		],
	},
	{
		title: "Sepeda BMX",
		category: "Freestyle & Street",
		fit: "Untuk freestyle dan gaya street, usia 6 tahun ke atas.",
		image: productBmx,
		link: "https://wa.me/p/5444712482244023/6281996535525",
		specs: [
			"Usia: 6 Tahun - Dewasa",
			"Frame: Alloy & Steel Kokoh Ekstra",
			"Rem: V-Brake, Cakram, dll.",
			"Roda: 3.0 (Jumbo), 2.4, dll.",
			"Stang Rotor, Gir Torpedo, Jalu & Stiker",
		],
	},
	{
		title: "Sepeda Lipat",
		category: "Commuter & Praktis",
		fit: "Praktis dibawa naik mobil atau KRL, usia 6 tahun ke atas.",
		image: productFolding,
		link: "https://wa.me/p/7373130436045125/6281996535525",
		specs: [
			"Usia: 6 Tahun - Dewasa",
			"Frame: Steel & Alloy Ringan",
			"Rem: V-Brake, Cakram, dll.",
			"Speed: 1 Speed, 7 Speed, dll.",
			"Lipatan Ringkas Praktis Masuk Mobil/KRL",
		],
	},
	{
		title: "Sepeda Anak",
		category: "Keluarga & Balita",
		fit: "Untuk usia 2 – 8 tahun, bisa dicoba dan disetel di toko.",
		image: productAnak,
		link: "https://wa.me/p/36929128000067317/6281996535525",
		specs: [
			"Usia: 2 Tahun - 8 Tahun",
			"Varian: Roda Tiga, Roda Bantu, & Push Bike",
			"Frame Kokoh, Aman, & Ergonomis",
			"Pilihan Warna & Karakter Kartun Ceria",
			"Bisa Dicoba & Disetel Langsung di Toko",
		],
	},
	{
		title: "Mainan Anak",
		category: "",
		fit: "Mobil/motor mainan aki dan edukatif untuk menemani waktu bermain.",
		image: productMainan,
		link: catalogUrl,
		specs: [],
	},
	{
		title: "Sparepart Sepeda",
		category: "Sparepart & Komponen",
		fit: "Untuk penggantian dan perawatan, bisa dipasang di toko.",
		image: productSparepart,
		link: catalogUrl,
		specs: [
			"RD, FD, Rantai, Sprocket, & Shifter",
			"Ban Luar & Ban Dalam Segala Ukuran",
			"Rem, Rotor Cakram, & Kampas Rem",
			"Komponen Original Berbagai Merk Teruji",
			"Tersedia Jasa Pasang & Setel Langsung",
		],
	},
	{
		title: "Aksesoris Sepeda",
		category: "Perlengkapan & Safety",
		fit: "Untuk gowes yang lebih nyaman dan aman.",
		image: productAksesoris,
		link: catalogUrl,
		specs: [
			"Helm Standar SNI & Lampu LED Terang",
			"Bel Nyaring & Kunci Gembok Pengaman",
			"Jersey, Sarung Tangan Gel, & Botol Minum",
			"Pompa Angin Portabel, Spatbor, & Tas Frame",
			"Perlengkapan Gowes Nyaman & Aman",
		],
	},
];
---

<section id="products" class="section" aria-labelledby="products-title">
	<div class="container">
		<div class="section-head">
			<h2 id="products-title">Koleksi Produk & Sepeda</h2>
			<p>
				Lihat pilihan sepeda, sparepart, dan aksesoris di Toko AL. Untuk harga dan ketersediaan, langsung tanya
				lewat WhatsApp.
			</p>
		</div>

		<div class="catalog">
			{products.map((p) => (
				<article class="product">
					<div class="product__media">
						<Image
							src={p.image}
							widths={[400, 640]}
							sizes="(min-width: 1024px) 280px, (min-width: 640px) 45vw, 80vw"
							alt={p.title}
						/>
					</div>
					<div class="product__body">
						{p.category && <p class="product__cat">{p.category}</p>}
						<h3>{p.title}</h3>
						<p class="product__fit">{p.fit}</p>
						{p.specs.length > 0 && (
							<ul class="product__specs">
								{p.specs.map((s) => <li>{s}</li>)}
							</ul>
						)}
						<div class="product__cta">
							<a
								href={p.link}
								target="_blank"
								rel="noopener noreferrer"
								class="btn btn--ghost"
								aria-label={`Tanya ${p.title} di WhatsApp`}
							>
								<i class="fab fa-whatsapp" aria-hidden="true"></i>
								<span>Tanya di WhatsApp</span>
							</a>
						</div>
					</div>
				</article>
			))}
		</div>

		<div class="catalog-more">
			<a href={catalogUrl} target="_blank" rel="noopener noreferrer" class="btn btn--primary">
				Lihat Lebih Banyak
			</a>
		</div>

		<div class="shop">
			<div class="stripes shop__stripes" aria-hidden="true"><span></span><span></span><span></span></div>
			<div class="shop__content">
				<h3>Sudah Siap Berbelanja?</h3>
				<p>Temukan produk Toko AL melalui WhatsApp, Shopee, atau Tokopedia.</p>
				<div class="shop__buttons">
					<a href={waUrl} target="_blank" rel="noopener noreferrer" class="btn btn--wa">
						<i class="fab fa-whatsapp" aria-hidden="true"></i><span>WhatsApp</span>
					</a>
					<a href="https://shopee.co.id/tokoal_id" target="_blank" rel="noopener noreferrer" class="btn">
						<i class="fas fa-bag-shopping" aria-hidden="true"></i><span>Shopee</span>
					</a>
					<a href="https://www.tokopedia.com/tokoal-id" target="_blank" rel="noopener noreferrer" class="btn">
						<i class="fas fa-store" aria-hidden="true"></i><span>Tokopedia</span>
					</a>
				</div>
				<p class="shop__badges">
					<span><i class="fas fa-circle-check" aria-hidden="true"></i>Official Store Toko AL</span>
					<span><i class="fas fa-circle-check" aria-hidden="true"></i>100% Original</span>
				</p>
			</div>
		</div>
	</div>
</section>
