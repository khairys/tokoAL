---
import Icon from "./Icon.astro";
import { Image } from "astro:assets";
import productFixie from "../assets/products/sepeda fixie.png";
import productMtb from "../assets/products/MTB.png";
import productBmx from "../assets/products/sepeda bmx.png";
import productFolding from "../assets/products/sepedaLipat.png";
import productAnak from "../assets/products/sepeda anak.png";
import productSparepart from "../assets/products/sparepart.png";
import productAksesoris from "../assets/products/aksesoris.png";
import productMainan from "../assets/products/mainan-anak.png";
import Eyebrow from "./Eyebrow.astro";

import { WA, CATALOG_URL as catalogUrl } from "../lib/site";

const waUrl = WA.order;

const products = [
	{
		title: "Sepeda Fixie & Roadbike",
		category: "Balap & Urban",
		fit: "Untuk gowes cepat dan harian di kota.",
		image: productFixie,
		link: "https://wa.me/p/8388943097813259/6281996535525",
		specs: [
			"Balap: 2x7, 2x8, 2x9, 3x7, 3x8, 3x9 Speed",
			"Fixie Full Warna & Desain Dinamis",
			"Rem: Torpedo, Cakram, U-Brake",
			"Stang: Dropbar, Flatbar, Hornbar",
			"Bottom Bracket (BB) & Bearing Presisi",
		],
	},
	{
		title: "Sepeda MTB",
		category: "Mountain Bike",
		fit: "Untuk jalur tanah dan tanjakan, usia 12 tahun ke atas.",
		image: productMtb,
		link: "https://wa.me/p/7078517838837650/6281996535525",
		specs: [
			"Usia: 12 Tahun - Dewasa",
			'Ukuran Roda: 24", 26", 27.5"',
			"Groupset: Shimano, RRC, dll.",
			"Rem: Cakram Mekanik & Hidrolik",
			"Frame: Alloy, Carbon, Steel Ringan",
		],
	},
	{
		title: "Sepeda BMX",
		category: "Freestyle & Street",
		fit: "Untuk freestyle dan gaya street, usia 6 tahun ke atas.",
		image: productBmx,
		link: "https://wa.me/p/5444712482244023/6281996535525",
		specs: [
			"Usia: 6 Tahun - Dewasa",
			"Frame: Alloy & Steel Kokoh Ekstra",
			"Rem: V-Brake, Cakram, dll.",
			"Roda: 3.0 (Jumbo), 2.4, dll.",
			"Stang Rotor, Gir Torpedo, Jalu & Stiker",
		],
	},
	{
		title: "Sepeda Lipat",
		category: "Commuter & Praktis",
		fit: "Praktis dibawa naik mobil atau KRL, usia 6 tahun ke atas.",
		image: productFolding,
		link: "https://wa.me/p/7373130436045125/6281996535525",
		specs: [
			"Usia: 6 Tahun - Dewasa",
			"Frame: Steel & Alloy Ringan",
			"Rem: V-Brake, Cakram, dll.",
			"Speed: 1 Speed, 7 Speed, dll.",
			"Lipatan Ringkas Praktis Masuk Mobil/KRL",
		],
	},
	{
		title: "Sepeda Anak",
		category: "Keluarga & Balita",
		fit: "Untuk usia 2 – 8 tahun, bisa dicoba dan disetel di toko.",
		image: productAnak,
		link: "https://wa.me/p/36929128000067317/6281996535525",
		specs: [
			"Usia: 2 Tahun - 8 Tahun",
			"Varian: Roda Tiga, Roda Bantu, & Push Bike",
			"Frame Kokoh, Aman, & Ergonomis",
			"Pilihan Warna & Karakter Kartun Ceria",
			"Bisa Dicoba & Disetel Langsung di Toko",
		],
	},
	{
		title: "Mainan Anak",
		category: "",
		fit: "Mobil/motor mainan aki dan edukatif untuk menemani waktu bermain.",
		image: productMainan,
		link: "https://wa.me/p/5605253369562505/6281996535525",
		specs: [
			"Usia: 1 - 5 Tahun",
			"Full Musik",
			"Dorongan",
			"Payung",
			"Sabuk Pengaman",
			"Rem, dll.",
		],
	},
	{
		title: "Sparepart Sepeda",
		category: "Sparepart & Komponen",
		fit: "Untuk penggantian dan perawatan, bisa dipasang di toko.",
		image: productSparepart,
		link: catalogUrl,
		specs: [
			"RD, FD, Rantai, Sprocket, & Shifter",
			"Ban Luar & Ban Dalam Segala Ukuran",
			"Rem, Rotor Cakram, & Kampas Rem",
			"Komponen Original Berbagai Merk Teruji",
			"Tersedia Jasa Pasang & Setel Langsung",
		],
	},
	{
		title: "Aksesoris Sepeda",
		category: "Perlengkapan & Safety",
		fit: "Untuk gowes yang lebih nyaman dan aman.",
		image: productAksesoris,
		link: catalogUrl,
		specs: [
			"Helm Standar SNI & Lampu LED Terang",
			"Bel Nyaring & Kunci Gembok Pengaman",
			"Jersey, Sarung Tangan Gel, & Botol Minum",
			"Pompa Angin Portabel, Spatbor, & Tas Frame",
			"Perlengkapan Gowes Nyaman & Aman",
		],
	},
];

// Filter groups. Every product photo is a studio shot on white.
const groupOf: Record<string, string> = {
	"Sepeda Fixie & Roadbike": "sepeda",
	"Sepeda MTB": "sepeda",
	"Sepeda BMX": "sepeda",
	"Sepeda Lipat": "sepeda",
	"Sepeda Anak": "anak",
	"Mainan Anak": "anak",
	"Sparepart Sepeda": "part",
	"Aksesoris Sepeda": "part",
};
const filters = [
	{ id: "all", label: "Semua" },
	{ id: "sepeda", label: "Sepeda" },
	{ id: "anak", label: "Anak & Mainan" },
	{ id: "part", label: "Sparepart & Aksesoris" },
];

// Put the family range first without changing any product facts or wording.
const orderedProducts = [
	...products.filter((p) => groupOf[p.title] === "anak"),
	...products.filter((p) => groupOf[p.title] !== "anak"),
];
---

<section id="products" class="section section--cut section--white" aria-labelledby="products-title">
	<div class="container">
		<div class="section-head" data-reveal="up">
			<Eyebrow label="Katalog" />
			<h2 id="products-title">Koleksi Produk & Sepeda</h2>
			<p>
				Lihat pilihan sepeda, sparepart, dan aksesoris di Toko AL. Untuk harga dan ketersediaan, langsung tanya
				lewat WhatsApp.
			</p>
		</div>

		<div class="filters" role="group" aria-label="Filter katalog" hidden>
			{filters.map((f, i) => (
				<button type="button" class="chip" data-filter={f.id} aria-controls="catalog" aria-pressed={i === 0 ? "true" : "false"}>
					{f.label}
				</button>
			))}
		</div>

		<div class="catalog" id="catalog" data-reveal="stagger">
			{orderedProducts.map((p, i) => (
				<article class="product" data-group={groupOf[p.title]} style={`--i: ${i % 4}`}>
					<div class="product__media product__media--cutout">
						<Image
							src={p.image}
							widths={[400, 640]}
							sizes="(min-width: 1200px) 285px, (min-width: 1024px) 30vw, (min-width: 640px) 45vw, 80vw"
							alt={p.title}
						/>
					</div>
					<div class="product__body">
						{p.category && <p class="product__cat">{p.category}</p>}
						<h3>{p.title}</h3>
						<p class="product__fit">{p.fit}</p>
						{p.specs.length > 0 && (
							<details class="product__more">
								<summary>
									<span>Lihat spesifikasi</span>
									<Icon name="solid:chevron-down" />
								</summary>
								<ul class="product__specs">
									{p.specs.map((s) => <li>{s}</li>)}
								</ul>
							</details>
						)}
						<div class="product__cta">
							<a
								href={WA.product(p.title)}
								target="_blank"
								rel="noopener noreferrer"
								class="btn btn--ghost"
								aria-label={`Tanya ${p.title} di WhatsApp`}
							>
								<Icon name="brands:whatsapp" />
								<span>Tanya di WhatsApp</span>
							</a>
							{p.link !== catalogUrl && (
								<a href={p.link} target="_blank" rel="noopener noreferrer" class="product__catalog">
									Lihat di katalog WhatsApp
								</a>
							)}
						</div>
					</div>
				</article>
			))}
		</div>

		<div class="catalog-more">
			<a href={catalogUrl} target="_blank" rel="noopener noreferrer" class="btn btn--primary">
				Lihat Lebih Banyak
			</a>
		</div>

		<div class="shop">
			<div class="shop__content">
				<h3>Sudah Siap Berbelanja?</h3>
				<p>Temukan produk Toko AL melalui WhatsApp, Shopee, atau Tokopedia.</p>
				<div class="shop__buttons">
					<a href={waUrl} target="_blank" rel="noopener noreferrer" class="btn btn--wa">
						<Icon name="brands:whatsapp" /><span>WhatsApp</span>
					</a>
					<a href="https://shopee.co.id/tokoal_id" target="_blank" rel="noopener noreferrer" class="btn">
						<Icon name="solid:bag-shopping" class="icon--shopee" /><span>Shopee</span>
					</a>
					<a href="https://www.tokopedia.com/tokoal-id" target="_blank" rel="noopener noreferrer" class="btn">
						<Icon name="solid:store" class="icon--tokopedia" /><span>Tokopedia</span>
					</a>
				</div>
				<p class="shop__badges">
					<span><Icon name="solid:circle-check" />Official Store Toko AL</span>
					<span><Icon name="solid:circle-check" />100% Original</span>
				</p>
			</div>
		</div>
	</div>
</section>

<script>
	const catalog = document.getElementById("catalog");
	const chips = document.querySelectorAll<HTMLButtonElement>(".chip[data-filter]");
	const cards = catalog ? [...catalog.querySelectorAll<HTMLElement>(".product")] : [];
	const filters = document.querySelector<HTMLElement>(".filters");

	function filterCatalog(group: string) {
		chips.forEach((c) => c.setAttribute("aria-pressed", String(c.dataset.filter === group)));
		cards.forEach((card) => {
			card.hidden = group !== "all" && card.dataset.group !== group;
		});
		// On mobile the catalog is a swipe row: start the filtered list from the first card
		catalog?.scrollTo({ left: 0, behavior: "instant" });
	}
	chips.forEach((chip) => chip.addEventListener("click", () => filterCatalog(chip.dataset.filter ?? "all")));
	document.querySelectorAll<HTMLAnchorElement>("[data-catalog-filter]").forEach((link) => {
		link.addEventListener("click", () => filterCatalog(link.dataset.catalogFilter ?? "all"));
	});
	if (catalog && filters) filters.hidden = false;
</script>
