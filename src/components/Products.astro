---

<!-- === PRODUCT & MARKETPLACE SECTION === -->
<section id="products" class="py-20 bg-gray-900 text-white relative overflow-hidden">
    
    <!-- Background Decoration -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-secondary/15 rounded-full filter blur-[120px]"></div>
    <div class="absolute bottom-0 left-0 w-80 h-80 bg-primary/20 rounded-full filter blur-[100px]"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        <!-- Header -->
        <div class="text-center mb-12 fade-in-up">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">Koleksi Produk & Sepeda</h2>
            <div class="w-24 h-1.5 bg-gradient-to-r from-primary via-secondary to-neon mx-auto rounded-full"></div>
            <p class="mt-4 text-gray-400 max-w-2xl mx-auto text-base sm:text-lg leading-relaxed">
                Lihat berbagai pilihan sepeda, sparepart, dan aksesoris yang tersedia di Toko AL. Klik produk untuk melihat detail dan menghubungi kami.
            </p>
        </div>

        <!-- Carousel Container with Navigation Buttons -->
        <div class="relative group/carousel fade-in-up">
            <!-- Navigation Buttons (Desktop only, mobile uses natural touch swipe) -->
            <button
                id="scroll-left"
                aria-label="Geser ke kiri"
                class="hidden md:flex absolute -left-4 top-1/2 -translate-y-1/2 z-20 w-12 h-12 bg-gray-800/90 hover:bg-primary text-white rounded-full shadow-2xl border border-gray-700 items-center justify-center transition-all duration-200 opacity-0 group-hover/carousel:opacity-100 cursor-pointer active:scale-90"
            >
                <i class="fas fa-chevron-left text-lg"></i>
            </button>
            <button
                id="scroll-right"
                aria-label="Geser ke kanan"
                class="hidden md:flex absolute -right-4 top-1/2 -translate-y-1/2 z-20 w-12 h-12 bg-gray-800/90 hover:bg-primary text-white rounded-full shadow-2xl border border-gray-700 items-center justify-center transition-all duration-200 opacity-0 group-hover/carousel:opacity-100 cursor-pointer active:scale-90"
            >
                <i class="fas fa-chevron-right text-lg"></i>
            </button>

            <!-- Product Cards Container with Mobile Snap-X -->
            <div
                id="product-container"
                class="flex gap-4 sm:gap-6 overflow-x-auto hide-scroll py-6 px-4 sm:px-6 cursor-grab active:cursor-grabbing snap-x snap-mandatory scroll-smooth"
            >
                {loopProducts.map((product, idx) => (
                    <a
                        href={product.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group/card min-w-[280px] sm:min-w-[320px] md:min-w-[340px] max-w-[360px] bg-gray-800/60 backdrop-blur-md rounded-2xl p-5 border border-gray-700/80 hover:border-secondary/70 transition-all duration-300 hover:shadow-2xl hover:shadow-primary/20 hover:-translate-y-2 flex flex-col justify-between active:scale-[0.98] cursor-pointer flex-shrink-0 snap-center sm:snap-start"
                        data-index={idx}
                    >
                        <div>
                            <!-- Product Image (Clean without text overlays) -->
                            <div class="relative aspect-[4/3] rounded-xl overflow-hidden mb-4 bg-gray-950 border border-gray-700/50 flex items-center justify-center">
                                <img
                                    src={product.image.src}
                                    alt={product.title}
                                    class="w-full h-full object-cover group-hover/card:scale-105 transition-transform duration-500"
                                    loading="lazy"
                                />
                            </div>

                            <!-- Category & Title -->
                            <span class="text-[11px] font-bold text-secondary uppercase tracking-wider block mb-1.5">{product.category}</span>
                            <h3 class="text-lg sm:text-xl font-bold mb-3 text-white group-hover/card:text-neon transition-colors duration-200 line-clamp-2 leading-snug">
                                {product.title}
                            </h3>

                            <!-- Specs List -->
                            <ul class="space-y-1.5 text-xs text-gray-300 mb-4">
                                {product.specs.map((spec) => (
                                    <li class="flex items-start gap-2">
                                        <i class="fas fa-check-circle text-primary mt-0.5 flex-shrink-0"></i>
                                        <span class="leading-tight">{spec}</span>
                                    </li>
                                ))}
                            </ul>
                        </div>

                        <!-- Card Action Footer (Simple & Direct) -->
                        <div class="pt-3.5 border-t border-gray-700/60 flex items-center justify-between text-xs font-semibold text-gray-300 group-hover/card:text-neon transition-colors duration-200">
                            <span class="font-bold">Selengkapnya</span>
                            <span class="w-7 h-7 rounded-full bg-gray-700/60 group-hover/card:bg-primary group-hover/card:text-white flex items-center justify-center transition-all duration-200 group-hover/card:translate-x-1">
                                <i class="fas fa-arrow-right text-xs"></i>
                            </span>
                        </div>
                    </a>
                ))}
            </div>
        </div>

        <!-- Action: Lebih Banyak -->
        <div class="mt-10 text-center fade-in-up">
            <a
                href={catalogUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-3.5 bg-gray-800/80 hover:bg-gray-800 text-gray-200 hover:text-white border border-gray-700 hover:border-primary/60 font-semibold text-sm sm:text-base rounded-full shadow-md hover:shadow-xl hover:shadow-primary/10 active:scale-95 transition-all duration-200 group cursor-pointer"
            >
                <span>Lihat Lebih Banyak</span>
                <i class="fas fa-arrow-right text-xs text-primary group-hover:translate-x-1 transition-transform"></i>
            </a>
        </div>

        <!-- THE BIG MARKETPLACE CTA -->
        <div class="mt-16 fade-in-up" style="transition-delay: 200ms;">
            <div class="bg-gradient-to-br from-black via-gray-900 to-[#116530]/40 rounded-3xl p-8 md:p-12 border border-gray-800 relative overflow-hidden text-center shadow-2xl">
                
                <!-- Glow Effect Behind -->
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full bg-gradient-to-r from-secondary/15 to-primary/15 blur-3xl"></div>

                <div class="relative z-10">
                    <div class="text-container mb-3" id="text-animation-container"></div>
                    <p class="text-gray-400 mb-8 max-w-xl mx-auto">Temukan produk Toko AL melalui WhatsApp, Shopee, atau Tokopedia.</p>
                    
                    <div class="flex flex-col sm:flex-row flex-wrap justify-center gap-3.5 sm:gap-4 md:gap-5 max-w-lg sm:max-w-none mx-auto">
                        <!-- WhatsApp Button (First) -->
                        <a href={catalogUrl} target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto group relative overflow-hidden bg-[#25D366] text-white px-7 py-4 rounded-xl font-bold text-base sm:text-lg flex items-center justify-center gap-3 shadow-lg shadow-emerald-900/40 hover:scale-105 active:scale-95 transition-all duration-300">
                            <div class="absolute inset-0 w-full h-full bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300"></div>
                            <span class="bg-white text-[#25D366] w-8 h-8 rounded flex items-center justify-center text-base shadow-sm relative z-10"><i class="fab fa-whatsapp"></i></span>
                            <span class="relative z-10">WhatsApp</span>
                            <i class="fas fa-arrow-right opacity-0 group-hover:opacity-100 -translate-x-2 group-hover:translate-x-0 transition-all duration-300 relative z-10"></i>
                        </a>

                        <!-- Shopee Button (Second) -->
                        <a href="https://shopee.co.id/tokoal_id" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto group relative overflow-hidden bg-[#EE4D2D] text-white px-7 py-4 rounded-xl font-bold text-base sm:text-lg flex items-center justify-center gap-3 shadow-lg shadow-orange-900/40 hover:scale-105 active:scale-95 transition-all duration-300">
                            <div class="absolute inset-0 w-full h-full bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300"></div>
                            <span class="bg-white text-[#EE4D2D] w-8 h-8 rounded flex items-center justify-center text-sm shadow-sm relative z-10"><i class="fas fa-shopping-bag"></i></span>
                            <span class="relative z-10">Shopee</span>
                            <i class="fas fa-arrow-right opacity-0 group-hover:opacity-100 -translate-x-2 group-hover:translate-x-0 transition-all duration-300 relative z-10"></i>
                        </a>

                        <!-- Tokopedia Button (Third) -->
                        <a href="https://www.tokopedia.com/tokoal-id" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto group relative overflow-hidden bg-[#42B549] text-white px-7 py-4 rounded-xl font-bold text-base sm:text-lg flex items-center justify-center gap-3 shadow-lg shadow-green-900/40 hover:scale-105 active:scale-95 transition-all duration-300">
                            <div class="absolute inset-0 w-full h-full bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300"></div>
                            <span class="bg-white text-[#42B549] w-8 h-8 rounded flex items-center justify-center text-sm shadow-sm relative z-10"><i class="fas fa-store"></i></span>
                            <span class="relative z-10">Tokopedia</span>
                            <i class="fas fa-arrow-right opacity-0 group-hover:opacity-100 -translate-x-2 group-hover:translate-x-0 transition-all duration-300 relative z-10"></i>
                        </a>
                    </div>

                    <div class="mt-8 flex justify-center gap-6 text-sm text-gray-400">
                        <span class="flex items-center"><i class="fas fa-check-circle text-primary mr-2"></i> Official Store</span>
                        <span class="flex items-center"><i class="fas fa-check-circle text-primary mr-2"></i> 100% Original</span>
                    </div>
                </div>
            </div>
        </div>

<style>
    /* Text Animation Styles - Gunakan :global() untuk class yang dibuat via JS */
    .text-container {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 60px;
    }

    :global(.word-line) {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        white-space: nowrap;
    }

    :global(.letter) {
        display: inline-block;
        font-family: 'Poppins', sans-serif;
        font-weight: 800;
        font-size: clamp(1.5rem, 4vw, 2.5rem);
        color: #ffffff;
        line-height: 1;
        opacity: 0;
        transform-origin: bottom center;
        margin-right: -0.03em;
    }

    :global(.pop-in) {
        animation: bounceIn2D 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }

    @keyframes bounceIn2D {
        0% {
            opacity: 0;
            transform: translateY(50px) scale(0.5);
        }
        60% {
            transform: translateY(-15px) scale(1.1);
        }
        80% {
            transform: translateY(5px) scale(0.95);
        }
        100% {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    :global(.question-emphasis) {
        animation: wiggleBig 1s ease-in-out infinite;
        color: #A3EBB1;
        display: inline-block;
        position: relative;
        z-index: 10;
    }

    @keyframes wiggleBig {
        0%, 100% {
            transform: rotate(0deg) scale(1.5);
        }
        25% {
            transform: rotate(-15deg) scale(1.8);
        }
        75% {
            transform: rotate(15deg) scale(1.8);
        }
    }
</style>

<script>
    // Text Animation Logic (Client-Side)
    const lines = ["Sudah Siap Berbelanja?"];
    const container = document.getElementById('text-animation-container');

    function createMarkup() {
        if (!container) return;
        container.innerHTML = ''; 
        
        lines.forEach((lineText) => {
            const lineDiv = document.createElement('div');
            lineDiv.className = 'word-line';
            
            const characters = lineText.split('');

            characters.forEach((char) => {
                const span = document.createElement('span');
                span.textContent = char;
                span.className = 'letter';
                
                // Menandai tanda tanya
                if (char === '?') {
                    span.dataset.type = 'question-mark';
                }

                // Menangani spasi
                if (char === ' ') {
                    span.style.width = '0.4em'; 
                    span.style.marginRight = '0';
                }

                lineDiv.appendChild(span);
            });

            container.appendChild(lineDiv);
        });
    }

    function runSequence() {
        createMarkup();

        const letters = document.querySelectorAll('#text-animation-container .letter');
        let totalDelay = 0;

        letters.forEach((letter, index) => {
            const delay = index * 60; // Kecepatan muncul huruf
            totalDelay = delay;

            setTimeout(() => {
                letter.classList.add('pop-in');

                const el = letter as HTMLElement;
                if (el.dataset.type === 'question-mark') {
                    setTimeout(() => {
                        el.classList.remove('pop-in');
                        el.style.opacity = '1';
                        el.classList.add('question-emphasis');
                    }, 600); // Tunggu animasi masuk selesai baru goyang
                }

            }, delay);
        });

        // Loop Logic
        const animationDuration = 600;
        const readTime = 2000; 
        const totalCycleTime = totalDelay + animationDuration + readTime;

        setTimeout(runSequence, totalCycleTime);
    }

    // Jalankan saat script dimuat di client
    runSequence();

    // Product Carousel Infinite Auto-Scroll Logic
    const scrollLeftBtn = document.getElementById('scroll-left');
    const scrollRightBtn = document.getElementById('scroll-right');
    const productContainer = document.getElementById('product-container');
    
    if (productContainer) {
        const originalItemCount = 7; // jumlah item asli sebelum duplikasi loop
        
        function getCardStep() {
            if (!productContainer || !productContainer.firstElementChild) return 360;
            const firstCard = productContainer.firstElementChild as HTMLElement;
            const style = window.getComputedStyle(productContainer);
            const gap = parseFloat(style.columnGap || style.gap) || 24;
            return firstCard.offsetWidth + gap;
        }

        function getSetWidth() {
            return getCardStep() * originalItemCount;
        }

        // Posisi awal di tengah (Set 2) agar bisa scroll mulus bolak-balik tanpa batas
        const initMiddlePosition = () => {
            const setWidth = getSetWidth();
            if (setWidth > 0 && productContainer.scrollLeft === 0) {
                productContainer.scrollLeft = setWidth;
            }
        };

        // Jalankan inisialisasi posisi awal
        setTimeout(initMiddlePosition, 150);
        window.addEventListener('resize', initMiddlePosition);

        // Infinite loop wrap-around check
        let isWrapping = false;
        productContainer.addEventListener('scroll', () => {
            if (isWrapping) return;
            const setWidth = getSetWidth();
            if (setWidth <= 0) return;

            // Jika geser mendekati akhir Set 2, reset mulus ke Set 1 secara instan tanpa jeda
            if (productContainer.scrollLeft >= setWidth * 2 - 10) {
                isWrapping = true;
                productContainer.scrollLeft -= setWidth;
                setTimeout(() => { isWrapping = false; }, 50);
            } 
            // Jika geser mendekati awal (ke arah 0), lompatkan ke Set 2
            else if (productContainer.scrollLeft <= 10) {
                isWrapping = true;
                productContainer.scrollLeft += setWidth;
                setTimeout(() => { isWrapping = false; }, 50);
            }
        }, { passive: true });

        // Auto slide timer
        let autoSlideTimer: number | null = null;
        const startAutoSlide = () => {
            if (autoSlideTimer) clearInterval(autoSlideTimer);
            autoSlideTimer = window.setInterval(() => {
                if (!productContainer) return;
                const step = getCardStep();
                productContainer.scrollBy({ left: step, behavior: 'smooth' });
            }, 3000);
        };

        const pauseAutoSlide = () => {
            if (autoSlideTimer) {
                clearInterval(autoSlideTimer);
                autoSlideTimer = null;
            }
        };

        // Jalankan auto-scroll otomatis
        startAutoSlide();

        // Pause saat kursor mouse di-hover atau layar disentuh
        productContainer.addEventListener('mouseenter', pauseAutoSlide);
        productContainer.addEventListener('mouseleave', startAutoSlide);
        productContainer.addEventListener('touchstart', pauseAutoSlide, { passive: true });
        productContainer.addEventListener('touchend', () => {
            setTimeout(startAutoSlide, 2000);
        });

        // Tombol Geser Kiri & Kanan
        scrollLeftBtn?.addEventListener('click', () => {
            pauseAutoSlide();
            const step = getCardStep();
            productContainer.scrollBy({ left: -step, behavior: 'smooth' });
            setTimeout(startAutoSlide, 4000);
        });
        
        scrollRightBtn?.addEventListener('click', () => {
            pauseAutoSlide();
            const step = getCardStep();
            productContainer.scrollBy({ left: step, behavior: 'smooth' });
            setTimeout(startAutoSlide, 4000);
        });
    }
</script>
