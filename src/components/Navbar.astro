---
// Navbar Component (Mobile-Optimized UX)
import logoNavbar from '../assets/branding/Logo navbar.png';
---

<nav class="fixed w-full z-50 bg-white/95 backdrop-blur-md shadow-sm transition-all duration-300" id="navbar">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex justify-between items-center h-16">
			<!-- Logo -->
			<a href="#home" class="flex-shrink-0 flex items-center gap-2.5 cursor-pointer group transition-transform duration-200 active:scale-95 origin-left">
				<img src={logoNavbar.src} alt="Logo Toko AL" class="h-8 sm:h-9 w-auto object-contain drop-shadow-sm transition-transform duration-200 group-hover:scale-105" />
				<span class="font-extrabold text-xl tracking-tight text-dark group-hover:text-primary transition-colors duration-200">Toko AL</span>
			</a>
			
			<!-- Desktop Menu with Animated Sliding Underline Indicator (visible on lg: >= 1024px) -->
			<div class="hidden lg:flex items-center space-x-7 relative py-1" id="desktop-nav-menu">
				<!-- Sliding Underline Indicator -->
				<span
					id="nav-indicator"
					class="absolute bottom-0 h-0.5 bg-primary rounded-full pointer-events-none opacity-0"
				></span>

				<a href="#home" class="desktop-nav-link text-gray-600 hover:text-primary transition-all duration-200 font-medium py-1 hover:scale-105">Beranda</a>
				<a href="#services" class="desktop-nav-link text-gray-600 hover:text-primary transition-all duration-200 font-medium py-1 hover:scale-105">Layanan</a>
				<a href="#products" class="desktop-nav-link text-gray-600 hover:text-primary transition-all duration-200 font-medium py-1 hover:scale-105">Katalog</a>
				<a href="#gallery" class="desktop-nav-link text-gray-600 hover:text-primary transition-all duration-200 font-medium py-1 hover:scale-105">Suasana Toko</a>
				<a href="#partners" class="desktop-nav-link text-gray-600 hover:text-primary transition-all duration-200 font-medium py-1 hover:scale-105">Merek & Komunitas</a>
				<a href="#contact" class="desktop-nav-link text-gray-600 hover:text-primary transition-all duration-200 font-medium py-1 hover:scale-105">Kontak</a>
			</div>

			<!-- Mobile Actions (Hamburger only, WhatsApp button removed, visible on < 1024px) -->
			<div class="lg:hidden flex items-center">
				<button 
					id="mobile-menu-btn" 
					aria-label="Buka menu navigasi" 
					class="w-10 h-10 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 flex items-center justify-center focus:outline-none transition-all duration-200 active:scale-90 cursor-pointer"
				>
					<i class="fas fa-bars text-lg"></i>
				</button>
			</div>
		</div>
	</div>
	
	<!-- Mobile Menu Panel (collapses below lg: 1024px) -->
	<div id="mobile-menu" class="hidden lg:hidden bg-white/95 backdrop-blur-md border-t border-gray-100 shadow-xl transition-all duration-200">
		<div class="px-4 pt-3 pb-6 space-y-1">
			<a href="#home" class="mobile-nav-link flex items-center justify-between px-4 py-3 rounded-xl text-base font-semibold text-gray-700 hover:text-primary hover:bg-[#A3EBB1]/15 active:bg-[#A3EBB1]/25 transition-colors">
				<span>Beranda</span>
				<i class="fas fa-chevron-right text-xs text-gray-400"></i>
			</a>
			<a href="#services" class="mobile-nav-link flex items-center justify-between px-4 py-3 rounded-xl text-base font-semibold text-gray-700 hover:text-primary hover:bg-[#A3EBB1]/15 active:bg-[#A3EBB1]/25 transition-colors">
				<span>Layanan Bengkel</span>
				<i class="fas fa-chevron-right text-xs text-gray-400"></i>
			</a>
			<a href="#products" class="mobile-nav-link flex items-center justify-between px-4 py-3 rounded-xl text-base font-semibold text-gray-700 hover:text-primary hover:bg-[#A3EBB1]/15 active:bg-[#A3EBB1]/25 transition-colors">
				<span>Katalog Sepeda</span>
				<i class="fas fa-chevron-right text-xs text-gray-400"></i>
			</a>
			<a href="#gallery" class="mobile-nav-link flex items-center justify-between px-4 py-3 rounded-xl text-base font-semibold text-gray-700 hover:text-primary hover:bg-[#A3EBB1]/15 active:bg-[#A3EBB1]/25 transition-colors">
				<span>Suasana Toko</span>
				<i class="fas fa-chevron-right text-xs text-gray-400"></i>
			</a>
			<a href="#partners" class="mobile-nav-link flex items-center justify-between px-4 py-3 rounded-xl text-base font-semibold text-gray-700 hover:text-primary hover:bg-[#A3EBB1]/15 active:bg-[#A3EBB1]/25 transition-colors">
				<span>Merek & Komunitas</span>
				<i class="fas fa-chevron-right text-xs text-gray-400"></i>
			</a>
			<a href="#contact" class="mobile-nav-link flex items-center justify-between px-4 py-3 rounded-xl text-base font-semibold text-gray-700 hover:text-primary hover:bg-[#A3EBB1]/15 active:bg-[#A3EBB1]/25 transition-colors">
				<span>Lokasi & Kontak</span>
				<i class="fas fa-chevron-right text-xs text-gray-400"></i>
			</a>

			<!-- Quick Mobile Action in Drawer -->
			<div class="pt-3 mt-2 border-t border-gray-100">
				<a
					href="https://api.whatsapp.com/send?phone=6281996535525&text=Halo%20Toko%20AL"
					target="_blank"
					rel="noopener noreferrer"
					class="w-full py-3 px-4 bg-primary hover:bg-dark text-white rounded-xl font-bold text-sm flex items-center justify-center gap-2 shadow-md shadow-primary/20 active:scale-95 transition-all"
				>
					<i class="fab fa-whatsapp text-base"></i>
					<span>Chat WhatsApp Sekarang</span>
				</a>
			</div>
		</div>
	</div>
</nav>

<script>
	const btn = document.getElementById('mobile-menu-btn');
	const menu = document.getElementById('mobile-menu');

	btn?.addEventListener('click', () => {
		const isHidden = menu?.classList.toggle('hidden');
		const icon = btn.querySelector('i');
		if (icon) {
			if (isHidden) {
				icon.className = 'fas fa-bars text-lg';
			} else {
				icon.className = 'fas fa-times text-lg';
			}
		}
	});

	// Smooth Scroll with Navbar Offset & Auto-Close Mobile Menu
	let isNavClicking = false;
	let navClickTimer: any = null;

	document.querySelectorAll('a[href^="#"]').forEach(anchor => {
		anchor.addEventListener('click', function (e) {
			const href = this.getAttribute('href');
			if (!href || href === '#') return;
			
			const target = document.querySelector(href);
			if (target) {
				e.preventDefault();
				const targetId = href.replace('#', '');

				// Lock scrollspy so intermediate sections don't cause twitching/jitter
				isNavClicking = true;
				clearTimeout(navClickTimer);

				// Pre-reveal target section elements to stabilize layout before scroll lands
				target.querySelectorAll('.fade-in-up').forEach(el => el.classList.add('visible'));

				// Animate indicator directly to target in one smooth glide
				setActiveSection(targetId);

				const navHeight = 64;
				const targetTop = target.getBoundingClientRect().top + window.pageYOffset - navHeight;
				window.scrollTo({
					top: targetTop,
					behavior: 'smooth'
				});
				
				// Close mobile menu
				menu?.classList.add('hidden');
				const icon = btn?.querySelector('i');
				if (icon) {
					icon.className = 'fas fa-bars text-lg';
				}

				// Release lock when smooth scrolling finishes
				const releaseLock = () => {
					isNavClicking = false;
					window.removeEventListener('scrollend', releaseLock);
				};

				if ('onscrollend' in window) {
					window.addEventListener('scrollend', releaseLock, { once: true });
				}
				navClickTimer = setTimeout(() => {
					isNavClicking = false;
				}, 850);
			}
		});
	});

	// Navbar Scroll Shadow
	const navbar = document.getElementById('navbar');
	window.addEventListener('scroll', () => {
		if (window.scrollY > 10) {
			navbar?.classList.add('shadow-md');
			navbar?.classList.replace('bg-white/95', 'bg-white');
		} else {
			navbar?.classList.remove('shadow-md');
			navbar?.classList.replace('bg-white', 'bg-white/95');
		}
	}, { passive: true });

	// === ACTIVE SECTION SCROLLSPY & ANIMATED INDICATOR ===
	const sectionIds = ['home', 'services', 'products', 'gallery', 'partners', 'contact'];
	const sections = sectionIds
		.map(id => document.getElementById(id))
		.filter((el): el is HTMLElement => el !== null);

	const desktopNavMenu = document.getElementById('desktop-nav-menu');
	const navIndicator = document.getElementById('nav-indicator');
	const desktopLinks = document.querySelectorAll<HTMLAnchorElement>('.desktop-nav-link');
	const mobileLinks = document.querySelectorAll<HTMLAnchorElement>('.mobile-nav-link');

	let currentActiveId = 'home';
	let isInitialized = false;

	function moveIndicatorTo(link: HTMLElement | null) {
		if (!link || !navIndicator || !desktopNavMenu) return;
		const containerRect = desktopNavMenu.getBoundingClientRect();
		const linkRect = link.getBoundingClientRect();

		const left = linkRect.left - containerRect.left;
		const width = linkRect.width;

		navIndicator.style.left = `${left}px`;
		navIndicator.style.width = `${width}px`;
		navIndicator.style.opacity = '1';
	}

	function setActiveSection(id: string) {
		currentActiveId = id;

		let activeDesktopLink: HTMLElement | null = null;
		desktopLinks.forEach(link => {
			const href = link.getAttribute('href');
			if (href === `#${id}`) {
				link.classList.add('text-primary', 'font-semibold');
				link.classList.remove('text-gray-600');
				activeDesktopLink = link;
			} else {
				link.classList.remove('text-primary', 'font-semibold');
				link.classList.add('text-gray-600');
			}
		});

		mobileLinks.forEach(link => {
			const href = link.getAttribute('href');
			if (href === `#${id}`) {
				link.classList.add('text-primary', 'bg-[#A3EBB1]/20', 'font-bold', 'border-l-4', 'border-primary');
				link.classList.remove('text-gray-700');
			} else {
				link.classList.remove('text-primary', 'bg-[#A3EBB1]/20', 'font-bold', 'border-l-4', 'border-primary');
				link.classList.add('text-gray-700');
			}
		});

		if (activeDesktopLink) {
			moveIndicatorTo(activeDesktopLink);
		}
	}

	// Scroll spy with throttling and scroll-lock protection
	let scrollTicking = false;
	function onScroll() {
		if (scrollTicking || isNavClicking) return;
		scrollTicking = true;
		requestAnimationFrame(() => {
			if (isNavClicking) {
				scrollTicking = false;
				return;
			}

			const scrollY = window.scrollY;
			const windowHeight = window.innerHeight;
			const docHeight = document.documentElement.scrollHeight;

			// If at bottom of the page, activate the last section (Contact)
			if (scrollY + windowHeight >= docHeight - 80) {
				const lastSection = sections[sections.length - 1];
				if (lastSection) {
					setActiveSection(lastSection.id);
				}
				scrollTicking = false;
				return;
			}

			// Top of the page
			if (scrollY < 100) {
				setActiveSection('home');
				scrollTicking = false;
				return;
			}

			// Check which section is currently active
			const offsetBuffer = 140; // navbar height (64px) + comfortable offset
			let activeId = sections[0]?.id || 'home';

			for (let i = 0; i < sections.length; i++) {
				const sec = sections[i];
				if (sec.offsetTop - offsetBuffer <= scrollY) {
					activeId = sec.id;
				} else {
					break;
				}
			}

			setActiveSection(activeId);
			scrollTicking = false;
		});
	}

	window.addEventListener('scroll', onScroll, { passive: true });

	// Resize handler
	window.addEventListener('resize', () => {
		const activeLink = document.querySelector<HTMLElement>(`.desktop-nav-link[href="#${currentActiveId}"]`);
		if (activeLink) {
			moveIndicatorTo(activeLink);
		}
	});

	// Initial positioning: zero transition first, then enable 300ms transition
	function initIndicator() {
		onScroll();
		const activeLink = document.querySelector<HTMLElement>(`.desktop-nav-link[href="#${currentActiveId}"]`);
		if (activeLink) {
			if (!isInitialized) {
				// Instant placement without animation on first load
				navIndicator?.classList.remove('transition-all', 'duration-300', 'ease-out');
				moveIndicatorTo(activeLink);
				isInitialized = true;

				// Enable smooth transition for all future moves after initial paint
				requestAnimationFrame(() => {
					requestAnimationFrame(() => {
						navIndicator?.classList.add('transition-all', 'duration-300', 'ease-out');
					});
				});
			} else {
				moveIndicatorTo(activeLink);
			}
		}
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initIndicator);
	} else {
		initIndicator();
	}
	// Fallback after fonts/styles load
	window.addEventListener('load', initIndicator);
	setTimeout(initIndicator, 200);
</script>
