---
// Navbar Component - Fluid Precision Prototype
import logoNavbar from '../assets/branding/Logo navbar.png';
---

<header class="fixed top-0 left-0 w-full z-50 bg-white/85 backdrop-blur-xl border-b border-zinc-200/70 transition-all duration-200" id="navbar">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex items-center justify-between h-16 sm:h-20">
			<!-- Brand Identity -->
			<a href="#home" class="flex items-center gap-3 active:scale-95 transition-transform duration-150 origin-left">
				<img 
					src={logoNavbar.src} 
					alt="Logo Toko AL" 
					class="h-9 w-auto object-contain drop-shadow-sm" 
				/>
				<div class="flex flex-col">
					<span class="font-extrabold text-xl sm:text-2xl tracking-tight text-zinc-950 leading-none">
						Toko AL
					</span>
					<span class="text-[10px] font-bold uppercase tracking-widest text-emerald-700 mt-1">
						Pusat Sepeda Cikande
					</span>
				</div>
			</a>

			<!-- Precision Desktop Navigation -->
			<nav class="hidden md:flex items-center space-x-1 p-1 bg-zinc-100/80 rounded-full border border-zinc-200/60 text-xs font-semibold text-zinc-600">
				<a href="#home" class="px-4 py-2 rounded-full hover:text-zinc-950 hover:bg-white transition-all active:scale-95">Beranda</a>
				<a href="#services" class="px-4 py-2 rounded-full hover:text-zinc-950 hover:bg-white transition-all active:scale-95">Layanan</a>
				<a href="#products" class="px-4 py-2 rounded-full hover:text-zinc-950 hover:bg-white transition-all active:scale-95">Katalog</a>
				<a href="#gallery" class="px-4 py-2 rounded-full hover:text-zinc-950 hover:bg-white transition-all active:scale-95">Suasana Toko</a>
				<a href="#partners" class="px-4 py-2 rounded-full hover:text-zinc-950 hover:bg-white transition-all active:scale-95">Komunitas</a>
				<a href="#contact" class="px-4 py-2 rounded-full hover:text-zinc-950 hover:bg-white transition-all active:scale-95">Kontak</a>
			</nav>

			<!-- Action CTA -->
			<div class="hidden sm:flex items-center gap-3">
				<a
					href="https://api.whatsapp.com/send?phone=6281996535525&text=Halo%20Toko%20AL"
					target="_blank"
					rel="noopener noreferrer"
					class="px-5 py-2.5 rounded-full text-xs font-bold text-white bg-zinc-950 hover:bg-emerald-600 transition-colors duration-150 active:scale-95 flex items-center gap-2 shadow-sm"
				>
					<i class="fab fa-whatsapp text-sm text-emerald-400"></i>
					<span>Chat Toko</span>
				</a>
			</div>

			<!-- Mobile Button -->
			<div class="md:hidden flex items-center">
				<button id="mobile-toggle" aria-label="Toggle menu" class="p-2 text-zinc-800 hover:text-emerald-600 active:scale-90 transition-transform">
					<i class="fas fa-bars text-xl"></i>
				</button>
			</div>
		</div>
	</div>

	<!-- Mobile Drawer -->
	<div id="mobile-drawer" class="hidden md:hidden bg-white/95 backdrop-blur-xl border-t border-zinc-200 px-6 py-5 space-y-3 shadow-xl">
		<a href="#services" class="mobile-item block text-sm font-semibold text-zinc-800 hover:text-emerald-600">Layanan & Servis</a>
		<a href="#products" class="mobile-item block text-sm font-semibold text-zinc-800 hover:text-emerald-600">Katalog Produk</a>
		<a href="#gallery" class="mobile-item block text-sm font-semibold text-zinc-800 hover:text-emerald-600">Suasana Toko</a>
		<a href="#partners" class="mobile-item block text-sm font-semibold text-zinc-800 hover:text-emerald-600">Mitra & Komunitas</a>
		<a href="#contact" class="mobile-item block text-sm font-semibold text-zinc-800 hover:text-emerald-600">Lokasi & Kontak</a>
		<div class="pt-3 border-t border-zinc-100">
			<a
				href="https://api.whatsapp.com/send?phone=6281996535525&text=Halo%20Toko%20AL"
				target="_blank"
				class="w-full py-3 rounded-xl bg-emerald-600 text-white font-bold text-center text-xs uppercase tracking-wider flex items-center justify-center gap-2 active:scale-95"
			>
				<i class="fab fa-whatsapp text-sm"></i>
				<span>Hubungi via WhatsApp</span>
			</a>
		</div>
	</div>
</header>

<script>
	const toggle = document.getElementById('mobile-toggle');
	const drawer = document.getElementById('mobile-drawer');

	toggle?.addEventListener('click', () => {
		const isHidden = drawer?.classList.toggle('hidden');
		const icon = toggle.querySelector('i');
		if (icon) {
			icon.className = isHidden ? 'fas fa-bars text-xl' : 'fas fa-times text-xl';
		}
	});

	document.querySelectorAll('.mobile-item').forEach(el => {
		el.addEventListener('click', () => {
			drawer?.classList.add('hidden');
			const icon = toggle?.querySelector('i');
			if (icon) icon.className = 'fas fa-bars text-xl';
		});
	});
</script>
