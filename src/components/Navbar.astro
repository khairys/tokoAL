---
import Icon from "./Icon.astro";
import { Image } from "astro:assets";
import logoNavbar from "../assets/branding/Logo navbar.png";

import { WA, SOCIALS } from "../lib/site";

const waUrl = WA.general;

// Order follows the page. Desktop and mobile labels are the existing ones.
const links = [
	{ id: "home", label: "Beranda", mobile: "Beranda" },
	{ id: "products", label: "Katalog", mobile: "Katalog Sepeda" },
	{ id: "services", label: "Layanan", mobile: "Layanan Bengkel" },
	{ id: "gallery", label: "Suasana Toko", mobile: "Suasana Toko" },
	{ id: "partners", label: "Merek & Komunitas", mobile: "Merek & Komunitas" },
	{ id: "contact", label: "Kontak", mobile: "Lokasi & Kontak" },
];
---

<header class="nav" id="navbar">
	<div class="container nav__bar">
		<a href="#home" class="nav__brand">
			<Image src={logoNavbar} width={160} alt="Logo Toko AL" loading="eager" />
			<span>Toko AL</span>
		</a>

		<nav class="nav__links" aria-label="Navigasi utama">
			{links.map((l) => (
				<a href={`#${l.id}`} class="nav__link" data-spy={l.id}>{l.label}</a>
			))}
		</nav>

		<div class="nav__actions">
			<a href={waUrl} target="_blank" rel="noopener noreferrer" class="btn btn--primary nav__wa" aria-label="Chat WhatsApp">
				<Icon name="brands:whatsapp" />
				<span class="nav__wa-label">Chat WhatsApp</span>
			</a>
			<button class="nav__toggle" id="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-panel" aria-label="Buka menu navigasi" hidden>
				<Icon name="solid:bars" class="nav__icon-open" />
				<Icon name="solid:xmark" class="nav__icon-close" />
			</button>
		</div>
	</div>

	<div class="nav__panel" id="nav-panel" hidden>
		{links.map((l) => (
			<a href={`#${l.id}`} class="nav__mlink" data-spy={l.id}>
				<span>{l.mobile}</span>
				<Icon name="solid:chevron-right" />
			</a>
		))}
		<a href={waUrl} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--block">
			<Icon name="brands:whatsapp" />
			<span>Chat WhatsApp Sekarang</span>
		</a>
		<div class="nav__socials">
			{SOCIALS.map((s) => (
				<a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`${s.name} Toko AL`}>
					<Icon name={s.icon} />
				</a>
			))}
		</div>
	</div>
</header>

<noscript>
	<nav class="nav__fallback container" aria-label="Navigasi utama">
		{links.map((l) => <a href={`#${l.id}`}>{l.mobile}</a>)}
	</nav>
</noscript>

<script>
	const nav = document.getElementById("navbar");
	const toggle = document.getElementById("nav-toggle") as HTMLButtonElement | null;
	const panel = document.getElementById("nav-panel");

	function setMenu(open: boolean) {
		if (!toggle || !panel) return;
		panel.hidden = !open;
		toggle.setAttribute("aria-expanded", String(open));
		toggle.setAttribute("aria-label", open ? "Tutup menu navigasi" : "Buka menu navigasi");
	}

	if (toggle) toggle.hidden = false;
	toggle?.addEventListener("click", () => setMenu(panel?.hidden ?? true));
	panel?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => {
		setMenu(false);
		if (a.hash) {
			const target = document.getElementById(a.hash.slice(1));
			target?.setAttribute("tabindex", "-1");
			target?.focus({ preventScroll: true });
		} else toggle?.focus({ preventScroll: true });
	}));
	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape" && panel && !panel.hidden) {
			setMenu(false);
			toggle?.focus({ preventScroll: true });
		}
	});
	document.addEventListener("click", (e) => {
		if (e.target instanceof Node && !nav?.contains(e.target)) setMenu(false);
	});
	nav?.addEventListener("focusout", (e) => {
		if (e.relatedTarget instanceof Node && !nav.contains(e.relatedTarget)) setMenu(false);
	});
	window.matchMedia("(min-width: 1024px)").addEventListener("change", (e) => {
		if (e.matches) setMenu(false);
	});

	// Border under the bar once the page scrolls, plus the active section highlight
	const spyLinks = document.querySelectorAll<HTMLAnchorElement>("[data-spy]");
	const sections = [...new Set([...spyLinks].map((a) => a.dataset.spy))]
		.map((id) => document.getElementById(id ?? ""))
		.filter((el): el is HTMLElement => !!el);

	let ticking = false;
	function update() {
		ticking = false;
		const y = window.scrollY;
		nav?.classList.toggle("is-scrolled", y > 8);

		let active = "home";
		for (const s of sections) if (s.offsetTop <= y + 120) active = s.id;
		if (window.innerHeight + y >= document.documentElement.scrollHeight - 4) {
			active = sections[sections.length - 1]?.id ?? active;
		}
		spyLinks.forEach((a) => {
			const on = a.dataset.spy === active;
			a.classList.toggle("is-active", on);
			if (on) a.setAttribute("aria-current", "true");
			else a.removeAttribute("aria-current");
		});
	}
	window.addEventListener(
		"scroll",
		() => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(update);
			}
		},
		{ passive: true },
	);
	window.addEventListener("load", update);
	update();
</script>
