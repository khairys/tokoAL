---
// Hero Component
import familyHappyImg from '../assets/hero/familyhappy.jpg';
---

<!-- === HERO SECTION === -->
<section
    id="home"
    class="relative pt-28 pb-16 lg:pt-36 lg:pb-24 overflow-hidden bg-gradient-to-b from-emerald-50/40 via-white to-white"
>
    <!-- Subtle Ambient Glow -->
    <div
        class="absolute top-0 right-1/4 w-96 h-96 bg-[#A3EBB1]/20 rounded-full filter blur-3xl pointer-events-none"
    >
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
            <!-- Text Content -->
            <div class="fade-in-up text-center lg:text-left">
                <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-emerald-100/60 text-[#116530] border border-emerald-200/50 mb-5">
                    <span class="w-2 h-2 rounded-full bg-primary"></span>
                    <span>Toko Sepeda & Bengkel Resmi Serang</span>
                </div>
                <h1
                    class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-gray-900 mb-6 leading-[1.15]"
                >
                    Solusi Gowes Lengkap, <br class="hidden sm:inline" />
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#116530] to-primary">
                        Nyaman & Terpercaya
                    </span>
                </h1>
                <p
                    class="text-base sm:text-lg text-gray-600 mb-8 leading-relaxed max-w-lg mx-auto lg:mx-0 font-normal"
                >
                    Pusat penjualan sepeda berkualitas, suku cadang original, dan layanan servis oleh mekanik berpengalaman di Cikande Permai.
                </p>
                <div
                    class="flex flex-col sm:flex-row gap-3.5 justify-center lg:justify-start"
                >
                    <a
                        href="https://api.whatsapp.com/send?phone=6281996535525&text=Halo%20Toko%20AL,%20saya%20ingin%20konsultasi"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="px-7 py-3.5 bg-primary text-white rounded-full font-semibold shadow-sm hover:bg-[#116530] hover:shadow-md active:scale-[0.98] transition-all flex items-center justify-center gap-2.5 cursor-pointer"
                    >
                        <i class="fab fa-whatsapp text-lg"></i>
                        <span>Hubungi via WhatsApp</span>
                    </a>
                    <a
                        href="#products"
                        class="px-7 py-3.5 bg-white text-gray-700 border border-gray-200 rounded-full font-semibold hover:border-gray-300 hover:bg-gray-50 active:scale-[0.98] transition-all flex items-center justify-center gap-2 cursor-pointer"
                    >
                        <span>Lihat Katalog</span>
                        <i class="fas fa-arrow-right text-xs"></i>
                    </a>
                </div>
            </div>

            <!-- Hero Image Single -->
            <div class="fade-in-up" style="transition-delay: 150ms;">
                <div
                    class="relative rounded-3xl overflow-hidden shadow-xl border border-gray-100/80 bg-white aspect-[4/3] sm:aspect-[16/11] flex items-center justify-center"
                >
                    <img
                        src={familyHappyImg.src}
                        alt="Keluarga Bersepeda Bahagia - Toko AL"
                        class="w-full h-full object-cover object-center"
                        loading="eager"
                    />
                </div>
            </div>
        </div>
    </div>
</section>
