---
// Hero Component
const heroSlides = [
    {
        id: 1,
        title: "Foto Koleksi Sepeda",
        desc: "Display sepeda MTB, Lipat, & Roadbike",
        badge: "Slide 1",
        icon: "fa-bicycle"
    },
    {
        id: 2,
        title: "Foto Layanan Bengkel",
        desc: "Servis & Tune-up oleh mekanik berpengalaman",
        badge: "Slide 2",
        icon: "fa-wrench"
    },
    {
        id: 3,
        title: "Foto Sparepart & Aksesoris",
        desc: "Komponen original dan aksesoris gowes terlengkap",
        badge: "Slide 3",
        icon: "fa-cogs"
    }
];
---

<!-- === HERO SECTION === -->
<section
    id="home"
    class="relative pt-28 pb-20 lg:pt-40 lg:pb-32 overflow-hidden bg-gradient-to-b from-[#A3EBB1]/15 via-green-50/30 to-white"
>
    <!-- Decoration Blobs -->
    <div
        class="absolute top-0 left-0 w-80 h-80 bg-[#A3EBB1] rounded-full mix-blend-multiply filter blur-2xl opacity-30 animate-blob"
    >
    </div>
    <div
        class="absolute top-0 right-0 w-80 h-80 bg-[#21B6A8] rounded-full mix-blend-multiply filter blur-2xl opacity-20 animate-blob animation-delay-2000"
    >
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <!-- Text Content -->
            <div class="fade-in-up text-center lg:text-left">
                <h1
                    class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight mb-6 leading-tight"
                >
                    <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-[#116530] via-primary to-secondary"
                    >
                        bersepeda itu mudah
                    </span>
                </h1>
                <p
                    class="text-lg text-gray-600 mb-8 leading-relaxed max-w-lg mx-auto lg:mx-0"
                >
                    Kami menyediakan unit sepeda berkualitas, spareparts
                    lengkap, dan layanan servis oleh mekanik profesional untuk
                    performa gowes maksimal.
                </p>
                <div
                    class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start"
                >
                    <a
                        href="https://api.whatsapp.com/send?phone=6281996535525&text=Halo"
                        target="_blank"
                        class="group px-8 py-4 bg-primary text-white rounded-full font-bold shadow-lg shadow-primary/25 hover:bg-dark hover:shadow-2xl hover:shadow-dark/30 transform hover:-translate-y-2 transition-all duration-200 flex items-center justify-center gap-2 hover:scale-105 relative overflow-hidden before:absolute before:inset-0 before:bg-white before:opacity-0 hover:before:opacity-10 before:transition-opacity"
                    >
                        <i
                            class="fab fa-whatsapp text-xl group-hover:animate-bounce"
                        ></i> Hubungi Kami
                    </a>
                    <a
                        href="#products"
                        class="group px-8 py-4 bg-white text-gray-700 border-2 border-gray-200 rounded-full font-bold hover:border-primary hover:text-primary hover:bg-[#A3EBB1]/10 hover:shadow-lg transition-all duration-200 flex items-center justify-center gap-2 hover:scale-105 transform hover:-translate-y-1"
                    >
                        Lihat Katalog <i
                            class="fas fa-arrow-right group-hover:translate-x-1 transition group-hover:animate-pulse"
                        ></i>
                    </a>
                </div>
            </div>

            <!-- Hero Image Carousel -->
            <div class="fade-in-up relative" style="transition-delay: 200ms;">
                <div
                    id="hero-carousel"
                    class="relative rounded-3xl overflow-hidden shadow-2xl border-8 border-white bg-slate-100 aspect-[4/3] sm:aspect-[16/11] flex items-center justify-center group select-none"
                >
                    {heroSlides.map((slide, index) => (
                        <div
                            class={`hero-slide absolute inset-0 transition-opacity duration-700 ease-in-out flex items-center justify-center ${index === 0 ? 'opacity-100 pointer-events-auto' : 'opacity-0 pointer-events-none'}`}
                            data-index={index}
                        >
                            <!-- Gradient background for placeholder -->
                            <div class="absolute inset-0 bg-gradient-to-br from-slate-100 via-emerald-50/50 to-slate-200"></div>
                            
                            <!-- Slide Content / Placeholder -->
                            <div class="relative z-10 flex flex-col items-center justify-center text-center p-8 select-none">
                                <span class="px-3 py-1 bg-white/90 backdrop-blur-sm text-primary text-xs font-bold rounded-full mb-3 shadow-sm border border-primary/20">
                                    {slide.badge}
                                </span>
                                <div
                                    class="w-20 h-20 rounded-2xl bg-white/90 shadow-md border border-slate-200/80 flex items-center justify-center mb-4 text-primary group-hover:scale-110 transition-all duration-300"
                                >
                                    <i class={`fas ${slide.icon} text-3xl`}></i>
                                </div>
                                <h3 class="text-xl font-bold text-gray-800 mb-1">{slide.title}</h3>
                                <p class="text-sm text-gray-500 max-w-xs">{slide.desc}</p>
                            </div>
                        </div>
                    ))}

                    <!-- Navigation Arrows -->
                    <button
                        id="hero-prev"
                        aria-label="Slide Sebelumnya"
                        class="absolute left-3 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-white/90 hover:bg-primary text-gray-700 hover:text-white backdrop-blur-md flex items-center justify-center transition-all duration-200 opacity-0 group-hover:opacity-100 shadow-md hover:scale-110 cursor-pointer"
                    >
                        <i class="fas fa-chevron-left text-sm"></i>
                    </button>
                    <button
                        id="hero-next"
                        aria-label="Slide Selanjutnya"
                        class="absolute right-3 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-white/90 hover:bg-primary text-gray-700 hover:text-white backdrop-blur-md flex items-center justify-center transition-all duration-200 opacity-0 group-hover:opacity-100 shadow-md hover:scale-110 cursor-pointer"
                    >
                        <i class="fas fa-chevron-right text-sm"></i>
                    </button>

                    <!-- Dot Indicators -->
                    <div class="absolute bottom-4 z-20 flex items-center gap-1.5">
                        {heroSlides.map((_, index) => (
                            <button
                                class={`hero-dot h-2 rounded-full transition-all duration-300 cursor-pointer ${index === 0 ? 'w-6 bg-primary' : 'w-2 bg-gray-400/60 hover:bg-gray-600'}`}
                                aria-label={`Lihat slide ${index + 1}`}
                                data-index={index}
                            ></button>
                        ))}
                    </div>
                </div>
                <!-- Decorative patterns -->
                <div
                    class="absolute -z-10 -bottom-10 -right-10 w-40 h-40 bg-dots-pattern opacity-20"
                >
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    // Hero Carousel Logic
    const heroSlides = document.querySelectorAll('.hero-slide');
    const heroDots = document.querySelectorAll('.hero-dot');
    const heroPrevBtn = document.getElementById('hero-prev');
    const heroNextBtn = document.getElementById('hero-next');
    const heroCarousel = document.getElementById('hero-carousel');

    let heroIndex = 0;
    let heroTimer: any = null;
    const heroTotal = heroSlides.length;

    function showHeroSlide(idx: number) {
        if (heroTotal === 0) return;

        heroSlides[heroIndex]?.classList.remove('opacity-100', 'pointer-events-auto');
        heroSlides[heroIndex]?.classList.add('opacity-0', 'pointer-events-none');

        heroDots[heroIndex]?.classList.remove('w-6', 'bg-primary');
        heroDots[heroIndex]?.classList.add('w-2', 'bg-gray-400/60');

        heroIndex = (idx + heroTotal) % heroTotal;

        heroSlides[heroIndex]?.classList.remove('opacity-0', 'pointer-events-none');
        heroSlides[heroIndex]?.classList.add('opacity-100', 'pointer-events-auto');

        heroDots[heroIndex]?.classList.remove('w-2', 'bg-gray-400/60');
        heroDots[heroIndex]?.classList.add('w-6', 'bg-primary');
    }

    function nextHeroSlide() {
        showHeroSlide(heroIndex + 1);
    }

    function prevHeroSlide() {
        showHeroSlide(heroIndex - 1);
    }

    function startHeroTimer() {
        stopHeroTimer();
        heroTimer = setInterval(nextHeroSlide, 4000);
    }

    function stopHeroTimer() {
        if (heroTimer) {
            clearInterval(heroTimer);
            heroTimer = null;
        }
    }

    heroNextBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        nextHeroSlide();
        startHeroTimer();
    });

    heroPrevBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        prevHeroSlide();
        startHeroTimer();
    });

    heroDots.forEach((dot, idx) => {
        dot.addEventListener('click', (e) => {
            e.stopPropagation();
            showHeroSlide(idx);
            startHeroTimer();
        });
    });

    heroCarousel?.addEventListener('mouseenter', stopHeroTimer);
    heroCarousel?.addEventListener('mouseleave', startHeroTimer);

    startHeroTimer();
</script>
