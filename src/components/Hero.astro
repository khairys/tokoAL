---
// Hero Component - Fluid Precision Prototype
import familyHappyImg from '../assets/hero/familyhappy.jpg';
---

<section id="home" class="pt-28 pb-16 sm:pt-36 sm:pb-24 bg-white border-b border-zinc-200/80">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		
		<!-- Hero Top Section -->
		<div class="max-w-3xl mb-12">
			<!-- Status Badge -->
			<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200/80 text-xs font-semibold text-emerald-800 mb-6">
				<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
				<span>Buka Hari Ini di Cikande Permai (09.00 – 20.00 WIB)</span>
			</div>

			<h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-zinc-950 leading-[1.08] mb-6">
				Sepeda Berkualitas.<br class="hidden sm:inline" />
				Perawatan Presisi Mekanik.
			</h1>

			<p class="text-lg sm:text-xl text-zinc-600 leading-relaxed mb-8 max-w-2xl">
				Pilihan unit sepeda terlengkap dari balap hingga anak, didukung stok suku cadang original dan bengkel resmi dengan mekanik andal di Cikande, Serang.
			</p>

			<!-- Quick Category Pills (Tactile Switcher) -->
			<div class="flex flex-wrap items-center gap-2 mb-8 text-xs font-semibold text-zinc-700">
				<span class="text-zinc-400 mr-1">Koleksi Cepat:</span>
				<a href="#products" class="px-3.5 py-1.5 rounded-full bg-zinc-100 hover:bg-zinc-200 border border-zinc-200 active:scale-95 transition-all">Mountain Bike (MTB)</a>
				<a href="#products" class="px-3.5 py-1.5 rounded-full bg-zinc-100 hover:bg-zinc-200 border border-zinc-200 active:scale-95 transition-all">Fixie & Roadbike</a>
				<a href="#products" class="px-3.5 py-1.5 rounded-full bg-zinc-100 hover:bg-zinc-200 border border-zinc-200 active:scale-95 transition-all">Sepeda Lipat</a>
				<a href="#products" class="px-3.5 py-1.5 rounded-full bg-zinc-100 hover:bg-zinc-200 border border-zinc-200 active:scale-95 transition-all">Sepeda & Mainan Anak</a>
				<a href="#products" class="px-3.5 py-1.5 rounded-full bg-zinc-100 hover:bg-zinc-200 border border-zinc-200 active:scale-95 transition-all">Sparepart Original</a>
			</div>

			<!-- CTAs -->
			<div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
				<a
					href="https://api.whatsapp.com/send?phone=6281996535525&text=Halo%20Toko%20AL"
					target="_blank"
					rel="noopener noreferrer"
					class="px-8 py-4 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm sm:text-base rounded-full shadow-lg shadow-emerald-600/20 active:scale-95 transition-all flex items-center justify-center gap-2.5"
				>
					<i class="fab fa-whatsapp text-lg"></i>
					<span>Hubungi Toko Sekarang</span>
				</a>
				<a
					href="#products"
					class="px-8 py-4 bg-zinc-100 hover:bg-zinc-200 text-zinc-900 font-bold text-sm sm:text-base rounded-full border border-zinc-300/80 active:scale-95 transition-all flex items-center justify-center gap-2"
				>
					<span>Jelajahi Katalog Lengkap</span>
					<i class="fas fa-arrow-right text-xs"></i>
				</a>
			</div>
		</div>

		<!-- Hero Full Feature Visual (Curved Frame with Live Atmosphere) -->
		<div class="relative rounded-3xl overflow-hidden border border-zinc-200/80 aspect-[16/9] sm:aspect-[21/9] bg-zinc-100 shadow-xl group">
			<img
				src={familyHappyImg.src}
				alt="Keluarga Bersepeda Bersama Toko AL"
				class="w-full h-full object-cover object-center group-hover:scale-[1.02] transition-transform duration-700"
				loading="eager"
			/>
			<div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
			
			<div class="absolute bottom-5 left-5 right-5 sm:bottom-8 sm:left-8 flex flex-col sm:flex-row sm:items-end justify-between gap-3 text-white">
				<div>
					<span class="text-xs font-bold uppercase tracking-widest text-emerald-400 block mb-1">Toko Fisik & Komunitas</span>
					<p class="text-base sm:text-xl font-extrabold leading-snug">Menyediakan Sepeda Siap Pakai & Disetel Sebelum Anda Bawa Pulang</p>
				</div>
				<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/20 backdrop-blur-md border border-white/20 text-xs font-semibold text-white">
					<i class="fas fa-check-circle text-emerald-400"></i>
					<span>Unit Bisa Dicoba Langsung</span>
				</div>
			</div>
		</div>

	</div>
</section>
