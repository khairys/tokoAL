---
import { Image } from "astro:assets";
import heroImg from "../assets/gallery/Pelanggan.png";

const waUrl = "https://api.whatsapp.com/send?phone=6281996535525&text=Halo";
const mapsUrl = "https://www.google.com/maps/search/?api=1&query=Toko+Sepeda+AL+Cikande+Permai";
---

<section id="home" class="hero">
	<div class="container hero__grid">
		<div>
			<h1 class="hero__title">
				<span class="hero__line"><span>Bersepeda</span></span>
				<span class="hero__line hero__line--ink"><span>Itu Mudah</span></span>
			</h1>
			<p class="hero__lead hero__seq" style="--i: 0">
				Sepeda, sparepart, aksesoris, dan servis untuk Anda dan keluarga, di Cikande Permai, Serang.
			</p>

			<a class="hero__proof hero__seq" style="--i: 1" href={mapsUrl} target="_blank" rel="noopener noreferrer">
				<i class="fas fa-star" aria-hidden="true"></i>
				<span><strong data-count="4.9" data-decimals="1">4,9</strong> dari 203 ulasan Google</span>
			</a>

			<div class="hero__actions hero__seq" style="--i: 2">
				<a href={waUrl} target="_blank" rel="noopener noreferrer" class="btn btn--primary">
					<i class="fab fa-whatsapp" aria-hidden="true"></i>
					<span>Chat WhatsApp</span>
				</a>
				<a href="#products" class="btn btn--ghost">Lihat Produk</a>
			</div>

			<p class="hero__hours hero__seq" style="--i: 3">
				<span><i class="far fa-clock" aria-hidden="true"></i> Senin – Sabtu 09.00 – 20.00</span>
				<span>Minggu 09.00 – 17.00 WIB</span>
			</p>
		</div>

		<div class="hero__visual">
			<div class="hero__panel" aria-hidden="true"></div>
			<div class="hero__photo">
				<Image
					src={heroImg}
					widths={[400, 652]}
					sizes="(min-width: 1024px) 560px, 92vw"
					alt="Staf Toko AL membantu seorang anak memilih sepeda di toko"
					loading="eager"
					fetchpriority="high"
				/>
			</div>
			<div class="stripes stripes--on-green hero__stripes" aria-hidden="true"><span></span><span></span><span></span></div>
		</div>
	</div>
</section>
