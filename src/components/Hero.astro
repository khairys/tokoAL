---
// Hero Component
---

<!-- === HERO SECTION === -->
<section
    id="home"
    class="relative pt-28 pb-20 lg:pt-40 lg:pb-32 overflow-hidden bg-gradient-to-b from-green-50 to-white"
>
    <!-- Decoration Blobs -->
    <div
        class="absolute top-0 left-0 w-72 h-72 bg-green-200 rounded-full mix-blend-multiply filter blur-xl opacity-30 animate-blob"
    >
    </div>
    <div
        class="absolute top-0 right-0 w-72 h-72 bg-yellow-200 rounded-full mix-blend-multiply filter blur-xl opacity-30 animate-blob animation-delay-2000"
    >
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <!-- Text Content -->
            <div class="fade-in-up text-center lg:text-left">
                <h1
                    class="text-4xl md:text-6xl font-extrabold text-gray-900 tracking-tight mb-6 leading-tight"
                >
                    Solusi Sepeda <br />
                    <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-green-400"
                        >Terlengkap</span
                    >
                </h1>
                <p
                    class="text-lg text-gray-600 mb-8 leading-relaxed max-w-lg mx-auto lg:mx-0"
                >
                    Kami menyediakan unit sepeda berkualitas, spareparts
                    lengkap, dan layanan servis oleh mekanik profesional untuk
                    performa gowes maksimal.
                </p>
                <div
                    class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start"
                >
                    <a
                        href="https://api.whatsapp.com/send?phone=6281996535525&text=Halo"
                        target="_blank"
                        class="group px-8 py-4 bg-primary text-white rounded-full font-bold shadow-lg hover:bg-dark hover:shadow-2xl transform hover:-translate-y-2 transition-all duration-200 flex items-center justify-center gap-2 hover:scale-105 relative overflow-hidden before:absolute before:inset-0 before:bg-white before:opacity-0 hover:before:opacity-10 before:transition-opacity"
                    >
                        <i
                            class="fab fa-whatsapp text-xl group-hover:animate-bounce"
                        ></i> Hubungi Kami
                    </a>
                    <a
                        href="#products"
                        class="group px-8 py-4 bg-white text-gray-700 border-2 border-gray-200 rounded-full font-bold hover:border-primary hover:text-primary hover:bg-primary hover:text-white hover:shadow-xl transition-all duration-200 flex items-center justify-center gap-2 hover:scale-105 transform hover:-translate-y-1"
                    >
                        Lihat Katalog <i
                            class="fas fa-arrow-right group-hover:translate-x-1 transition group-hover:animate-pulse"
                        ></i>
                    </a>
                </div>
            </div>

            <!-- Hero Image Placeholder -->
            <div class="fade-in-up relative" style="transition-delay: 200ms;">
                <div
                    class="relative rounded-3xl overflow-hidden shadow-2xl border-8 border-white bg-slate-100 aspect-[4/3] sm:aspect-[16/11] flex items-center justify-center group"
                >
                    <div
                        class="absolute inset-0 bg-gradient-to-br from-slate-100 via-gray-50 to-slate-200"
                    >
                    </div>
                    <div
                        class="relative z-10 flex flex-col items-center justify-center text-center p-8 select-none"
                    >
                        <div
                            class="w-20 h-20 rounded-2xl bg-white/90 shadow-md border border-slate-200/60 flex items-center justify-center mb-4 text-slate-400 group-hover:scale-110 group-hover:text-primary transition-all duration-300"
                        >
                            <i class="fas fa-image text-3xl"></i>
                        </div>
                    </div>
                </div>
                <!-- Decorative patterns -->
                <div
                    class="absolute -z-10 -bottom-10 -right-10 w-40 h-40 bg-dots-pattern opacity-20"
                >
                </div>
            </div>
        </div>
    </div>
</section>
