---
// Hero Component
import familyHappyImg from "../assets/hero/familyhappy.jpg";
---

<!-- === HERO SECTION === -->
<section
    id="home"
    class="relative pt-24 pb-14 sm:pt-32 sm:pb-20 lg:pt-40 lg:pb-32 overflow-hidden bg-gradient-to-b from-[#A3EBB1]/15 via-green-50/30 to-white"
>
    <!-- Decoration Blobs -->
    <div
        class="absolute top-0 left-0 w-80 h-80 bg-[#A3EBB1] rounded-full mix-blend-multiply filter blur-2xl opacity-30 animate-blob pointer-events-none"
    >
    </div>
    <div
        class="absolute top-0 right-0 w-80 h-80 bg-[#21B6A8] rounded-full mix-blend-multiply filter blur-2xl opacity-20 animate-blob animation-delay-2000 pointer-events-none"
    >
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
            <!-- Text Content -->
            <div class="fade-in-up text-center lg:text-left">
                <h1
                    class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight mb-6 sm:mb-8 lg:mb-9 leading-tight sm:leading-[1.18]"
                >
                    <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-[#116530] via-primary to-secondary block pb-1"
                    >
                        Bersepeda Itu Mudah
                    </span>
                </h1>
                <p
                    class="text-base sm:text-lg text-gray-600 mb-6 sm:mb-8 leading-relaxed max-w-lg mx-auto lg:mx-0"
                >
                    Kami menyediakan unit sepeda berkualitas, spareparts
                    lengkap, dan layanan servis oleh mekanik profesional untuk
                    performa gowes maksimal.
                </p>
                <div
                    class="flex flex-col sm:flex-row gap-3.5 sm:gap-4 justify-center lg:justify-start"
                >
                    <a
                        href="https://api.whatsapp.com/send?phone=6281996535525&text=Halo"
                        target="_blank"
                        class="w-full sm:w-auto px-7 py-4 bg-primary text-white rounded-full font-bold shadow-lg shadow-primary/25 hover:bg-dark hover:shadow-2xl hover:shadow-dark/30 transform hover:-translate-y-0.5 active:scale-95 transition-all duration-150 flex items-center justify-center gap-2.5 relative overflow-hidden before:absolute before:inset-0 before:bg-white before:opacity-0 hover:before:opacity-10 before:transition-opacity cursor-pointer group"
                    >
                        <i
                            class="fab fa-whatsapp text-xl transition-transform duration-200 group-hover:scale-110"
                        ></i>
                        <span>Hubungi Kami</span>
                    </a>
                    <a
                        href="#products"
                        class="w-full sm:w-auto px-7 py-4 bg-white text-gray-700 border-2 border-gray-200 rounded-full font-bold hover:border-primary hover:text-primary hover:bg-[#A3EBB1]/10 hover:shadow-lg transform hover:-translate-y-0.5 active:scale-95 transition-all duration-150 flex items-center justify-center gap-2 cursor-pointer group"
                    >
                        <span>Lihat Katalog</span>
                        <i
                            class="fas fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"
                        ></i>
                    </a>
                </div>
            </div>

            <!-- Hero Image Single -->
            <div class="fade-in-up relative" style="transition-delay: 200ms;">
                <div
                    class="relative rounded-3xl overflow-hidden shadow-2xl shadow-primary/10 border-8 border-white bg-slate-100 aspect-[4/3] sm:aspect-[16/11] flex items-center justify-center group"
                >
                    <img
                        src={familyHappyImg.src}
                        alt="Keluarga Bersepeda Bahagia - Toko AL"
                        class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
                        loading="eager"
                    />
                    <!-- Subtle bottom gradient overlay for depth -->
                    <div
                        class="absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent pointer-events-none"
                    >
                    </div>
                </div>
                <!-- Decorative patterns -->
                <div
                    class="absolute -z-10 -bottom-10 -right-10 w-40 h-40 bg-dots-pattern opacity-20"
                >
                </div>
            </div>
        </div>
    </div>
</section>
