---
import { Image } from "astro:assets";
import imgEtalase from "../assets/gallery/etalaseDepan.png";
import imgKasir from "../assets/gallery/kasirAL.png";
import imgViewBelakang from "../assets/gallery/viewbelakang.png";
import imgDepanRumah from "../assets/gallery/depan rumah.png";
import imgPelanggan from "../assets/gallery/Pelanggan.png";
import imgMobilAnak from "../assets/gallery/MobilANAK.png";
import Eyebrow from "./Eyebrow.astro";
import Icon from "./Icon.astro";
import { SOCIALS } from "../lib/site";

const primary = SOCIALS.filter((s) => s.primary);
const others = SOCIALS.filter((s) => !s.primary);

// Order sets the bento layout: the first photo is the large tile.
const photos = [
	{
		src: imgDepanRumah,
		alt: "Tampak Depan Toko AL",
		tag: "Kunjungi Toko",
		title: "Kunjungi Toko AL di Cikande Permai",
		desc: "Jl. Cikande Permai Blok J2 No.6, Cikande Permai, Serang",
	},
	{
		src: imgViewBelakang,
		alt: "Display Sepeda Toko AL",
		tag: "Display Sepeda",
		title: "Koleksi Unit Sepeda Lengkap",
		desc: "Pilihan sepeda MTB, lipat, roadbike, dan sepeda anak siap Anda coba",
	},
	{
		src: imgEtalase,
		alt: "Display Sparepart Toko AL",
		tag: "Display Sparepart",
		title: "Etalase Sparepart & Komponen",
		desc: "Koleksi suku cadang, gear, rantai, ban, dan komponen sepeda",
	},
	{
		src: imgKasir,
		alt: "Area Kasir Toko AL",
		tag: "Area Kasir & Aksesoris",
		title: "Area Kasir & Konsultasi",
		desc: "Tanyakan kebutuhan sepeda atau sparepart Anda langsung di toko.",
	},
	{
		src: imgPelanggan,
		alt: "Pelanggan Toko AL",
		tag: "Goweser Cikande",
		title: "Kepuasan Pelanggan Prioritas Kami",
		desc: "Selalu senang membantu goweser mendapatkan sepeda impian",
	},
	{
		src: imgMobilAnak,
		alt: "Koleksi Sepeda dan Mainan Anak",
		tag: "Koleksi Anak",
		title: "Sepeda & Mainan Anak",
		desc: "Pilihan sepeda roda tiga, push bike, dan mainan seru",
	},
];
---

<section id="gallery" class="section section--paper" aria-labelledby="gallery-title">
	<div class="container">
		<div class="section-head" data-reveal="up">
			<Eyebrow label="Suasana Toko" />
			<h2 id="gallery-title">Suasana Nyata Toko</h2>
		</div>

		<div class="bento" data-reveal="stagger">
			{photos.map((p, i) => (
				<figure class="tile" style={`--i: ${i}`}>
					<div class="tile__img">
						<Image
							src={p.src}
							widths={[480, 800, 1200]}
							sizes={i === 0 || i === 5 ? "(min-width: 1024px) 600px, 92vw" : i === 1 || i === 4 ? "(min-width: 1024px) 600px, (min-width: 640px) 46vw, 92vw" : "(min-width: 1024px) 285px, (min-width: 640px) 46vw, 92vw"}
							alt={p.alt}
						/>
					</div>
					<figcaption>
						<p class="tile__tag">{p.tag}</p>
						<h3>{p.title}</h3>
						<p class="tile__desc">{p.desc}</p>
					</figcaption>
				</figure>
			))}
		</div>

		<div class="follow" data-reveal="up">
			<div class="follow__text">
				<h3>Ikuti Kabar Terbaru Toko AL</h3>
				<p>Produk baru, kegiatan toko, dan info lainnya kami bagikan di sosial media.</p>
			</div>
			<div class="follow__links">
				{primary.map((s) => (
					<a class="btn btn--primary follow__btn" href={s.href} target="_blank" rel="noopener noreferrer">
						<Icon name={s.icon} />
						<span>{s.name} <span class="follow__handle">{s.handle}</span></span>
					</a>
				))}
				<div class="follow__more">
					{others.map((s) => (
						<a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`${s.name} Toko AL`}>
							<Icon name={s.icon} />
						</a>
					))}
				</div>
			</div>
		</div>
	</div>
</section>
